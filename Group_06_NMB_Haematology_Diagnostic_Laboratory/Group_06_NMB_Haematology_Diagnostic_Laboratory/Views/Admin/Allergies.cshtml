@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Allergies";
}
<nav class="sidebar">
  <div class="sidebar-brand">
    <div class="brand-badge">
      <div class="brand-text">🧬 NMB-HLabSys</div>
    </div>
  </div>
  <div class="sidebar-section">Overview</div>
  <a class="nav-item" asp-controller="Admin" asp-action="Dashboard"><span class="nav-icon">&#9700;</span> Dashboard</a>
  <div class="sidebar-section">Reference Data</div>
  <a class="nav-item" asp-controller="Admin" asp-action="Condition"><span class="nav-icon">&#129497;</span> Medical Conditions <span class="nav-badge" style="background:var(--blue)">9</span></a>
  <a class="nav-item active" asp-controller="Admin" asp-action="Allergies"><span class="nav-icon">&#9888;&#65039;</span> Allergies <span class="nav-badge" style="background:var(--blue)">@ViewBag.AllergyCount</span></a>
  <a class="nav-item" asp-controller="Admin" asp-action="Medication"><span class="nav-icon">&#128138;</span> Medications <span class="nav-badge" style="background:var(--blue)">@ViewBag.MedicationCount</span></a>
  <div class="sidebar-section">System</div>
  <a class="nav-item" asp-controller="Admin" asp-action="Users"><span class="nav-icon">&#128101;</span> System Users</a>
  <a class="nav-item" asp-controller="Admin" asp-action="Audit"><span class="nav-icon">&#128203;</span> Audit Log</a>
  <div class="sidebar-footer">
    <div class="user-card">
      <div class="avatar avatar-lg admin-avatar">SA</div>
      <div class="user-info">
        <div class="user-name">System Admin</div>
        <div class="user-role">Administrator</div>
      </div>
    </div>
  </div>
</nav>
<div class="main">
  
  <div class="page-body">
    <div class="section-header">
      <!--<div><div class="section-title">Allergies</div>--><div class="section-sub">Manage categorised allergy types used in patient medical history</div>
  
            <button class="btn btn" style="font-size:13px;padding:7px 14px;text-decoration:none;" onclick="openAddAllergy()">+ Add Allergy</button>
        </div>
    
    </div>
    <div class="card">
      <div class="tbl-top">
        <div style="display:flex;gap:10px;align-items:center;">
          <div class="tbl-search">&#128269; <input type="text" placeholder="Search allergies…" oninput="filterTable('allergy-tbl',this.value)" /></div>
          <select id="allergy-category-filter" class="form-control compact-select" onchange="filterTable('allergy-tbl', document.querySelector('#allergy-tbl').closest('.card').querySelector('.tbl-search input').value)">
            <option value="All">All categories</option>
            @foreach (var category in ViewBag.AllergyCategories as IEnumerable<string> ?? Enumerable.Empty<string>())
            {
              <option value="@category">@category</option>
            }
          </select>
        </div>
        <span class="badge badge-gray">@ViewBag.AllergyCount entries</span>
      </div>
      <div style="overflow-x:auto;">
        <table id="allergy-tbl">
          <thead><tr><th>Allergy Name</th><th>Category</th><th>Description</th><th>Patients</th><th>Actions</th></tr></thead>
          <tbody>
            @foreach (var allergy in ViewBag.Allergies as IEnumerable<Group_06_NMB_Haematology_Diagnostic_Lab.Data.Models.AllergyOption> ?? Enumerable.Empty<Group_06_NMB_Haematology_Diagnostic_Lab.Data.Models.AllergyOption>())
            {
              <tr data-is-active="true">
                <td><strong>@allergy.AllergyName</strong></td>
                <td><span class="pill-a">@allergy.AllergyCategory</span></td>
                <td class="td-muted">@allergy.Description</td>
                <td>@allergy.TotalPatients</td>
                <td><div style="display:flex;gap:6px;"><button class="btn btn-secondary btn-sm" onclick="editAllergy(this)">Edit</button><button class="btn btn-secondary btn-sm" onclick="toggleAllergyStatus(this)">Deactivate</button></div></td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<div id="modal-add" class="modal-overlay">
  <div class="modal">
    <div class="modal-header"><span class="modal-title">Add Allergy</span><button class="modal-close" onclick="closeModal('modal-add')">&#x2715;</button></div>
    <div class="modal-body">
      <div class="form-row">
        <div class="form-group"><label class="form-label">Allergy Name *</label><input id="inp-name" class="form-control" type="text" placeholder="e.g. Codeine" /></div>
        <div class="form-group"><label class="form-label">Category *</label>
          <select id="inp-category" class="form-control">
            @foreach (var category in ViewBag.AllergyCategories as IEnumerable<string> ?? Enumerable.Empty<string>())
            {
              <option value="@category">@category</option>
            }
          </select>
        </div>
      </div>
      <div class="form-group"><label class="form-label">Description</label><textarea id="inp-desc" class="form-control" rows="3" placeholder="Brief clinical description…"></textarea></div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary" onclick="closeModal('modal-add')">Cancel</button>
      <button class="btn btn-amber" onclick="saveAllergy()">Save Allergy</button>
    </div>
  </div>
</div>
@Html.AntiForgeryToken()
<div id="toast"></div>
@section Scripts {
<script>
  let currentAllergyEditRow = null;
  function openModal(id){document.getElementById(id).classList.add('open');}
  function closeModal(id){document.getElementById(id).classList.remove('open');}
  document.addEventListener('click',e=>{if(e.target.classList.contains('modal-overlay'))e.target.classList.remove('open');});
  function getActiveCategory(){const select=document.getElementById('allergy-category-filter');return select ? select.value.toLowerCase() : 'all';}
  function updateAllergyFilter(tableId, search){const lq = (search || '').toLowerCase();const activeCategory = getActiveCategory();document.querySelectorAll('#'+tableId+' tbody tr').forEach(r=>{const rowText = r.textContent.toLowerCase();const catText = r.cells[1].textContent.trim().toLowerCase();const matchesSearch = !lq || rowText.includes(lq);const matchesCategory = activeCategory === 'all' || catText === activeCategory;r.style.display = matchesSearch && matchesCategory ? '' : 'none';});}
  function filterTable(tableId,q){updateAllergyFilter(tableId,q);}
  function openAddAllergy(){currentAllergyEditRow = null;document.getElementById('inp-name').value='';const categorySelect=document.getElementById('inp-category');if(categorySelect.options.length)categorySelect.selectedIndex=0;document.getElementById('inp-desc').value='';document.querySelector('#modal-add .modal-title').textContent='Add Allergy';document.querySelector('#modal-add .modal-footer .btn-amber').textContent='Save Allergy';openModal('modal-add');}
  function editAllergy(btn){currentAllergyEditRow = btn.closest('tr');if(!currentAllergyEditRow) return;const cells=currentAllergyEditRow.cells;document.getElementById('inp-name').value=cells[0].textContent.trim();document.getElementById('inp-category').value=cells[1].textContent.trim();document.getElementById('inp-desc').value=cells[2].textContent.trim();document.querySelector('#modal-add .modal-title').textContent='Edit Allergy';document.querySelector('#modal-add .modal-footer .btn-amber').textContent='Update Allergy';openModal('modal-add');}
  function toggleAllergyStatus(button){const row=button.closest('tr');if(!row)return;const isActive=row.dataset.isActive!=='true';row.dataset.isActive=String(isActive);button.textContent=isActive?'Deactivate':'Activate';row.style.opacity=isActive?'1':'0.55';toast(isActive?'Allergy activated.':'Allergy deactivated.');}
  async function saveAllergy(){const n=document.getElementById('inp-name').value.trim();const nameOk=validateText('inp-name','Allergy name',3,60,/^[A-Za-z0-9 /()'.,-]+$/);const descOk=validateOptionalText('inp-desc','Description',500,/^[A-Za-z0-9 /()'.,;:-]+$/);if(!nameOk.ok||!descOk.ok)return;if(hasDuplicateName('allergy-tbl',n,currentAllergyEditRow)){setFieldError(document.getElementById('inp-name'),'Allergy name must be unique.');return;}const category=document.getElementById('inp-category').value;const description=document.getElementById('inp-desc').value.trim();const token=document.querySelector('input[name="__RequestVerificationToken"]').value;let url;let data;if(currentAllergyEditRow){const originalAllergyName=currentAllergyEditRow.cells[0].textContent.trim();url='@Url.Action("UpdateAllergy", "Admin")';data=new URLSearchParams({originalAllergyName,allergyName:n,categoryName:category,allergyDescription:description,__RequestVerificationToken:token});}else{url='@Url.Action("AddAllergy", "Admin")';data=new URLSearchParams({allergyName:n,categoryName:category,allergyDescription:description,__RequestVerificationToken:token});}const response=await fetch(url,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded; charset=UTF-8'},body:data});const result=await response.json().catch(()=>({}));if(!response.ok){toast(result.message||'Unable to save allergy.');return;}toast(result.message||(currentAllergyEditRow?'Allergy updated.':'Allergy added.'));window.location.reload();
    document.getElementById('inp-name').value='';document.getElementById('inp-desc').value='';updateAllergyFilter('allergy-tbl', document.querySelector('#allergy-tbl').closest('.card').querySelector('.tbl-search input').value);closeModal('modal-add');}
  document.addEventListener('DOMContentLoaded',()=>{});
</script>
}
