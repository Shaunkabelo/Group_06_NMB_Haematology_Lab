@model Group_06_NMB_Haematology_Diagnostic_Lab.Data.Models.CategoryManagementViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    var categoryGroups = new[]
    {
        new { Name = "Medical Conditions", Items = Model.MedicalConditionCategories.ToList() },
        new { Name = "Allergies", Items = Model.AllergyCategories.ToList() },
        new { Name = "Medications", Items = Model.MedicationCategories.ToList() }
    };
    var totalCategories = categoryGroups.Sum(group => group.Items.Count);
}
@* <div class="main main-content"> *@
  
  <div class="page-body">
    <style>
      .dash-wide{display:grid;grid-template-columns:1fr;gap:18px;margin-bottom:18px;}
      .dash-3{display:grid;grid-template-columns:repeat(3, minmax(0, 1fr));gap:18px;}
      .stats-grid{display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:16px;}
      .qa-grid{display:grid;grid-template-columns:repeat(2, minmax(0, 1fr));gap:8px;}
      .qa-btn{display:flex;flex-direction:column;gap:3px;padding:12px 13px;background:var(--bg);border:1px solid var(--border);border-radius:10px;cursor:pointer;text-align:left;font-family:'DM Sans',sans-serif;transition:all 0.15s;text-decoration:none;}
      .qa-btn:hover{background:var(--surface);border-color:#F5A623;box-shadow:var(--shadow);}
      .qa-icon{font-size:18px;}.qa-label{font-size:12px;font-weight:600;color:var(--text);}.qa-desc{font-size:11px;color:var(--muted);line-height:1.4;}
      .cov-row{display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid var(--border);}
      .cov-row:last-child{border-bottom:none;}
      .cov-lbl{font-size:12px;flex:1;}.cov-bg{width:90px;height:5px;background:var(--bg);border-radius:3px;overflow:hidden;flex-shrink:0;}
      .cov-fill{height:100%;border-radius:3px;background:var(--teal);}.cov-num{font-size:11px;font-weight:600;min-width:22px;text-align:right;}
      table{width:100%;border-collapse:collapse;}
      thead th{text-align:left;padding:9px 14px;font-size:11px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:var(--muted);background:var(--bg);border-bottom:1px solid var(--border);}
      tbody tr{border-bottom:1px solid var(--border);transition:background 0.1s;}tbody tr:hover{background:#f8fafc;}
      tbody td{padding:9px 14px;font-size:13px;vertical-align:middle;}
      .clickable-card{cursor:pointer;transition:transform 0.15s ease,box-shadow 0.15s ease;}
      .clickable-card:hover{transform:translateY(-2px);box-shadow:0 16px 36px rgba(10,30,60,0.12);}
      .clickable-card .card-link{color:inherit;text-decoration:none;}

      @@media (max-width: 1100px) {
        .dash-wide,
        .dash-3,
        .qa-grid {
          grid-template-columns:1fr;
        }
        .dash-wide {gap:14px;}
        .dash-3 {gap:14px;}
      }

      @@media (max-width: 860px) {
        .topbar {flex-wrap: wrap; gap:12px;}
        .topbar-search {width:100%;}
        .topbar-search input {width:100%;}
        .btn-amber {width:100%; justify-content:center;}
        .page-body {padding:16px;}
      }
    </style>

    <div class="section-header">
      <div><div class="section-title">Welcome back, @ViewData["AdminFirstName"]!</div><div class="section-sub">Manage reference data and monitor system health</div></div>
      <a class="btn btn-secondary btn-sm" asp-controller="Admin" asp-action="Dashboard">Refresh</a>
    </div>

    <div class="stats-grid">
      <a class="stat-card clickable" asp-controller="Admin" asp-action="Conditions" style="--accent:var(--blue)"><div class="stat-emoji">&#9874;</div><div class="stat-label">Medical Conditions</div><div class="stat-value">@ViewBag.MedicalConditionCount</div><div class="stat-sub">Across @Model.MedicalConditionCategories.Count() categories</div></a>
      <a class="stat-card clickable" asp-controller="Admin" asp-action="Allergies" style="--accent:var(--red)"><div class="stat-emoji">&#9888;&#65039;</div><div class="stat-label">Allergies</div><div class="stat-value">@ViewBag.AllergyCount</div><div class="stat-sub">Listed allergies</div></a>
      <a class="stat-card clickable" asp-controller="Admin" asp-action="Medication" style="--accent:var(--teal)"><div class="stat-emoji">&#128279;</div><div class="stat-label">Medications</div><div class="stat-value">@ViewBag.MedicationCount</div><div class="stat-sub">Listed medications</div></a>
      <a class="stat-card clickable" asp-controller="Admin" asp-action="Users" style="--accent:#F5A623"><div class="stat-emoji">&#128101;</div><div class="stat-label">Registered Users</div><div class="stat-value">@ViewBag.UserCount</div><div class="stat-sub">Total system users</div></a>
    </div>
    <div>
        <br>
    </div>
    <div class="dash-wide">
      <div style="display:flex;flex-direction:column;gap:16px;">
          <div class="card">
          <div class="card-header"><span class="card-title">Category Coverage</span></div>
          <div class="card-body">
            <p class="section-sub">@totalCategories categories in total. Bars show each group's share of all categories.</p>
            @foreach (var group in categoryGroups)
            {
                var count = group.Items.Count;
                var activeCount = group.Items.Count(category => category.IsActive);
                var percentage = totalCategories == 0 ? 0 : (int)Math.Round(100.0 * count / totalCategories);
                <div class="cov-row">
                    <span class="cov-lbl">@group.Name <small style="display:block;color:var(--muted);">@activeCount active / @(count - activeCount) deactivated</small></span>
                    <div class="cov-bg" aria-hidden="true"><div class="cov-fill" style="width:@(percentage)%"></div></div>
                    <span class="cov-num">@count</span>
                </div>
            }
            @if (totalCategories == 0)
            {
                <p class="section-sub">No categories have been added yet.</p>
            }
            <a asp-controller="Admin" asp-action="Categories" class="card-link">Manage categories</a>
          </div>
        </div>
      </div>
    </div>

  </div>
@* </div> *@
<div id="toast"></div>
@section Scripts {
<script>
  function toast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2800);}
  function openModal(id){document.getElementById(id).classList.add('open');}
  function closeModal(id){document.getElementById(id).classList.remove('open');}
  document.addEventListener('click',e=>{if(e.target.classList.contains('modal-overlay'))e.target.classList.remove('open');});
  function filterTable(tableId,q){const lq=q.toLowerCase();document.querySelectorAll('#'+tableId+' tbody tr').forEach(r=>{r.style.display=r.textContent.toLowerCase().includes(lq)?'':'none';});}
  function switchTab(btn){btn.closest('.tabs').querySelectorAll('.tab-btn').forEach(t=>t.classList.remove('active'));btn.classList.add('active');}
</script>
}
