@{
    Layout = "_TechLayout";
}
@model TechVerifyIndexModel
@{
    ViewData["Title"] = "Verify Results";
}

<div class="topbar">
    <h1 class="page-title">Verify Results</h1>
    <div class="topbar-actions">
    </div>
</div>

<div class="page-body">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="tabs">
        <button class="tab-btn active" onclick="switchTab(this,'tab-to-verify')">✅ Awaiting Verification (@Model.AwaitingVerification.Count)</button>
        <button class="tab-btn" onclick="switchTab(this,'tab-to-review')">🔄 Returned for Review (@Model.ReturnedForReview.Count)</button>
        <button class="tab-btn" onclick="switchTab(this,'tab-verified')">📋 Verified Today (@Model.VerifiedToday.Count)</button>
    </div>

    <!-- AWAITING VERIFICATION -->
    <div id="tab-to-verify" class="tab-panel active">
        <div class="card">
            <div class="card-header">
                <span class="card-title">Tests Awaiting Your Verification</span>
                <span style="font-size:12px;color:#7A8CA0">You cannot verify tests you performed</span>
            </div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr><th>Request No.</th><th>Patient</th><th>Test</th><th>Performed By</th><th>Completed At</th><th>Abnormal?</th><th>Actions</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.AwaitingVerification)
                        {
                            <tr>
                                <td class="td-bold">@r.RequestNumber</td>
                                <td>@r.PatientName</td>
                                <td>@r.TestName</td>
                                <td>@r.PerformedByName</td>
                                <td>@r.CaptureDateTime.ToString("HH:mm")</td>
                                <td>
                                    @if (r.IsAbnormal)
                                    {
                                        <span class="badge red">⚠️ Abnormal</span>
                                    }
                                    else
                                    {
                                        <span class="badge gray">Normal</span>
                                    }
                                </td>
                                <td>
                                    <button type="button" class="btn btn-primary btn-sm" onclick="openVerifyModal(@r.TestResultId)">Review &amp; Verify</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- RETURNED FOR REVIEW -->
    <div id="tab-to-review" class="tab-panel">
        <div class="card">
            <div class="card-header"><span class="card-title">🔄 Results Returned to You for Review</span></div>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Request No.</th><th>Test</th><th>Returned By</th><th>Returned At</th><th>Reviewer Note</th><th>Action</th></tr></thead>
                    <tbody>
                        @foreach (var r in Model.ReturnedForReview)
                        {
                            <tr style="background:rgba(245,166,35,0.06)">
                                <td class="td-bold">@r.RequestNumber</td>
                                <td>@r.TestName</td>
                                <td>@r.ReturnedByName</td>
                                <td>@r.ReturnedAt.ToString("HH:mm")</td>
                                <td style="max-width:240px;font-size:12px;color:#7A8CA0">"@r.ReviewerNote"</td>
                                <td>
                                    <button type="button" class="btn btn-primary btn-sm" onclick="openResubmitModal(@r.TestResultId)">Edit &amp; Resubmit</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- VERIFIED TODAY -->
    <div id="tab-verified" class="tab-panel">
        <div class="card">
            <div class="card-header"><span class="card-title">📋 Results Verified by Me Today</span></div>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Request No.</th><th>Test</th><th>Performed By</th><th>Verified At</th><th>Abnormal?</th></tr></thead>
                    <tbody>
                        @foreach (var v in Model.VerifiedToday)
                        {
                            <tr>
                                <td class="td-bold">@v.RequestNumber</td>
                                <td>@v.TestName</td>
                                <td>@v.PerformedByName</td>
                                <td>@v.VerifiedAt.ToString("HH:mm")</td>
                                <td>
                                    @if (v.IsAbnormal)
                                    {
                                        <span class="badge red">⚠️ Abnormal</span>
                                    }
                                    else
                                    {
                                        <span class="badge green">Normal</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<!-- Review & Verify Modal -->
<div id="verify-modal-overlay" style="display:none;position:fixed;inset:0;background:rgba(11,25,41,0.5);z-index:1000;align-items:center;justify-content:center">
    <div style="background:#fff;border-radius:12px;max-width:600px;width:92%;max-height:85vh;overflow-y:auto;padding:0">
        <div style="padding:16px 20px;border-bottom:1px solid #EAEEF2;display:flex;justify-content:space-between;align-items:center">
            <strong id="verify-modal-title">Review &amp; Verify</strong>
            <button type="button" onclick="closeVerifyModal()" style="background:none;border:none;font-size:20px;cursor:pointer;color:#7A8CA0">×</button>
        </div>

        <div id="verify-modal-body" style="padding:20px 20px 0">Loading...</div>

        <form asp-controller="TechVerify" asp-action="SubmitDecision" method="post">
            <input type="hidden" name="testResultId" id="verify-test-result-id" />
            <div style="padding:0 20px 20px">
                <div class="form-label">Your Decision *</div>
                <div style="display:flex;gap:10px;margin-bottom:14px;flex-wrap:wrap">
                    <label style="display:flex;align-items:center;gap:6px">
                        <input type="radio" name="decision" value="Verify" checked onchange="document.getElementById('return-note-group').style.display='none'" /> ✅ Verify
                    </label>
                    <label style="display:flex;align-items:center;gap:6px">
                        <input type="radio" name="decision" value="Return" onchange="document.getElementById('return-note-group').style.display='block'" /> 🔄 Return to Technician
                    </label>
                </div>
                <div class="form-group" id="return-note-group" style="display:none">
                    <label class="form-label">Note for Technician *</label>
                    <textarea class="form-control" name="notes" rows="3" placeholder="Explain what needs to be corrected..."></textarea>
                </div>
                <div style="display:flex;justify-content:flex-end;gap:10px">
                    <button type="button" class="btn btn-secondary" onclick="closeVerifyModal()">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit Decision</button>
                </div>
            </div>
        </form>
    </div>
</div>


<!-- Edit & Resubmit Modal -->
<div id="resubmit-modal-overlay" style="display:none;position:fixed;inset:0;background:rgba(11,25,41,0.5);z-index:1000;align-items:center;justify-content:center">
    <div style="background:#fff;border-radius:12px;max-width:600px;width:92%;max-height:85vh;overflow-y:auto;padding:0">
        <div style="padding:16px 20px;border-bottom:1px solid #EAEEF2;display:flex;justify-content:space-between;align-items:center">
            <strong id="resubmit-modal-title">Edit &amp; Resubmit</strong>
            <button type="button" onclick="closeResubmitModal()" style="background:none;border:none;font-size:20px;cursor:pointer;color:#7A8CA0">×</button>
        </div>

        <div id="resubmit-modal-body" style="padding:20px 20px 0">Loading...</div>

        <form asp-controller="TechVerify" asp-action="ResubmitResult" method="post">
            <input type="hidden" name="testResultId" id="resubmit-test-result-id" />
            <div style="padding:0 20px 20px">
                <div class="form-group">
                    <label class="form-label" id="resubmit-value-label">Corrected Value</label>
                    <input class="form-control"
                           type="number"
                           step="any"
                           name="resultValue"
                           id="resubmit-result-value"
                           required />
                </div>
                
                <div class="form-group">
                    <label class="form-label">Your Response Note *</label>
                    <textarea class="form-control" name="responseNote" rows="3" placeholder="Explain the correction made..." required></textarea>
                </div>
                <div id="resubmit-history"></div>
                <div style="display:flex;justify-content:flex-end;gap:10px">
                    <button type="button" class="btn btn-secondary" onclick="closeResubmitModal()">Cancel</button>
                    <button type="submit" class="btn btn-primary">🔄 Resubmit for Verification</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function switchTab(btn, panelId) {
            document.querySelectorAll('.tab-btn')
                .forEach(b => b.classList.remove('active'));

            document.querySelectorAll('.tab-panel')
                .forEach(p => p.classList.remove('active'));

            btn.classList.add('active');
            document.getElementById(panelId).classList.add('active');
        }

        function escapeHtml(value) {
            const element = document.createElement('span');
            element.textContent = value == null ? '' : String(value);
            return element.innerHTML;
        }

        function historyHtml(history) {
            if (!Array.isArray(history) || history.length === 0) {
                return '<p>No previous reviews or corrections.</p>';
            }

            const items = history.map(h => `
                <div style="padding:10px 0;border-bottom:1px solid #E3E8F0">
                    <div>
                        <strong>${escapeHtml(h.status)}</strong>
                        · ${escapeHtml(h.eventType)}
                    </div>
                    <div style="margin-top:4px">
                        <strong>Result:</strong>
                        ${escapeHtml(
                            h.resultValue ?? 'Not recorded in historical data'
                        )}
                    </div>
                    <div style="margin-top:4px">
                        <strong>By:</strong> ${escapeHtml(h.byName)}
                        <br>
                        <strong>Date:</strong> ${escapeHtml(h.eventDate)}
                    </div>
                    <div style="margin-top:4px;white-space:pre-wrap"><strong>Notes:</strong> ${escapeHtml(h.notes || 'No notes')}</div>
                </div>
            `).join('');

            return `
                <div class="form-label">Full Result and Review History</div>
                <div style="background:#F5F7FA;border-radius:8px;
                            padding:10px;margin-bottom:14px">
                    ${items}
                </div>
            `;
        }

        function medicalInfoHtml(d) {
            function listText(items) {
                return Array.isArray(items) && items.length
                    ? escapeHtml(items.join(', '))
                    : 'None recorded';
            }

            return `
                <div class="form-label">Patient Medical Info</div>
                <div style="background:#F5F7FA;border-radius:8px;
                            padding:10px;margin-bottom:14px;font-size:13px">
                    <strong>Conditions:</strong> ${listText(d.conditions)}<br>
                    <strong>Allergies:</strong> ${listText(d.allergies)}<br>
                    <strong>Medication:</strong> ${listText(d.medications)}
                </div>
                ${d.clinicalNotes ? `
                    <div class="form-label">Doctor's Clinical Notes</div>
                    <div style="font-size:13px;margin-bottom:14px;
                                white-space:pre-wrap">${escapeHtml(d.clinicalNotes)}</div>
                ` : ''}
            `;
        }

        async function loadModalData(url, testResultId) {
            const res = await fetch(
                url + '?testResultId=' + encodeURIComponent(testResultId),
                { headers: { 'Accept': 'application/json' } }
            );

            if (!res.ok) {
                throw new Error('Request failed (HTTP ' + res.status + ').');
            }

            const contentType = res.headers.get('content-type') || '';

            if (!contentType.includes('application/json')) {
                throw new Error(
                    'The server did not return result data. Refresh and check that you are logged in.'
                );
            }

            return await res.json();
        }

        function updateReturnNoteRequirement(form) {
            const isReturn =
                form.querySelector('input[name="decision"]:checked')
                    ?.value === 'Return';

            const group = document.getElementById('return-note-group');
            const notes = form.querySelector('[name="notes"]');

            if (group) {
                group.style.display = isReturn ? 'block' : 'none';
            }

            if (notes) {
                notes.required = isReturn;
            }
        }

        async function openVerifyModal(testResultId) {
            const overlay = document.getElementById('verify-modal-overlay');
            const body = document.getElementById('verify-modal-body');
            const form = overlay.querySelector('form');
            const submitButton =
                form.querySelector('button[type="submit"]');

            form.reset();
            updateReturnNoteRequirement(form);

            document.getElementById('verify-test-result-id').value =
                testResultId;

            document.getElementById('verify-modal-title').textContent =
                'Review & Verify';

            body.textContent = 'Loading...';
            submitButton.disabled = true;
            overlay.style.display = 'flex';

            try {
                const d = await loadModalData(
                    '@Url.Action("GetVerifyModalData", "TechVerify")',
                    testResultId
                );

                // Ignore a response if another result was opened meanwhile.
                if (
                    document.getElementById('verify-test-result-id').value
                    !== String(testResultId)
                ) {
                    return;
                }

                const patient = d.patientName
                    ? ' (' + d.patientName +
                        (d.patientAge != null
                            ? ', ' + d.patientAge + ' yrs'
                            : '') + ')'
                    : '';

                document.getElementById('verify-modal-title').textContent =
                    d.requestNumber + ' — ' + d.testName + patient;

                body.innerHTML = `
                    <div style="background:#F5F7FA;border-radius:8px;
                                padding:12px;margin-bottom:14px;
                                display:flex;gap:24px;flex-wrap:wrap">
                        <div>
                            <div class="form-label">Current Result</div>
                            <div style="font-weight:700">
                                ${escapeHtml(d.resultDisplay ?? d.resultValue ?? 'Not recorded')}
                                ${escapeHtml(d.unitOfMeasurement ?? '')}
                            </div>
                        </div>
                        <div>
                            <div class="form-label">Normal Range</div>
                            <div style="font-weight:700">
                                ${escapeHtml(d.normalRangeMin ?? '—')}
                                – ${escapeHtml(d.normalRangeMax ?? '—')}
                            </div>
                        </div>
                        <div>
                            <div class="form-label">Performed By</div>
                            <div style="font-weight:700">
                                ${escapeHtml(d.performedByName)}
                            </div>
                        </div>
                        <div>
                            <div class="form-label">Abnormal?</div>
                            <div style="font-weight:700;
                                        color:${d.isAbnormal ? '#FF4757' : '#1E9B54'}">
                                ${d.isAbnormal ? 'Yes ⚠️' : 'No'}
                            </div>
                        </div>
                    </div>

                    ${d.labTechNote ? `
                        <div class="form-label">Lab Technician's Note</div>
                        <div style="font-size:13px;margin-bottom:14px;
                                    white-space:pre-wrap">${escapeHtml(d.labTechNote)}</div>
                    ` : ''}

                    ${medicalInfoHtml(d)}
                    ${historyHtml(d.history)}
                `;

                submitButton.disabled = false;
            } catch (error) {
                console.error('Unable to load verification details:', error);
                body.textContent =
                    'Could not load verification details. ' + error.message;
            }
        }

        function closeVerifyModal() {
            document.getElementById('verify-modal-overlay')
                .style.display = 'none';

            document.getElementById('verify-test-result-id').value = '';
        }

        async function openResubmitModal(testResultId) {
            const overlay = document.getElementById('resubmit-modal-overlay');
            const body = document.getElementById('resubmit-modal-body');
            const history = document.getElementById('resubmit-history');
            const form = overlay.querySelector('form');
            const submitButton =
                form.querySelector('button[type="submit"]');

            form.reset();

            document.getElementById('resubmit-test-result-id').value =
                testResultId;

            document.getElementById('resubmit-modal-title').textContent =
                'Edit & Resubmit';

            const resultInput =
                document.getElementById('resubmit-result-value');

            resultInput.required = true;
            resultInput.step = 'any';

            body.textContent = 'Loading...';
            history.innerHTML = '';
            submitButton.disabled = true;
            overlay.style.display = 'flex';

            try {
                const d = await loadModalData(
                    '@Url.Action("GetResubmitModalData", "TechVerify")',
                    testResultId
                );

                if (
                    document.getElementById('resubmit-test-result-id').value
                    !== String(testResultId)
                ) {
                    return;
                }

                document.getElementById('resubmit-modal-title').textContent =
                    d.requestNumber + ' — ' + d.testName;

                document.getElementById('resubmit-value-label').textContent =
                    'Corrected Value (' + (d.unitOfMeasurement ?? '') +
                    ') — Normal range: ' + (d.normalRangeMin ?? '—') +
                    '–' + (d.normalRangeMax ?? '—');

                resultInput.value = d.resultValue ?? '';

                body.innerHTML = `
                    <div style="background:#F5F7FA;border-radius:8px;
                                padding:12px;margin-bottom:14px">
                        <strong>Current Submitted Result:</strong>
                        ${escapeHtml(d.resultValue ?? 'Not recorded')}
                        ${escapeHtml(d.unitOfMeasurement ?? '')}
                    </div>

                    <div style="background:rgba(245,166,35,0.1);
                                border:1px solid #F5A623;border-radius:8px;
                                padding:12px;margin-bottom:14px">
                        <strong>${escapeHtml(d.returnedByName)}'s Note:</strong>
                        <div style="margin-top:4px;white-space:pre-wrap">${escapeHtml(d.reviewerNote)}</div>
                    </div>
                `;

                history.innerHTML = historyHtml(d.history);
                submitButton.disabled = false;
            } catch (error) {
                console.error('Unable to load returned result:', error);
                body.textContent =
                    'Could not load returned result details. ' + error.message;
            }
        }

        function closeResubmitModal() {
            document.getElementById('resubmit-modal-overlay')
                .style.display = 'none';

            document.getElementById('resubmit-test-result-id').value = '';
        }

        document.querySelectorAll(
            '#verify-modal-overlay input[name="decision"]'
        ).forEach(input => {
            input.addEventListener('change', function () {
                updateReturnNoteRequirement(this.form);
            });
        });
    </script>
}