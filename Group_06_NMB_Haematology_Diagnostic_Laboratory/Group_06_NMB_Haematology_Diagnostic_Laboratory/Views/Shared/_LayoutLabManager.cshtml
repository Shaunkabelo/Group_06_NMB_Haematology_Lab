@{
    var title = ViewData["Title"]?.ToString() ?? "Laboratory Manager";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - NMB-HLabSys</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/DoctorStyle.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-brand"><span class="brand-icon">🧬</span> NMB-HLabSys</div>
        <nav class="nav-menu">
            <div class="sidebar-section">Laboratory</div>
            <a asp-controller="Account" asp-action="Continue" class="nav-item active">
                <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 3h8v8H3V3Zm10 0h8v5h-8V3ZM13 10h8v11h-8V10ZM3 13h8v8H3v-8Z" /></svg></span>
                Dashboard
            </a>
        </nav>
    </aside>
    <main class="main-content">
        <header class="topbar">
            <h1 class="page-title">@title</h1>
            <div class="topbar-actions">
                <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-secondary" type="submit">Logout</button>
                </form>
            </div>
        </header>
        @RenderBody()
    </main>
</body>
</html>
