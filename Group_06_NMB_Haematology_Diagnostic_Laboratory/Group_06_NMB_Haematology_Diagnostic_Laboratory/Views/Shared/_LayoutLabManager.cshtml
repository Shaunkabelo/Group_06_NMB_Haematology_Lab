@{
    var title = ViewData["Title"]?.ToString() ?? "Laboratory Manager";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - NMB-HLabSys</title>
    <base href="@Url.Content("~/")" />
    <link rel="stylesheet" href="~/css/DoctorStyle.css" asp-append-version="true" />
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-brand"><span class="brand-icon">🧬</span> NMB-HLabSys</div>
        <nav class="nav-menu">
            <div class="sidebar-section">Laboratory</div>
            <a asp-controller="LabManager" asp-action="Dashboard" class="nav-item active">
                <span class="nav-icon" aria-hidden="true">⌂</span>
                Dashboard
            </a>
        </nav>
    </aside>
    <main class="main-content">
        <header class="topbar">
            <h1 class="page-title">@title</h1>
            <div class="topbar-actions">
                <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-secondary" type="submit">Logout</button>
                </form>
            </div>
        </header>
        @RenderBody()
    </main>
</body>
</html>
