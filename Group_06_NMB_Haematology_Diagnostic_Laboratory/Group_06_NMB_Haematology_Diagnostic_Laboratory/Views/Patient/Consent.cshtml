@{
    Layout = "~/Views/Shared/_LayoutPatient.cshtml";
    ViewData["Title"] = "Doctor Consent";
}


<div class="page-body">
    @Html.AntiForgeryToken()
    <p id="consent-email-status" role="status" aria-live="polite"></p>
    <div class="section-header">
        <div>
            <!--- <div class="section-title">Doctor Consent</div>-->
            <div class="section-sub">Grant or revoke doctor access to selected previous test request results.</div>
        </div>
    </div>

    <div class="info-banner">
        When access is granted, the selected doctor is notified by email. Revoking access immediately removes access to the selected requests.
    </div>

    <div style="display:flex; justify-content:flex-end; margin-bottom:16px;">
        <button class="btn btn-primary btn-sm" type="button" onclick="openGrantDoctorModal()">Grant Doctor Access</button>
    </div>

    <div class="card">
        <div class="card-header">
            <span class="card-title">Doctors with Access</span>
            <span class="td-muted" id="consent-count">Loading...</span>
        </div>
        <table>
            <thead>
                <tr><th>Doctor</th><th>HPCSA No.</th><th>Specialisation</th><th>Shared Results</th><th>Access</th></tr>
            </thead>
<tbody id="saved-consents-body"><tr><td colspan="5">Loading saved consents...</td></tr></tbody>
        </table>
    </div>

    <div class="modal-overlay" id="modal-shared-results" style="display:none; z-index:260;">
        <div class="modal" style="width:min(760px, calc(100vw - 32px));">
            <div class="modal-header">
                <span class="modal-title" id="shared-results-title">Test Results</span>
                <button class="modal-close" type="button" onclick="closeModal('modal-shared-results')">&times;</button>
            </div>
            <div class="modal-body">
                <p>Select the test results you want to stop sharing with this doctor. Unchecked results will stay shared.</p>
                <p id="shared-results-message" role="status" aria-live="polite"></p>
                <table>
                    <thead><tr><th>Revoke</th><th>Test</th><th>Result</th><th>Reference Range</th><th>Units</th><th>Flag</th></tr></thead>
                    <tbody id="shared-results-body"></tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" id="revoke-shared-results" type="button" onclick="revokeSharedResults()" disabled>Revoke selected results</button>                <button class="btn btn-secondary" type="button" onclick="closeModal('modal-shared-results')">Close</button>
            </div>
        </div>
    </div>

    <div class="modal-overlay" id="modal-confirm-consent" style="display:none; z-index:280;" role="dialog" aria-modal="true" aria-labelledby="confirm-consent-title">
        <div class="modal">
            <div class="modal-header"><span class="modal-title" id="confirm-consent-title">Confirm Doctor Access</span></div>
            <div class="modal-body"><p id="confirm-consent-message"></p><p id="confirm-consent-error" role="alert"></p></div>
            <div class="modal-footer">
                <button class="btn btn-secondary" id="consent-no" type="button" onclick="closeModal('modal-confirm-consent')">No</button>
                <button class="btn btn-primary" id="consent-yes" type="button" onclick="saveConfirmedConsent()">Yes</button>
            </div>
        </div>
    </div>
    <div class="modal-overlay" id="modal-consent-tests" style="display:none; z-index:270;" role="dialog" aria-modal="true" aria-labelledby="consent-tests-title">
        <div class="modal" style="width:min(640px, calc(100vw - 32px));">
            <div class="modal-header">
                <span class="modal-title" id="consent-tests-title">Select Tests</span>
                <button class="modal-close" type="button" aria-label="Close test selection" onclick="closeModal('modal-consent-tests')">&times;</button>
            </div>
            <div class="modal-body" id="consent-tests-list" aria-live="polite"></div>
            <div class="modal-footer">
                <button class="btn btn-primary" type="button" onclick="closeModal('modal-consent-tests')">Done</button>
            </div>
        </div>
    </div>
    <div class="modal-overlay" id="modal-grant-access" style="display:none;">
        <div class="modal" style="width:min(780px, calc(100vw - 32px));">
            <div class="modal-header">
                <span class="modal-title">Grant Doctor Access</span>
                <button class="modal-close" type="button" onclick="closeModal('modal-grant-access')">&times;</button>
            </div>
            <div class="modal-body">
                <div class="card">
                    <div class="card-header"><span class="card-title">Doctors</span></div>
                    <div class="card-body">
                        <div class="form-group">
                            <label class="form-label" for="grant-doctor-search">Search doctor</label>
                            <input id="grant-doctor-search" type="search" class="form-control" placeholder="Name, email or HPCSA number" oninput="renderGrantDoctorResults()" disabled />
                        </div>
                        <label class="form-label" for="grant-doctor-results">Select a doctor</label>
                        <select id="grant-doctor-results" class="form-control" onchange="selectGrantDoctor(this.value === '' ? -1 : Number(this.value))" disabled>
                            <option value="">Loading doctors...</option>
                        </select>
                        <p id="grant-doctor-load-error" class="td-muted" role="status" aria-live="polite" hidden></p>
                        <button id="grant-doctor-retry" class="btn btn-secondary btn-sm" type="button" onclick="loadGrantDoctors()" hidden>Retry loading doctors</button>
                    </div>
                </div>
                <div class="section-gap">
                    <div class="card">
                        <div class="card-header"><span class="card-title">Selected Doctor</span></div>
                        <div class="card-body" id="grant-selected-doctor">
                            <p class="td-muted">None selected</p>
                        </div>
                    </div>
                </div>
                <div class="section-gap">
                    <div class="card">
                        <div class="card-header"><span class="card-title">Select Test Requests</span></div>
                        <div class="card-body" id="grant-request-list"></div>
                    </div>
                </div>
                <div id="grant-access-error" class="confirm-msg" style="display:none; color:#FF4757;"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" onclick="closeModal('modal-grant-access')">Cancel</button>
                <button class="btn btn-primary" type="button" onclick="assignGrantAccess()">Grant Access</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        async function toggleConsent(btn, name, doctorId = 0) {
            if (btn.disabled) return;
            if (!doctorId) {
                toast('This sample row is not linked to saved consent. Use Grant Doctor Access to select a doctor.');
                return;
            }
            const granting = !btn.classList.contains('on');
            const row = btn.closest('tr');
            const testIds = [...new Set(Array.from(row.querySelectorAll('a[data-test-ids]'))
                .flatMap(link => link.dataset.testIds.split(',').map(Number)))];
            btn.disabled = true;
            try {
                const url = granting ? '@Url.Action("GrantConsent", "Patient")' : '@Url.Action("RevokeConsent", "Patient")';
                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ doctorID: doctorId, testRequestTestTypeIDs: testIds })
                });
                if (!response.ok) {
                    const error = await response.json().catch(() => null);
                    throw new Error(error?.message || (response.status === 400
                        ? 'The request could not be validated. Refresh the page and try again.'
                        : 'Access could not be ' + (granting ? 'granted' : 'revoked') + '. Please try again.'));
                }
                const outcome = await response.json();
                if (outcome) document.getElementById('consent-email-status').textContent = outcome.message;
                btn.classList.toggle('on', granting);
                btn.classList.toggle('off', !granting);
                btn.setAttribute('aria-checked', String(granting));
                btn.setAttribute('aria-label', (granting ? 'Revoke access for ' : 'Grant access to ') + name);
                toast(outcome?.message || ('Access revoked from ' + name + '.'));
                await loadSavedConsents();
            } catch (error) {
                toast(error.message || 'Unable to connect. Please try again.');
            } finally {
                btn.disabled = false;
            }
        }
        let sharedResultsLoadVersion = 0;
        let sharedResultsContext = null;
        let revokingSharedResults = false;

        function updateRevokeSelection() {
            document.getElementById('revoke-shared-results').disabled = revokingSharedResults ||
                !document.querySelector('#shared-results-body input[type="checkbox"]:checked');
        }

        async function revokeSharedResults() {
            if (revokingSharedResults || !sharedResultsContext) return;
            const context = sharedResultsContext;
            const selected = Array.from(document.querySelectorAll('#shared-results-body input[type="checkbox"]:checked'))
                .map(input => Number(input.value));
            if (!selected.length) return;
            revokingSharedResults = true;
            updateRevokeSelection();
            const message = document.getElementById('shared-results-message');
            message.textContent = 'Revoking access...';
            document.querySelectorAll('#shared-results-body input').forEach(input => input.disabled = true);
            try {
                const response = await fetch('@Url.Action("RevokeConsent", "Patient")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ doctorID: context.doctorId, testRequestTestTypeIDs: selected })
                });
                if (!response.ok) {
                    const error = await response.json().catch(() => null);
                    throw new Error(error?.message || 'Unable to revoke access. Please try again.');
                }
                const outcome = await response.json();
                document.getElementById('consent-email-status').textContent = outcome.message;
                if (sharedResultsContext === context) {
                    document.querySelectorAll('#shared-results-body input[type="checkbox"]').forEach(input => {
                        if (selected.includes(Number(input.value))) input.closest('tr').remove();
                    });
                    message.textContent = outcome.message;
                }
                await loadSavedConsents();
            } catch (error) {
                if (sharedResultsContext === context) message.textContent = error.message || 'Unable to revoke access. Please try again.';
            } finally {
                revokingSharedResults = false;
                if (sharedResultsContext === context) {
                    document.querySelectorAll('#shared-results-body input').forEach(input => input.disabled = false);
                }
                updateRevokeSelection();
            }
        }
        async function showSharedResults(ref, requestId = 0, selectedTestIds = [], doctorId = 0, isActive = false) {
            if (revokingSharedResults) return;
            sharedResultsContext = { doctorId };
            document.getElementById('shared-results-message').textContent = isActive
                ? '' : 'Access to these results has already been revoked.';
            document.getElementById('revoke-shared-results').disabled = true;
            const version = ++sharedResultsLoadVersion;
            const body = document.getElementById('shared-results-body');
            document.getElementById('shared-results-title').textContent = 'Test Results - ' + ref;
            function showMessage(message) {
                body.replaceChildren();
                const row = body.insertRow();
                const cell = row.insertCell();
                cell.colSpan = 6;
                cell.className = 'td-muted';
                cell.textContent = message;
            }
            showMessage('Loading results...');
            openModal('modal-shared-results');
            if (!selectedTestIds.length) {
                showMessage('No tests selected for this shared request. Grant access with selected tests first.');
                return;
            }
            try {
                const url = new URL('@Url.Action("ConsentResults", "Patient")', window.location.origin);
                url.searchParams.set('testRequestId', requestId);
                url.searchParams.set('reference', ref);
                selectedTestIds.forEach(id => url.searchParams.append('selectedTestIds', id));
                const response = await fetch(url, { cache: 'no-store' });
                if (!response.ok) throw new Error(response.status === 403
                    ? 'Results have not been released by the doctor.'
                    : response.status === 404 ? 'This request was not found.' : 'Unable to load results. Please close and retry.');
                const rows = await response.json();
                if (!Array.isArray(rows)) throw new Error('Unable to load results. Please close and retry.');
                if (version !== sharedResultsLoadVersion) return;
                if (!rows.length) { showMessage('No results found for this request.'); return; }
                body.replaceChildren();
                rows.forEach(result => {
                    const row = body.insertRow();
                    const selectionCell = row.insertCell();
                    const checkbox = document.createElement('input');
                    checkbox.type = 'checkbox';
                    checkbox.value = result.id;
                    checkbox.disabled = !isActive || !doctorId;
                    checkbox.setAttribute('aria-label', 'Revoke access to ' + result.test);
                    checkbox.onchange = updateRevokeSelection;
                    selectionCell.append(checkbox);
                    const abnormal = result.flag === 'High' || result.flag === 'Low';
                    if (abnormal) row.className = 'abnormal-row';
                    [result.test, result.result, result.range, result.units].forEach(value => {
                        row.insertCell().textContent = value ?? 'N/A';
                    });
                    const badge = document.createElement('span');
                    badge.className = 'badge ' + (abnormal ? 'badge-red' : result.flag === 'Normal' ? 'badge-green' : 'badge-gray');
                    badge.textContent = result.flag;
                    row.insertCell().append(badge);
                });
            } catch (error) {
                if (version === sharedResultsLoadVersion) showMessage(error.message || 'Unable to load results. Please retry.');
            }
        }
        let grantDoctors = [];
        let doctorLoadVersion = 0;

        function consentText(value) {
            const element = document.createElement('span');
            element.textContent = value || '';
            return element.innerHTML;
        }

        let grantRequests = [];
        const selectedConsentTests = new Map();
        let consentTestLoadVersion = 0;


        let selectedGrantDoctorIndex = -1;

        async function openGrantDoctorModal() {
            const loadVersion = ++doctorLoadVersion;
            selectedGrantDoctorIndex = -1;
            grantDoctors = [];

            const dropdown = document.getElementById('grant-doctor-results');
            const search = document.getElementById('grant-doctor-search');
            search.value = '';
            search.disabled = true;
            dropdown.replaceChildren(new Option('Loading doctors...', ''));
            dropdown.disabled = true;
            document.getElementById('grant-access-error').style.display = 'none';
            renderSelectedGrantDoctor();
            grantRequests = [];
            selectedConsentTests.clear();
            ++consentTestLoadVersion;
            document.getElementById('grant-request-list').textContent = 'Loading released requests...';
            loadGrantRequests(loadVersion);
            openModal('modal-grant-access');
            await loadGrantDoctors(loadVersion);
        }

        async function loadGrantDoctors(loadVersion = doctorLoadVersion) {
            const dropdown = document.getElementById('grant-doctor-results');
            const search = document.getElementById('grant-doctor-search');
            const errorMessage = document.getElementById('grant-doctor-load-error');
            const retry = document.getElementById('grant-doctor-retry');
            dropdown.replaceChildren(new Option('Loading doctors...', ''));
            dropdown.disabled = search.disabled = true;
            errorMessage.hidden = retry.hidden = true;
            try {
                const response = await fetch('@Url.Action("ConsentDoctors", "Patient")', {
                    headers: { 'Accept': 'application/json' },
                    cache: 'no-store'
                });
                if (response.redirected || response.status === 401 || response.status === 403)
                    throw new Error('Your session has expired. Sign in again to load doctors.');
                const doctors = await response.json();
                if (!response.ok) throw new Error(doctors.message || 'Unable to load doctors from the database.');
                if (!Array.isArray(doctors)) throw new Error('Unable to read the doctor list. Please retry.');
                if (loadVersion !== doctorLoadVersion) return;
                grantDoctors = doctors;
                search.disabled = false;
                renderGrantDoctorResults();
            } catch (error) {
                if (loadVersion !== doctorLoadVersion) return;
                dropdown.replaceChildren(new Option('Unable to load doctors.', ''));
                dropdown.disabled = search.disabled = true;
                errorMessage.textContent = error.message || 'Unable to load doctors. Please retry.';
                errorMessage.hidden = retry.hidden = false;
            }
        }
        function renderGrantDoctorResults() {
            const dropdown = document.getElementById('grant-doctor-results');
            const query = document.getElementById('grant-doctor-search').value.trim().toLowerCase();
            const matches = grantDoctors.map((doctor, index) => ({ doctor, index }))
                .filter(({ doctor }) => [doctor.name, doctor.email, doctor.hpcsaNumber]
                    .some(value => String(value || '').toLowerCase().includes(query)));
            if (!matches.some(item => item.index === selectedGrantDoctorIndex)) {
                selectedGrantDoctorIndex = -1;
                renderSelectedGrantDoctor();
            }
            dropdown.replaceChildren(new Option(matches.length ? 'Select a doctor' :
                query ? 'No doctors match your search.' : 'No doctors available.', ''));
            matches.forEach(({ doctor, index }) => {
                const label = doctor.name + ' - ' + doctor.email +
                    (doctor.hpcsaNumber ? ' - HPCSA: ' + doctor.hpcsaNumber : '');
                dropdown.add(new Option(label, String(index)));
            });
            dropdown.disabled = matches.length === 0;
            dropdown.value = selectedGrantDoctorIndex < 0 ? '' : String(selectedGrantDoctorIndex);
        }

        function selectGrantDoctor(index) {
            selectedGrantDoctorIndex = index;
            renderGrantDoctorResults();
            renderSelectedGrantDoctor();
        }

        function renderSelectedGrantDoctor() {
            const display = document.getElementById('grant-selected-doctor');
            if (!display) return;
            if (selectedGrantDoctorIndex < 0) {
                display.innerHTML = '<p class="td-muted">None selected</p>';
                return;
            }
            const doctor = grantDoctors[selectedGrantDoctorIndex];
            display.innerHTML = `
                <div><strong>${consentText(doctor.name)}</strong></div>
                <div class="td-muted">${consentText(doctor.email)}</div>
            `;
        }

        async function loadGrantRequests(version) {
            const container = document.getElementById('grant-request-list');
            try {
                const response = await fetch('@Url.Action("ConsentRequests", "Patient")', { cache: 'no-store' });
                if (!response.ok) throw new Error();
                const requests = await response.json();
                if (!Array.isArray(requests)) throw new Error();
                if (version !== doctorLoadVersion) return;
                grantRequests = requests;
                renderGrantRequestList();
            } catch {
                if (version === doctorLoadVersion)
                    container.textContent = 'Unable to load released requests. Close this dialog and try again.';
            }
        }

        function renderGrantRequestList() {
            const container = document.getElementById('grant-request-list');
            container.replaceChildren();
            const table = document.createElement('table');
            const headingRow = table.createTHead().insertRow();
            ['TestResults', 'Doctor', 'Date'].forEach(title => {
                const heading = document.createElement('th');
                heading.scope = 'col';
                heading.textContent = title;
                headingRow.append(heading);
            });
            const body = table.createTBody();
            container.append(table);
            if (!grantRequests.length) {
                const cell = body.insertRow().insertCell();
                cell.colSpan = 3;
                cell.className = 'td-muted';
                cell.textContent = 'No released test requests found.';
                return;
            }
            grantRequests.forEach(request => {
                const row = body.insertRow();
                const link = document.createElement('a');
                link.href = '#';
                link.className = 'card-link';
                link.textContent = request.reference;
                link.onclick = event => { event.preventDefault(); openConsentTests(request); };
                const count = selectedConsentTests.get(request.id)?.size || 0;
                const selection = document.createElement('div');
                selection.className = 'td-muted';
                selection.textContent = count + ' tests selected';
                row.insertCell().append(link, selection);
                row.insertCell().textContent = request.doctorName || 'Not recorded';
                row.insertCell().textContent = request.requestDate || 'Not recorded';
            });
        }
        async function openConsentTests(request) {
            const version = ++consentTestLoadVersion;
            const container = document.getElementById('consent-tests-list');
            document.getElementById('consent-tests-title').textContent = 'Select Tests - ' + request.reference;
            container.textContent = 'Loading tests...';
            openModal('modal-consent-tests');
            try {
                const url = new URL('@Url.Action("ConsentRequestTests", "Patient")', window.location.origin);
                url.searchParams.set('testRequestId', request.id);
                const response = await fetch(url, { cache: 'no-store' });
                if (!response.ok) throw new Error();
                const tests = await response.json();
                if (!Array.isArray(tests)) throw new Error();
                if (version !== consentTestLoadVersion) return;
                container.replaceChildren();
                if (!tests.length) { container.textContent = 'No tests found.'; return; }
                if (!selectedConsentTests.has(request.id)) selectedConsentTests.set(request.id, new Set());
                const selected = selectedConsentTests.get(request.id);
                tests.forEach(test => {
                    const label = document.createElement('label');
                    label.className = 'check-row';
                    label.style.cssText = 'display:flex;align-items:center;gap:10px;';
                    const checkbox = document.createElement('input');
                    checkbox.type = 'checkbox';
                    checkbox.value = test.id;
                    checkbox.checked = selected.has(test.id);
                    checkbox.onchange = () => {
                        if (checkbox.checked) selected.add(test.id); else selected.delete(test.id);
                        renderGrantRequestList();
                    };
                    label.append(checkbox, document.createTextNode(test.name));
                    container.append(label);
                });
            } catch {
                if (version === consentTestLoadVersion)
                    container.textContent = 'Unable to load tests. Close this popup and click the request to retry.';
            }
        }
        let pendingConsent = null;
        let savingConsent = false;
        function assignGrantAccess() {
            const errorEl = document.getElementById('grant-access-error');
            if (selectedGrantDoctorIndex < 0) {
                errorEl.textContent = 'Please select a doctor first.';
                errorEl.style.display = 'block';
                return;
            }
            const selectedRequests = grantRequests.filter(request => selectedConsentTests.get(request.id)?.size > 0)
                .map(request => ({ ...request, selectedTestIds: [...selectedConsentTests.get(request.id)] }));
            if (selectedRequests.length === 0) {
                errorEl.textContent = 'Please open a request and select at least one test to share.';
                errorEl.style.display = 'block';
                return;
            }
            errorEl.style.display = 'none';
            const doctor = grantDoctors[selectedGrantDoctorIndex];
            pendingConsent = { doctor, requests: selectedRequests };
            const count = selectedRequests.reduce((total, request) => total + request.selectedTestIds.length, 0);
            document.getElementById('confirm-consent-message').textContent = `Grant ${doctor.name} access to ${count} selected test(s)?`;
            document.getElementById('confirm-consent-error').textContent = '';
            openModal('modal-confirm-consent');
        }

        async function saveConfirmedConsent() {
            if (savingConsent || !pendingConsent) return;
            savingConsent = true;
            const selection = pendingConsent;
            const yes = document.getElementById('consent-yes');
            const no = document.getElementById('consent-no');
            yes.disabled = no.disabled = true;
            yes.textContent = 'Saving...';
            document.getElementById('confirm-consent-error').textContent = '';
            try {
                const response = await fetch('@Url.Action("GrantConsent", "Patient")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({
                        doctorID: selection.doctor.id,
                        testRequestTestTypeIDs: selection.requests.flatMap(request => request.selectedTestIds)
                    })
                });
                if (!response.ok) {
                    const error = await response.json().catch(() => null);
                    throw new Error(error?.message || (response.status === 400
                        ? 'The request could not be validated. Refresh the page and try again.'
                        : 'Consent could not be saved. Please try again.'));
                }
                const outcome = await response.json();
                document.getElementById('consent-email-status').textContent = outcome.message;
                await loadSavedConsents();
                pendingConsent = null;
                closeModal('modal-confirm-consent');
                closeModal('modal-grant-access');
                toast(outcome.message);
            } catch (error) {
                document.getElementById('confirm-consent-error').textContent = error.message;
            } finally {
                savingConsent = false;
                yes.disabled = no.disabled = false;
                yes.textContent = 'Yes';
            }
        }
        function bindSharedResultLinks(row, doctor) {
            row.querySelectorAll('a[data-request-id]').forEach(link => {
                link.onclick = event => {
                    event.preventDefault();
                    const selectedTestIds = link.dataset.testIds.split(',').map(Number).filter(id => Number.isInteger(id) && id > 0);
                    showSharedResults(link.textContent, Number(link.dataset.requestId), selectedTestIds, doctor.id, doctor.isActive);
                };
            });
        }

        let savedConsentLoadVersion = 0;
        async function loadSavedConsents() {
            const version = ++savedConsentLoadVersion;
            const body = document.getElementById('saved-consents-body');
            const count = document.getElementById('consent-count');
            try {
                const response = await fetch('@Url.Action("SavedConsents", "Patient")', { cache: 'no-store' });
                if (!response.ok) throw new Error();
                const doctors = await response.json();
                if (!Array.isArray(doctors)) throw new Error();
                if (version !== savedConsentLoadVersion) return;
                body.replaceChildren();
                count.textContent = `${doctors.filter(doctor => doctor.isActive).length} of ${doctors.length} granted`;
                if (!doctors.length) {
                    body.innerHTML = '<tr><td colspan="5" class="td-muted">No doctor consents found.</td></tr>';
                    return;
                }
                doctors.forEach(doctor => {
                    const row = document.createElement('tr');
                    row.setAttribute('data-searchable', '');
                    const links = doctor.requests.map(request => `<a href="#" class="card-link" data-request-id="${Number(request.id)}" data-test-ids="${request.selectedTestIds.map(Number).join(',')}">${consentText(request.reference)}</a>`).join('<br />');
                    row.innerHTML = `
                        <td><strong>${consentText(doctor.name)}</strong><br /><span class="td-muted">${consentText(doctor.email)}</span></td>
                        <td>${consentText(doctor.hpcsaNumber || 'Not recorded')}</td>
                        <td>${consentText(doctor.specialisation || 'Not recorded')}</td>
                        <td>${links}</td>
                        <td><button type="button" role="switch" class="toggle ${doctor.isActive ? 'on' : 'off'}" aria-checked="${doctor.isActive}"></button></td>`;
                    const button = row.querySelector('.toggle');
                    button.setAttribute('aria-label', (doctor.isActive ? 'Revoke access for ' : 'Grant access to ') + doctor.name);
                    button.onclick = () => toggleConsent(button, doctor.name, doctor.id);
                    bindSharedResultLinks(row, doctor);
                    body.append(row);
                });
            } catch {
                if (version !== savedConsentLoadVersion) return;
                count.textContent = 'Unavailable';
                body.innerHTML = '<tr><td colspan="5" class="td-muted">Unable to load saved consents. <button type="button" class="btn btn-secondary btn-sm" onclick="loadSavedConsents()">Retry</button></td></tr>';
            }
        }
        loadSavedConsents();
    </script>
}
