@model IReadOnlyList<Group_06_NMB_Haematology_Diagnostic_Lab.Data.Models.PatientRequest>
@{
    Layout = "~/Views/Shared/_layoutPatient.cshtml";
    ViewData["Title"] = "Test Requests & Results";
}
<div class="page-body">
    <div class="section-header"><div class="section-sub">Track all requests linked to you and open released result reports.</div></div>
    <div class="card">
        <div class="card-header"><span class="card-title">All Requests</span><span class="td-muted">@Model.Count records</span></div>
        <table>
            <thead><tr><th>Ref #</th><th>Tests Requested</th><th>Doctor</th><th>Date</th><th>Urgency</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var request in Model)
                {
                    var statusClass = request.Status?.Trim().ToLowerInvariant() switch
                    {
                        "submitted" => "badge-amber",
                        "samples received" or "sample(s) received" or "in progress" => "badge-blue",
                        "completed" or "released" or "released by doctor" or "released by the doctor" => "badge-green",
                        "cancelled" => "badge-red",
                        _ => "badge-gray"
                    };
                    <tr data-searchable>
                        <td><strong>@request.RequestNumber</strong></td>
                        <td>@request.TestsRequested</td><td>@request.DoctorName</td>
                        <td>@request.RequestDate.ToString("dd MMM yyyy")</td>
                        <td>@request.Urgency</td><td><span class="badge @statusClass">@request.Status</span></td>
                        <td>
                            @if (string.Equals(request.Status?.Trim(), "Cancelled", StringComparison.OrdinalIgnoreCase))
                            {
                                <button type="button" class="btn btn-primary btn-sm" onclick="document.getElementById('cancel-reason-@request.TestRequestID').showModal()">View reason</button>
                                <dialog id="cancel-reason-@request.TestRequestID" aria-labelledby="cancel-title-@request.TestRequestID" style="max-width: min(560px, 90vw); border: 1px solid #ddd; border-radius: 12px; padding: 24px;">
                                    <h3 id="cancel-title-@request.TestRequestID">Cancellation reason — @request.RequestNumber</h3>
                                    <p style="white-space: pre-wrap; overflow-wrap: anywhere;">@(string.IsNullOrWhiteSpace(request.CancelReason) ? "No cancellation reason was recorded." : request.CancelReason)</p>
                                    <form method="dialog"><button type="submit" class="btn btn-secondary btn-sm">Close</button></form>
                                </dialog>
                            }
                            else
                            {
                                <button type="button" class="btn btn-primary btn-sm" data-request-id="@request.TestRequestID" data-reference="@request.RequestNumber" data-released="@request.IsReleased.ToString().ToLowerInvariant()" onclick="openRequest(this)">@(request.IsReleased ? "View Results" : "View")</button>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="td-muted">No test requests found.</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div id="results-panel" class="card section-gap hidden">
        <div class="card-header">
            <span class="card-title" id="results-title">Released Results</span>
            <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('results-panel').classList.add('hidden')">Close</button>
        </div>
        <div id="request-results" aria-live="polite"></div>
    </div>
</div>
@section Scripts {
    <script>
        let requestLoad;
        async function openRequest(button) {
            if (requestLoad) requestLoad.abort();
            requestLoad = new AbortController();
            const signal = requestLoad.signal;
            const panel = document.getElementById('results-panel');
            const content = document.getElementById('request-results');
            document.getElementById('results-title').textContent =
                (button.dataset.released === 'true' ? 'Released Results - ' : 'Request Detail - ') + button.dataset.reference;
            content.textContent = 'Loading…';
            panel.classList.remove('hidden');
            panel.scrollIntoView({ behavior: 'smooth' });
            try {
                const response = await fetch('@Url.Action("RequestDetails", "Patient")?testRequestId=' + encodeURIComponent(button.dataset.requestId), { signal });
                if (!response.ok || response.redirected) throw new Error('Unable to load request');
                const html = await response.text();
                if (!signal.aborted) content.innerHTML = html;
            } catch (error) {
                if (!signal.aborted) content.textContent = 'Unable to load this request. Please try again.';
            }
        }
        const resultRef = new URLSearchParams(window.location.search).get('resultRef');
        if (resultRef) {
            const button = Array.from(document.querySelectorAll('[data-request-id]'))
                .find(button => button.dataset.reference === resultRef);
            if (button) openRequest(button);
        }
    </script>
}
