@{
    Layout = "~/Views/Shared/_layoutPatient.cshtml";
    ViewData["Title"] = "PDF Reports";
}
<style>
    .recent-reports-card { min-height: 500px; border-radius: 16px; }
    .recent-reports-card .report-list { padding: 12px 44px 32px; }
    .recent-reports-card .list-row { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 24px 0; border-bottom: 1px solid #dfe5ef; }
    .recent-reports-card .list-row:last-child { border-bottom: 0; }
    .recent-reports-card strong { display: block; font-size: 17px; }
    .recent-reports-card small { display: block; color: #7d8ca6; font-size: 14px; }
    .recent-reports-card a { flex-shrink: 0; text-decoration: none; }
    .recent-reports-card a:focus-visible { outline: 2px solid #151515; outline-offset: 2px; }
    #report-message { margin-top: 12px; }
</style>
<div class="page-body">
    <div class="section-header"><div class="section-sub">Generate released test results grouped by test category for a selected result date range.</div></div>
    <div class="grid-2">
        <div class="card">
            <div class="card-header"><span class="card-title">Generate New Report</span></div>
            <form id="generate-report-form" class="card-body" action="@Url.Action("GenerateReport", "Patient")" method="post">
                @Html.AntiForgeryToken()
                <div class="form-row">
                    <div class="form-group"><label class="form-label" for="date-from">Date From</label><input id="date-from" name="From" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-01-01")" required /></div>
                    <div class="form-group"><label class="form-label" for="date-to">Date To</label><input id="date-to" name="To" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div>
                </div>
                <div class="form-group">
                    <label class="form-label" for="report-type">Report Type</label>
                    <select id="report-type" name="AbnormalOnly" class="form-control">
                        <option value="false">All test results grouped by category</option>
                        <option value="true">Abnormal results only</option>
                    </select>
                </div>
                <label class="check-row"><input name="ReferenceRanges" value="true" type="checkbox" checked /> Include reference ranges</label>
                <label class="check-row"><input name="HighlightFlags" value="true" type="checkbox" checked /> Highlight abnormal flags</label>
                <label class="check-row"><input name="DoctorNotes" value="true" type="checkbox" /> Include doctor's notes</label>
                <button id="generate-report-button" type="submit" class="btn btn-primary btn-full section-gap">Generate PDF Report</button>
                <div id="report-message" role="status" aria-live="polite"></div>
            </form>
        </div>
        <div class="card recent-reports-card">
            <div class="card-header"><span class="card-title">Recent Reports</span></div>
            <div id="recent-reports" class="card-body report-list" aria-live="polite"
                 data-list-url="@Url.Action("RecentReports", "Patient")"
                 data-download-url="@Url.Action("DownloadReport", "Patient")"><p>Loading reports...</p></div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/patient-reports.js" asp-append-version="true"></script>
}
