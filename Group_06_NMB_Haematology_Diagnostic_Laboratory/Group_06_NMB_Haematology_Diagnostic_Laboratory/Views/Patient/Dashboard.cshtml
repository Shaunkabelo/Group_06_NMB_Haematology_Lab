@model Group_06_NMB_Haematology_Diagnostic_Lab.Data.Models.PatientDashboard
@{
    Layout = "~/Views/Shared/_LayoutPatient.cshtml";
    ViewData["Title"] = "Patient Dashboard";
}

<div class="page-body patient-dashboard">
    <div class="section-header">
        <div>
            <div class="section-title">Welcome to your patient dashboard, @(ViewData["PatientDisplayName"] as string ?? "Patient").</div>
            <div class="section-sub">Overview of your test requests, released results and health history.</div>
        </div>
    </div>

    <div class="stats-grid">
        <a asp-controller="Patient" asp-action="Requests" class="stat-card clickable teal">
            <div class="stat-label">Total Requests</div>
            <div class="stat-value">@Model.TotalRequests</div>
            <div class="stat-sub">Linked to your patient profile</div>
        </a>
        <a asp-controller="Patient" asp-action="Requests" class="stat-card clickable blue">
            <div class="stat-label">In Progress</div>
            <div class="stat-value">@Model.InProgress</div>
            <div class="stat-sub">Samples being processed</div>
        </a>
        <a asp-controller="Patient" asp-action="Requests" class="stat-card clickable amber">
            <div class="stat-label">Submitted</div>
            <div class="stat-value">@Model.Submitted</div>
            <div class="stat-sub">Awaiting sample receipt</div>
        </a>
        <a asp-controller="Patient" asp-action="Requests" class="stat-card clickable red">
            <div class="stat-label">Abnormal Flags</div>
            <div class="stat-value">@Model.AbnormalFlags</div>
            <div class="stat-sub">Released by your doctor</div>
        </a>
    </div>

    <div class="grid-2 section-gap">
        <div class="card">
            <div class="card-header">
                <span class="card-title">Recent Test Requests</span>
                <a asp-controller="Patient" asp-action="Requests" class="card-link">View all</a>
            </div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr><th>Request</th><th>Date</th><th>Doctor</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentRequests.Count == 0)
                        {
                            <tr><td colspan="4" class="td-muted">No test requests found.</td></tr>
                        }
                        @foreach (var request in Model.RecentRequests)
                        {
                            var statusClass = request.Status?.Trim().ToLowerInvariant() switch
                            {
                                "submitted" => "badge-amber",
                                "samples received" or "sample(s) received" or "in progress" => "badge-blue",
                                "completed" or "released" or "released by doctor" or "released by the doctor" => "badge-green",
                                "cancelled" => "badge-red",
                                _ => "badge-gray"
                            };
                            <tr data-searchable>
                                <td><strong>@request.RequestNumber</strong><br /><span class="td-muted">@request.TestsRequested</span></td>
                                <td>@request.RequestDate.ToString("dd MMM yyyy")</td>
                                <td>@request.DoctorName</td>
                                <td><span class="badge @statusClass">@request.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <span class="card-title">Personalisation Summary</span>
                <a asp-controller="Patient" asp-action="Update" class="card-link">Edit profile</a>
            </div>
            <div class="card-body patient-summary">
                <div><strong>Email username:</strong> @Model.Email</div>
                <div><strong>Conditions:</strong> @Model.Conditions</div>
                <div><strong>Allergies:</strong> @Model.Allergies</div>
                <div><strong>Medication:</strong> @Model.Medication</div>
            </div>
        </div>
    </div>

    <div class="section-gap">
        <a asp-controller="Patient" asp-action="Report" class="btn btn-primary btn-sm">Download Report</a>
    </div>
</div>
