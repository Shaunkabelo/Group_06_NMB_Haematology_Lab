@model IReadOnlyList<Group_06_NMB_Haematology_Diagnostic_Lab.Data.Models.PatientRequestDetail>
@if (Model.Count > 0 && Model.All(test => test.IsReleased))
{
    <div style="overflow-x:auto">
        <table>
            <thead>
                <tr><th>Test</th><th>Result</th><th>Reference Range</th><th>Units</th><th>Flag</th><th>Notes</th></tr>
            </thead>
            <tbody>
                @foreach (var test in Model)
                {
                    var abnormal = test.ResultFlag is "Low" or "High";
                    var flagClass = test.ResultFlag switch
                    {
                        "Low" or "High" => "badge-red",
                        "Normal" => "badge-green",
                        _ => "badge-gray"
                    };
                    <tr class="@(abnormal ? "abnormal-row" : "")">
                        <td>@test.TestName</td>
                        <td>@(test.ResultValue?.ToString("0.############################") ?? "Pending")</td>
                        <td>@test.ReferenceRange</td>
                        <td>@test.UnitOfMeasurement</td>
                        <td><span class="badge @flagClass">@test.ResultFlag</span></td>
                        <td>
                            <a href="#notes-@test.TestRequestTestTypeID" style="text-decoration: none;" onclick="document.getElementById('notes-@test.TestRequestTestTypeID').showModal(); return false;" aria-label="View technician notes for @test.TestName">View</a>
                            <dialog id="notes-@test.TestRequestTestTypeID" aria-labelledby="notes-title-@test.TestRequestTestTypeID" style="max-width: min(560px, 90vw); border: 1px solid #ddd; border-radius: 12px; padding: 24px;">
                                <h3 id="notes-title-@test.TestRequestTestTypeID">Lab technician notes — @test.TestName</h3>
                                <p style="white-space: pre-wrap; overflow-wrap: anywhere;">@(string.IsNullOrWhiteSpace(test.ResultNotes) ? "No technician notes were recorded for this test." : test.ResultNotes)</p>
                                <form method="dialog"><button class="btn btn-secondary btn-sm">Close</button></form>
                            </dialog>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="card-body td-muted">Results will be available once released by your doctor.</div>
}
