@using Group_06_NMB_Haematology_Diagnostic_Lab.Data.Models
@model PatientRegistrationViewModel

@{
    Layout = "~/Views/Shared/_layoutPatient.cshtml";
    ViewData["Title"] = "Patient Registration";

}

<div class="card form-card">

    ```
    <div class="card-header">
        <span class="card-title">Registration Details</span>
    </div>

    <div class="card-body">

        @* Success Message *@
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">

                @TempData["SuccessMessage"]

                @if (TempData["PatientId"] != null)
                {
                    <br />

                    <strong>
                        Patient ID:
                        @TempData["PatientId"]
                    </strong>
                }

            </div>
        }


        @* Validation Summary *@
        <div asp-validation-summary="ModelOnly"
             class="text-danger">
        </div>


        @* Patient Registration Form *@
        <form asp-controller="Patient"
              asp-action="Register"
              method="post"
              id="patientRegistrationForm">


            @* Name and Surname *@
            <div class="form-row">

                <div class="form-group">

                    <label asp-for="Name"
                           class="form-label">
                        Name
                    </label>

                    <input asp-for="Name"
                           id="reg-fname"
                           class="form-control"
                           placeholder="Name" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>


                <div class="form-group">

                    <label asp-for="Surname"
                           class="form-label">
                        Surname
                    </label>

                    <input asp-for="Surname"
                           id="reg-lname"
                           class="form-control"
                           placeholder="Surname" />

                    <span asp-validation-for="Surname"
                          class="text-danger">
                    </span>

                </div>

            </div>


            @* SA ID and Date of Birth *@
            <div class="form-row">

                <div class="form-group">

                    <label asp-for="SaIdNumber"
                           class="form-label">
                        South African ID Number
                    </label>

                    <input asp-for="SaIdNumber"
                           id="reg-id"
                           class="form-control"
                           placeholder="SA ID Number" />

                    <span asp-validation-for="SaIdNumber"
                          class="text-danger">
                    </span>

                </div>


                <div class="form-group">

                    <label asp-for="DateOfBirth"
                           class="form-label">
                        Date of Birth
                    </label>

                    <input asp-for="DateOfBirth"
                           id="reg-dob"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="DateOfBirth"
                          class="text-danger">
                    </span>

                </div>

            </div>


            @* Cellphone and Email *@
            <div class="form-row">

                <div class="form-group">

                    <label asp-for="Cellphone"
                           class="form-label">
                        Cellphone Number
                    </label>

                    <input asp-for="Cellphone"
                           id="reg-phone"
                           class="form-control"
                           placeholder="Cell" />

                    <span asp-validation-for="Cellphone"
                          class="text-danger">
                    </span>

                </div>


                <div class="form-group">

                    <label asp-for="Email"
                           class="form-label">
                        Email Address / Username
                    </label>

                    <input asp-for="Email"
                           id="reg-email"
                           type="email"
                           class="form-control"
                           placeholder="Email" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>

            </div>


            @* Home Address *@
            <div class="form-group">

                <label asp-for="HomeAddress"
                       class="form-label">
                    Home Address
                </label>

                <input asp-for="HomeAddress"
                       id="reg-addr"
                       data-address-autocomplete
                       class="form-control"
                       placeholder="Start typing your physical address" />

                <span asp-validation-for="HomeAddress"
                      class="text-danger">
                </span>

            </div>


            @* Password and Confirm Password *@
            <div class="form-row">

                <div class="form-group">

                    <label asp-for="Password"
                           class="form-label">
                        Password
                    </label>

                    <div class="password-field">

                        <input asp-for="Password"
                               id="reg-password"
                               type="password"
                               class="form-control"
                               placeholder="Password"
                               oninput="validatePassword('reg-password')" />

                    </div>

                    <div id="reg-password-hint"
                         class="form-hint">

                        Use 8+ characters, uppercase,
                        number and special character.

                    </div>

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>

                </div>


                <div class="form-group">

                    <label asp-for="ConfirmPassword"
                           class="form-label">
                        Confirm Password
                    </label>

                    <input asp-for="ConfirmPassword"
                           id="reg-confirm-password"
                           type="password"
                           class="form-control"
                           placeholder="Confirm Password" />

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger">
                    </span>

                </div>

            </div>


            @* Register Button *@
            <div class="form-group">

                <button id="register-btn"
                        class="btn btn-primary"
                        type="submit">

                    Register Patient

                </button>

            </div>

        </form>

    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        function validatePassword(inputId)
        {
            const password =
                document.getElementById(inputId).value;

            const hint =
                document.getElementById("reg-password-hint");

            const hasLength =
                password.length >= 8;

            const hasUppercase =
                /[A-Z]/.test(password);

            const hasNumber =
                /[0-9]/.test(password);

            const hasSpecial =
                /[^A-Za-z0-9]/.test(password);

            if (
                hasLength &&
                hasUppercase &&
                hasNumber &&
                hasSpecial
            )
            {
                hint.textContent =
                    "Password meets all requirements.";

                hint.classList.remove("text-danger");
                hint.classList.add("text-success");
            }
            else
            {
                hint.textContent =
                    "Use 8+ characters, uppercase, number and special character.";

                hint.classList.remove("text-success");
                hint.classList.add("text-danger");
            }
        }

    </script>
    <script src="~/js/address-autocomplete.js" asp-append-version="true"></script>

}
