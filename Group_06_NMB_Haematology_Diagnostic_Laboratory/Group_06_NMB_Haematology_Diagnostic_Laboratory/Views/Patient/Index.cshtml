@using Group_06_NMB_Haematology_Diagnostic_Lab.Data.Models
@model PatientRegistrationViewModel

@{
    ViewData["Title"] = "Patient Registration";
}

<div class="card form-card">

    <div class="card-header">
        <span class="card-title">Registration Details</span>
    </div>

    <div class="card-body">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]

                @if (TempData["PatientId"] != null)
                {
                    <br />
                    <strong>
                        Patient ID:
                        @TempData["PatientId"]
                    </strong>
                }
            </div>
        }

        <div asp-validation-summary="ModelOnly"
             class="text-danger">
        </div>

        <form asp-controller="Patients"
              asp-action="Register"
              method="post"
              id="patientRegistrationForm">

            <div class="form-row">

                <div class="form-group">

                    <label class="form-label">
                        Name
                    </label>

                    <input asp-for="Name"
                           id="reg-fname"
                           class="form-control"
                           placeholder="Name" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>


                <div class="form-group">

                    <label class="form-label">
                        Surname
                    </label>

                    <input asp-for="Surname"
                           id="reg-lname"
                           class="form-control"
                           placeholder="Surname" />

                    <span asp-validation-for="Surname"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <div class="form-row">

                <div class="form-group">

                    <label class="form-label">
                        South African ID Number
                    </label>

                    <input asp-for="SaIdNumber"
                           id="reg-id"
                           class="form-control"
                           placeholder="SA ID Number" />

                    <span asp-validation-for="SaIdNumber"
                          class="text-danger">
                    </span>

                </div>


                <div class="form-group">

                    <label class="form-label">
                        Date of Birth
                    </label>

                    <input asp-for="DateOfBirth"
                           id="reg-dob"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="DateOfBirth"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <div class="form-row">

                <div class="form-group">

                    <label class="form-label">
                        Cellphone Number
                    </label>

                    <input asp-for="Cellphone"
                           id="reg-phone"
                           class="form-control"
                           placeholder="Cell" />

                    <span asp-validation-for="Cellphone"
                          class="text-danger">
                    </span>

                </div>


                <div class="form-group">

                    <label class="form-label">
                        Email Address / Username
                    </label>

                    <input asp-for="Email"
                           id="reg-email"
                           type="email"
                           class="form-control"
                           placeholder="Email" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <div class="form-group">

                <label class="form-label">
                    Home Address
                </label>

                <input asp-for="HomeAddress"
                       id="reg-addr"
                       class="form-control"
                       placeholder="Physical Address" />

                <span asp-validation-for="HomeAddress"
                      class="text-danger">
                </span>

            </div>


            <div class="form-row">

                <div class="form-group">

                    <label class="form-label">
                        Password
                    </label>

                    <div class="password-field">

                        <input asp-for="Password"
                               id="reg-password"
                               type="password"
                               class="form-control"
                               oninput="validatePassword('reg-password')" />

                    </div>

                    <div id="reg-password-hint"
                         class="form-hint">

                        Use 8+ characters, uppercase,
                        number and special character.

                    </div>

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>

                </div>


                <div class="form-group">

                    <label class="form-label">
                        Confirm Password
                    </label>

                    <input asp-for="ConfirmPassword"
                           id="reg-confirm-password"
                           type="password"
                           class="form-control" />

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <button id="register-btn"
                    class="btn btn-primary"
                    type="submit">

                Register Patient

            </button>

        </form>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}