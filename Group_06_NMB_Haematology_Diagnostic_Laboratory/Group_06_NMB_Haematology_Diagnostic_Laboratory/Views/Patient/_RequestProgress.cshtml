@model IReadOnlyList<Group_06_NMB_Haematology_Diagnostic_Lab.Data.Models.PatientRequestDetail>
<div style="overflow-x:auto">
    <table>
        <thead>
            <tr><th>Test</th><th>Test Status</th><th>Lab Technician Name</th><th>Started</th></tr>
        </thead>
        <tbody>
            @foreach (var test in Model)
            {
                <tr>
                    <td>@test.TestName</td>
                    <td>@test.TestStatus</td>
                    <td>@(string.IsNullOrWhiteSpace(test.LabTechnicianName) ? "Not assigned" : test.LabTechnicianName)</td>
                    <td>@(test.StartDateTime?.ToString("dd MMM yyyy HH:mm") ?? "Not started")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
