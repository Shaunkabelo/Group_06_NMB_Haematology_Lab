@{
    ViewData["Title"] = "Doctor Reports";
    Layout = "~/Views/Shared/_LayoutDoctor.cshtml";
}

<div class="page-body">
    <div class="section-header">
        <div class="section-title">Doctor Reports</div>
        <div class="section-sub">Generate PDF reports for all test requests submitted by the doctor in a date range.</div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="form-row">
                <div class="form-group"><label class="form-label">Start Date</label><input class="form-control" type="date" value="2026-05-01"></div>
                <div class="form-group"><label class="form-label">End Date</label><input class="form-control" type="date" value="2026-05-31"></div>
            </div>
            <button class="btn btn-primary" type="button" onclick="toast('Doctor request PDF generated.')">Generate PDF</button>
        </div>
    </div>
</div>
