@{
    ViewData["Title"] = "Doctor Reports";
    Layout = "~/Views/Shared/_LayoutDoctor.cshtml";
}

<div class="page-body">

    <div class="section-header">
        <div class="section-title">Doctor Reports</div>

        <div class="section-sub">
            Generate PDF reports for all test requests submitted by the doctor in a selected date range.
        </div>
    </div>

    <div class="card">
        <div class="card-body">

            <div class="form-row">

                <div class="form-group">
                    <label class="form-label" for="report-start-date">
                        Start Date
                    </label>

                    <input id="report-start-date"
                           class="form-control"
                           type="date" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="report-end-date">
                        End Date
                    </label>

                    <input id="report-end-date"
                           class="form-control"
                           type="date" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="report-sort-order">Sort by</label>
                    <select id="report-sort-order" class="form-control">
                        <option value="date">Date (newest first)</option>
                        <option value="name">Patient name (A-Z)</option>
                    </select>
                </div>

            </div>

            <div class="report-actions">

                <button id="generate-report-btn"
                        class="btn btn-primary"
                        type="button"
                        data-report-url="@Url.Action("GetReportRequests", "Doctor")">
                    Generate PDF
                </button>

            </div>

            <div id="report-status"
                 class="report-status"
                 aria-live="polite">
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/doctor-reports.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/DoctorReports.css" asp-append-version="true" />
}
