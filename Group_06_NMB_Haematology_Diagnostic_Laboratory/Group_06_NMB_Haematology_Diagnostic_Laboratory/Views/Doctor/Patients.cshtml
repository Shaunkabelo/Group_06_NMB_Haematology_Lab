@{
    ViewData["Title"] = "Patient Records";
    Layout = "~/Views/Shared/_LayoutDoctor.cshtml";
}

<div class="page-body">

    <style>
        .patient-info-panel {
            background: #f9fbfd;
            border: 1px solid #e5ecf4;
            border-radius: 14px;
            padding: 18px;
        }

        .patient-info-panel .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 14px 18px;
            margin-top: 8px;
        }

        .patient-info-panel .info-item {
            display: grid;
            gap: 6px;
            background: #ffffff;
            border: 1px solid #edf2f7;
            border-radius: 10px;
            padding: 10px 12px;
        }

        .patient-info-panel .info-item label,
        .patient-info-panel .info-section h4 {
            margin: 0;
            color: #5f6f84;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.03em;
            text-transform: uppercase;
        }

        .patient-info-panel .info-item span {
            color: #1d2d3d;
            font-size: 14px;
            line-height: 1.5;
            word-break: break-word;
        }

        .patient-extra-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 16px;
            margin-top: 20px;
        }

        .patient-extra-grid .info-section {
            background: #ffffff;
            border: 1px solid #edf2f7;
            border-radius: 12px;
            padding: 14px 16px;
        }

        .patient-history-list {
            display: grid;
            gap: 10px;
            margin-top: 10px;
        }

        .history-item {
            background: #f5f8fb;
            border: 1px solid #e6edf5;
            border-radius: 10px;
            padding: 12px;
        }

        .history-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
            margin-bottom: 6px;
        }

        .history-header strong {
            font-size: 14px;
            color: #1d2d3d;
        }

        .history-meta {
            color: #627287;
            font-size: 12px;
            line-height: 1.5;
        }

        @@media (max-width: 700px) {
            .patient-info-panel {
                padding: 14px;
            }

            .patient-info-panel .info-grid,
            .patient-extra-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>

    <div class="section-header">
        <div class="section-title">Patient Records</div>
        <div class="section-sub">
            Register new patients and maintain medical details used during test requests.
        </div>
    </div>

    <section class="page-stack">

        <!-- ============================================================
             PATIENT INFORMATION
        ============================================================= -->

        <div class="card">

            <div class="card-header">
                <span class="card-title">Patient Information</span>
            </div>

            <div class="card-body">

                <div class="form-group">

                    <label class="form-label"
                           for="doc-pat-id">
                        Search Patient by SA ID
                    </label>

                    <input id="doc-pat-id"
                           class="form-control"
                           type="text"
                           inputmode="numeric"
                           maxlength="13"
                           pattern="[0-9]*"
                           autocomplete="off"
                           placeholder="Enter patient SA ID" />

                </div>


                <!-- Selected Patient -->

                <div id="selected-patient-summary"
                     class="patient-info-panel"
                     style="display:none; margin-bottom:18px;">

                    <div class="info-section">

                        <h4>Selected Patient</h4>

                        <div class="info-grid">

                            <div class="info-item">
                                <label>Name</label>
                                <span id="selected-patient-name"></span>
                            </div>

                            <div class="info-item">
                                <label>ID Number</label>
                                <span id="selected-patient-id"></span>
                            </div>

                            <div class="info-item">
                                <label>Date of Birth</label>
                                <span id="selected-patient-dob"></span>
                            </div>

                            <div class="info-item">
                                <label>Address</label>
                                <span id="selected-patient-address"></span>
                            </div>

                            <div class="info-item">
                                <label>Contact Number</label>
                                <span id="selected-patient-contact"></span>
                            </div>

                            <div class="info-item">
                                <label>Email</label>
                                <span id="selected-patient-email"></span>
                            </div>

                            <div class="info-item">
                                <label>Medical Conditions</label>
                                <span id="selected-patient-conditions">None recorded</span>
                            </div>

                            <div class="info-item">
                                <label>Allergies</label>
                                <span id="selected-patient-allergies">None recorded</span>
                            </div>

                            <div class="info-item">
                                <label>Medication</label>
                                <span id="selected-patient-medication">None recorded</span>
                            </div>

                        </div>

                        <div class="patient-extra-grid">

                            <div class="info-section">

                                <h4>Test Request History</h4>

                                <div id="selected-patient-request-history"
                                     class="patient-history-list">
                                    No request history recorded.
                                </div>

                            </div>


                            <div class="info-section">

                                <h4>Results Available with Patient Consent</h4>

                                <div id="selected-patient-consent-results"
                                     class="patient-history-list">
                                    No consented results available.
                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ====================================================
                     MEDICAL CONDITIONS
                ===================================================== -->

                <div class="form-group">

                    <label class="form-label">
                        Known Medical Conditions
                    </label>

                    <div class="form-row"
                         style="gap:10px; align-items:flex-end;">

                        <div class="form-group"
                             style="flex:2; margin-bottom:0;">

                            <label class="form-label">
                                Category
                            </label>

                            <select id="doc-pat-condition-category"
                                    class="form-control">

                                <option value="">
                                    -- Select Category --
                                </option>

                            </select>

                        </div>


                        <div class="form-group"
                             style="flex:3; margin-bottom:0;">

                            <label class="form-label">
                                Condition
                            </label>

                            <select id="doc-pat-condition-name"
                                    class="form-control"
                                    disabled>

                                <option value="">
                                    -- Select Condition --
                                </option>

                            </select>

                        </div>


                        <div class="form-group"
                             style="flex:1; margin-bottom:0;">

                            <button class="btn btn-primary"
                                    type="button"
                                    onclick="addPatientCondition()">

                                Add Condition

                            </button>

                        </div>

                    </div>


                    <div class="pills-container"
                         id="condition-pills"
                         style="margin-top:10px;">
                    </div>

                </div>


                <!-- ====================================================
                     ALLERGIES
                ===================================================== -->

                <div class="form-row">

                    <div class="form-group">

                        <label class="form-label">
                            Allergies
                        </label>

                        <div class="form-row"
                             style="gap:10px; align-items:flex-end;">

                            <div class="form-group"
                                 style="flex:2; margin-bottom:0;">

                                <label class="form-label">
                                    Category
                                </label>

                                <select id="doc-pat-allergy-category"
                                        class="form-control">

                                    <option value="">
                                        -- Select Category --
                                    </option>

                                </select>

                            </div>


                            <div class="form-group"
                                 style="flex:3; margin-bottom:0;">

                                <label class="form-label">
                                    Allergy
                                </label>

                                <select id="doc-pat-allergy-name"
                                        class="form-control"
                                        disabled>

                                    <option value="">
                                        -- Select Allergy --
                                    </option>

                                </select>

                            </div>


                            <div class="form-group"
                                 style="flex:1; margin-bottom:0;">

                                <button class="btn btn-primary"
                                        type="button"
                                        onclick="addPatientAllergy()">

                                    Add Allergy

                                </button>

                            </div>

                        </div>


                        <div class="pills-container"
                             id="allergies-pills"
                             style="margin-top:10px;">
                        </div>

                    </div>

                </div>


                <!-- ====================================================
                     MEDICATION
                ===================================================== -->

                <div class="form-group">

                    <label class="form-label">
                        Current Medication
                    </label>

                    <div class="form-row"
                         style="gap:10px; align-items:flex-end;">

                        <div class="form-group"
                             style="flex:2; margin-bottom:0;">

                            <label class="form-label">
                                Category
                            </label>

                            <select id="doc-pat-medication-category"
                                    class="form-control">

                                <option value="">
                                    -- Select Category --
                                </option>

                            </select>

                        </div>


                        <div class="form-group"
                             style="flex:3; margin-bottom:0;">

                            <label class="form-label">
                                Medication
                            </label>

                            <select id="doc-pat-medication-name"
                                    class="form-control"
                                    disabled>

                                <option value="">
                                    -- Select Medication --
                                </option>

                            </select>

                        </div>


                        <div class="form-group"
                             style="flex:1; margin-bottom:0;">

                            <button class="btn btn-primary"
                                    type="button"
                                    onclick="addPatientMedication()">

                                Add Medication

                            </button>

                        </div>

                    </div>


                    <div class="pills-container"
                         id="medication-pills"
                         style="margin-top:10px;">
                    </div>

                </div>


                <div style="display:flex; justify-content:flex-end; gap:10px; flex-wrap:wrap; margin-top: 10px;">

                    <button class="btn btn-primary"
                            type="button"
                            onclick="refreshPatientData()">

                        Refresh Patient Data

                    </button>

                    <button class="btn btn-primary"
                            type="button"
                            onclick="openCreateRequest()">

                        + New Test Request

                    </button>

                </div>

            </div>

        </div>


        <!-- ============================================================
             EXISTING PATIENTS
        ============================================================= -->

        <div class="card"
             style="margin-top:20px;">

            <div class="card-header">

                <span class="card-title">
                    My Patients
                </span>

            </div>


            <div class="table-wrap">

                <table class="doctor-patients-table">

                    <thead>

                        <tr>

                            <th>ID Number</th>

                            <th>Physical Address</th>

                            <th>Conditions</th>

                            <th>Allergies</th>

                            <th>Medication</th>

                            <th>Action</th>

                        </tr>

                    </thead>


                    <tbody id="doctor-patients-tbody">

                        <tr>

                            <td colspan="6">
                                Loading patients...
                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </section>
    ```

</div>

<div id="patient-not-found-modal"
     role="dialog"
     aria-modal="true"
     aria-labelledby="patient-not-found-title"
     style="display:none; position:fixed; inset:0; z-index:1000; align-items:center; justify-content:center; padding:16px; background:rgba(11,25,41,.55);">
    <div class="modal modal-sm">
        <div class="modal-header">
            <span id="patient-not-found-title" class="modal-title">Patient not found</span>
            <button class="modal-close" type="button" onclick="closePatientNotFoundModal()" aria-label="Close">&times;</button>
        </div>
        <div class="modal-body">
            <p id="patient-not-found-message">This patient does not exist in the system.</p>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" type="button" onclick="closePatientNotFoundModal()">Close</button>
            <a class="btn btn-primary" href="@Url.Action("Register", "Account")">Register Patient</a>
        </div>
    </div>
</div>

<script>
        async function viewPatientFromTable(button) {

        const saIdNumber =
            button.dataset.saId;

        if (!saIdNumber) {

            toast(
                'Patient SA ID number was not found.'
            );

            return;
        }


        const originalText =
            button.textContent;


        try {

            // ==============================================
            // BUTTON LOADING STATE
            // ==============================================

            button.disabled = true;

            button.textContent =
                'Loading...';


            // ==============================================
            // GET COMPLETE PATIENT
            // ==============================================

            const response =
                await fetch(
                    `${doctorUrls.getPatient}?saIdNumber=${encodeURIComponent(saIdNumber)}`
                );


            if (!response.ok) {

                throw new Error(
                    'Unable to load patient details.'
                );
            }


            const patient =
                await response.json();


            // ==============================================
            // UPDATE SELECTED PATIENT
            // ==============================================

            selectedPatient =
                patient;


            const select =
                document.getElementById(
                    'doc-pat-id'
                );

            select.value =
                saIdNumber;


            // ==============================================
            // DISPLAY PATIENT INFORMATION ABOVE
            // ==============================================

            displayPatientDetails(
                patient
            );


            document.getElementById(
                'selected-patient-summary'
            ).style.display =
                'block';


            // ==============================================
            // FIND TABLE ROW
            // ==============================================

            const row =
                button.closest('tr');


            if (!row) {

                throw new Error(
                    'Patient table row was not found.'
                );
            }


            // ==============================================
            // CONDITIONS
            // ==============================================

            const conditions =
                patient.knownMedicalConditions ||
                patient.medicalConditions ||
                patient.conditions ||
                'None recorded';


            row.querySelector(
                '.patient-conditions'
            ).innerHTML = `

                <span class="medical-cell">
                    ${escapeHtml(conditions)}
                </span>
            `;


            // ==============================================
            // ALLERGIES
            // ==============================================

            const allergies =
                patient.allergies ||
                'None recorded';


            row.querySelector(
                '.patient-allergies'
            ).innerHTML = `

                <span class="medical-cell">
                    ${escapeHtml(allergies)}
                </span>
            `;


            // ==============================================
            // MEDICATION
            // ==============================================

            const medication =
                patient.medication ||
                patient.medications ||
                'None recorded';


            row.querySelector(
                '.patient-medication'
            ).innerHTML = `

                <span class="medical-cell">
                    ${escapeHtml(medication)}
                </span>
            `;


            // Scroll patient details into view
            document.getElementById(
                'selected-patient-summary'
            ).scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });

        }
        catch (error) {

            console.error(error);

            toast(
                error.message ||
                'Unable to load patient details.'
            );

        }
        finally {

            button.disabled =
                false;

            button.textContent =
                originalText;
        }
    }

    // ================================================================
    // CONTROLLER URLS
    // ================================================================

    const doctorUrls = {

        getPatients:
            '@Url.Action("GetPatients", "Doctor")',

        getPatient:
            '@Url.Action("GetPatient", "Doctor")',

        getConditionCategories:
            '@Url.Action("GetConditionCategories", "Doctor")',

        getConditionsByCategory:
            '@Url.Action("GetConditionsByCategory", "Doctor")',

        addPatientCondition:
            '@Url.Action("AddPatientCondition", "Doctor")',

        deletePatientCondition:
            '@Url.Action("DeletePatientCondition", "Doctor")',

        getAllergyCategories:
            '@Url.Action("GetAllergyCategories", "Doctor")',

        getAllergiesByCategory:
            '@Url.Action("GetAllergiesByCategory", "Doctor")',

        addPatientAllergy:
            '@Url.Action("AddPatientAllergy", "Doctor")',

        deletePatientAllergy:
            '@Url.Action("DeletePatientAllergy", "Doctor")',

        getMedicationCategories:
            '@Url.Action("GetMedicationCategories", "Doctor")',

        getMedicationsByCategory:
            '@Url.Action("GetMedicationsByCategory", "Doctor")',

        addPatientMedication:
            '@Url.Action("AddPatientMedication", "Doctor")',

        deletePatientMedication:
            '@Url.Action("DeletePatientMedication", "Doctor")'

    };


    // ================================================================
    // GLOBAL STATE
    // ================================================================

    let selectedPatient = null;


    // ================================================================
    // TOAST / MESSAGE
    // ================================================================

    function toast(message) {

        alert(message);

    }


    // ================================================================
    // LOAD PATIENTS
    // ================================================================

        async function loadPatients() {

        const select =
            document.getElementById('doc-pat-id');

        const tbody =
            document.getElementById('doctor-patients-tbody');

        try {

            const response =
                await fetch(doctorUrls.getPatients);

            if (!response.ok) {

                throw new Error(
                    'Unable to load patients.'
                );
            }

            const patients =
                await response.json();


            // Reset patient search input
            select.value = '';


            // Reset table
            tbody.innerHTML = '';


            if (!patients || patients.length === 0) {

                tbody.innerHTML = `
                    <tr>
                        <td colspan="6">
                            No patients found.
                        </td>
                    </tr>
                `;

                return;
            }


            patients.forEach(patient => {

                // ==============================================
                // CREATE PATIENT TABLE ROW
                // ==============================================

                const row =
                    document.createElement('tr');

                row.id =
                    `patient-row-${patient.patientId}`;


                row.innerHTML = `

                    <td data-label="ID Number">
                        ${escapeHtml(
                            patient.saIdNumber || 'N/A'
                        )}
                    </td>


                    <td data-label="Physical Address">
                        ${escapeHtml(
                            patient.address ||
                            patient.homeAddress ||
                            'N/A'
                        )}
                    </td>


                    <td data-label="Conditions"
                        class="patient-conditions">

                        <span class="medical-empty">
                            Click View
                        </span>

                    </td>


                    <td data-label="Allergies"
                        class="patient-allergies">

                        <span class="medical-empty">
                            Click View
                        </span>

                    </td>


                    <td data-label="Medication"
                        class="patient-medication">

                        <span class="medical-empty">
                            Click View
                        </span>

                    </td>


                    <td data-label="Action">

                        <button
                            type="button"
                            class="btn btn-primary patient-view-btn"
                            data-sa-id="${escapeHtml(
                                patient.saIdNumber || ''
                            )}"
                            onclick="viewPatientFromTable(this)">

                            View

                        </button>

                    </td>
                `;


                tbody.appendChild(row);
            });

        }
        catch (error) {

            console.error(
                'loadPatients error:',
                error
            );


            tbody.innerHTML = `
                <tr>
                    <td colspan="6">
                        Unable to load patients.
                    </td>
                </tr>
            `;


            toast(
                'Unable to load patients from the database.'
            );
        }
    }


    function sanitizeSaIdInput(value) {
        return String(value || '')
            .replace(/\D/g, '')
            .slice(0, 13);
    }


    function validateSaIdNumber(value) {
        return /^\d{13}$/.test(value);
    }


    // ================================================================
    // SELECT PATIENT
    // ================================================================

    async function loadSelectedPatientSummary() {

        const patientIdInput =
            document.getElementById('doc-pat-id');

        const saIdNumber =
            sanitizeSaIdInput(patientIdInput.value);

        patientIdInput.value =
            saIdNumber;


        const panel =
            document.getElementById(
                'selected-patient-summary'
            );


        if (!saIdNumber) {

            selectedPatient = null;

            panel.style.display = 'none';

            clearPatientDetails();

            return;

        }


        if (!validateSaIdNumber(saIdNumber)) {

            selectedPatient = null;

            panel.style.display = 'none';

            clearPatientDetails();

            toast('SA ID must contain exactly 13 numbers.');
            patientIdInput.focus();
            return;

        }


        try {

            const response =
                await fetch(
                    `${doctorUrls.getPatient}?saIdNumber=${encodeURIComponent(saIdNumber)}`
                );


            if (!response.ok) {

                if (response.status === 404) {
                    showPatientNotFoundModal(saIdNumber);
                    return;
                }

                throw new Error(
                    'Patient could not be loaded.'
                );

            }


            const patient =
                await response.json();


            selectedPatient = patient;


            displayPatientDetails(patient);


            panel.style.display = 'block';


            clearMedicalHistoryPills();

        }
        catch (error) {

            console.error(error);

            selectedPatient = null;

            panel.style.display = 'none';

            toast(
                'Unable to load the selected patient.'
            );

        }

    }


    function showPatientNotFoundModal(saIdNumber) {

        document.getElementById(
            'patient-not-found-message'
        ).textContent =
            `Patient with SA ID ${saIdNumber} does not exist in the system.`;

        document.getElementById(
            'patient-not-found-modal'
        ).style.display = 'flex';

    }


    function closePatientNotFoundModal() {

        document.getElementById(
            'patient-not-found-modal'
        ).style.display = 'none';

    }


    // ================================================================
    // DISPLAY PATIENT DETAILS
    // ================================================================

    function displayPatientDetails(patient) {

        document.getElementById(
            'selected-patient-name'
        ).textContent =
            `${patient.name || ''} ${patient.surname || ''}`.trim();


        document.getElementById(
            'selected-patient-id'
        ).textContent =
            patient.saIdNumber || 'N/A';


        document.getElementById(
            'selected-patient-dob'
        ).textContent =
            formatDate(patient.dateOfBirth);


        document.getElementById(
            'selected-patient-address'
        ).textContent =
            patient.address ||
            patient.homeAddress ||
            'N/A';


        document.getElementById(
            'selected-patient-contact'
        ).textContent =
            patient.contactNumber ||
            patient.cellphone ||
            'N/A';


        document.getElementById(
            'selected-patient-email'
        ).textContent =
            patient.email ||
            patient.Email ||
            'N/A';


        document.getElementById(
            'selected-patient-conditions'
        ).textContent =
            formatMedicalList(
                patient.knownMedicalConditions ||
                patient.KnownMedicalConditions
            );


        document.getElementById(
            'selected-patient-allergies'
        ).textContent =
            formatMedicalList(
                patient.allergies ||
                patient.Allergies
            );


        document.getElementById(
            'selected-patient-medication'
        ).textContent =
            formatMedicalList(
                patient.medication ||
                patient.Medication
            );


        renderPatientHistory(patient);

    }


    function formatMedicalList(value) {

        if (value === null || value === undefined || value === '') {

            return 'None recorded';

        }

        const values =
            (Array.isArray(value) ? value : String(value).split(','))
                .map(item => {

                    if (typeof item === 'string') {
                        return item.trim();
                    }

                    return item.name ||
                        item.Name ||
                        item.conditionName ||
                        item.ConditionName ||
                        item.allergyName ||
                        item.AllergyName ||
                        item.medicationName ||
                        item.MedicationName ||
                        '';

                })
                .filter(item => item);

        return values.length
            ? values.sort((a, b) => a.localeCompare(b, undefined, { sensitivity: 'base' })).join(', ')
            : 'None recorded';

    }


    function renderPatientHistory(patient) {
        return window.loadDoctorPatientHistory(patient, 'selected-patient-');
    }

    function clearPatientDetails() {

        document.getElementById(
            'selected-patient-name'
        ).textContent = '';


        document.getElementById(
            'selected-patient-id'
        ).textContent = '';


        document.getElementById(
            'selected-patient-dob'
        ).textContent = '';


        document.getElementById(
            'selected-patient-address'
        ).textContent = '';


        document.getElementById(
            'selected-patient-contact'
        ).textContent = '';


        document.getElementById(
            'selected-patient-email'
        ).textContent = '';


        document.getElementById(
            'selected-patient-conditions'
        ).textContent = 'None recorded';


        document.getElementById(
            'selected-patient-allergies'
        ).textContent = 'None recorded';


        document.getElementById(
            'selected-patient-medication'
        ).textContent = 'None recorded';

    }


    function appendPatientHistory(elementId, value) {

        const element =
            document.getElementById(elementId);

        const currentValue =
            element.textContent.trim();

        if (!value || currentValue === value) {
            return;
        }

        element.textContent =
            currentValue === 'None recorded'
                ? value
                : `${currentValue}, ${value}`;

    }


    // ================================================================
    // SELECT PATIENT FROM TABLE
    // ================================================================

    function selectPatientFromTable(saIdNumber) {

        const select =
            document.getElementById('doc-pat-id');


        select.value = saIdNumber;


        loadSelectedPatientSummary();

    }


    // ================================================================
    // CONDITION CATEGORIES
    // ================================================================

    async function loadConditionCategories() {

        const select =
            document.getElementById(
                'doc-pat-condition-category'
            );


        try {

            const response =
                await fetch(
                    doctorUrls.getConditionCategories
                );


            if (!response.ok) {

                throw new Error(
                    'Unable to load condition categories.'
                );

