    // ================================================================
    // CREATE PILL
    // ================================================================

    function addPill(
        containerId,
        text,
        relationshipId,
        type
    ) {

        const container =
            document.getElementById(containerId);


        // Prevent duplicate display

        const existing =
            Array.from(
                container.children
            ).some(
                pill =>
                    pill.dataset.value === text
            );


        if (existing) {

            return;

        }


        const pill =
            document.createElement('span');


        pill.className = 'pill';


        pill.dataset.value =
            text;


        pill.dataset.id =
            relationshipId;


        pill.textContent =
            text;


        const closeButton =
            document.createElement('button');


        closeButton.type =
            'button';


        closeButton.className =
            'pill-close';


        closeButton.textContent =
            '×';


        closeButton.addEventListener(
            'click',
            function () {

                if (type === 'condition') {

                    deletePatientCondition(
                        relationshipId,
                        pill
                    );

                }

                else if (type === 'allergy') {

                    deletePatientAllergy(
                        relationshipId,
                        pill
                    );

                }

                else if (type === 'medication') {

                    deletePatientMedication(
                        relationshipId,
                        pill
                    );

                }

            }
        );


        pill.appendChild(
            closeButton
        );


        container.appendChild(
            pill
        );

    }


