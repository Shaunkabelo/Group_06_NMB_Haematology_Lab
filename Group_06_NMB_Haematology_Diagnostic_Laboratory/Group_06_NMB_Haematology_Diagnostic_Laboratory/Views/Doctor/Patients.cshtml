    // ================================================================
    // MEDICATION CATEGORIES
    // ================================================================

    async function loadMedicationCategories() {

        const select =
            document.getElementById(
                'doc-pat-medication-category'
            );


        try {

            const response =
                await fetch(
                    doctorUrls.getMedicationCategories
                );


            if (!response.ok) {

                throw new Error(
                    'Unable to load medication categories.'
                );

            }


            const categories =
                await response.json();


            select.innerHTML = `
                <option value="">
                    -- Select Category --
                </option>
            `;


            const uniqueCategories =
                [...new Map(
                    categories.map(item => [
                        item.category,
                        item
                    ])
                ).values()];


            uniqueCategories.forEach(item => {

                const option =
                    document.createElement('option');


                option.value =
                    item.category;


                option.textContent =
                    item.category;


                select.appendChild(option);

            });

        }
        catch (error) {

            console.error(error);

            toast(
                'Unable to load medication categories.'
            );

        }

    }


    // ================================================================
    // MEDICATION BY CATEGORY
    // ================================================================

    async function populateMedicationNames() {

        const category =
            document.getElementById(
                'doc-pat-medication-category'
            ).value;


        const nameSelect =
            document.getElementById(
                'doc-pat-medication-name'
            );


        nameSelect.innerHTML = `
            <option value="">
                -- Select Medication --
            </option>
        `;


        nameSelect.disabled = true;


        if (!category) {

            return;

        }


        try {

            const response =
                await fetch(
                    `${doctorUrls.getMedicationsByCategory}?category=${encodeURIComponent(category)}`
                );


            if (!response.ok) {

                throw new Error(
                    'Unable to load medications.'
                );

            }


            const medications =
                await response.json();


            medications.forEach(medication => {

                const option =
                    document.createElement('option');


                option.value =
                    medication.medicationId;


                option.textContent =
                    medication.medicationName;


                nameSelect.appendChild(option);

            });


            nameSelect.disabled =
                medications.length === 0;

        }
        catch (error) {

            console.error(error);

            toast(
                'Unable to load medications.'
            );

        }

    }


