</div>

<script>
        async function viewPatientFromTable(button) {

        const saIdNumber =
            button.dataset.saId;

        if (!saIdNumber) {

            toast(
                'Patient SA ID number was not found.'
            );

            return;
        }


        const originalText =
            button.textContent;


        try {

            // ==============================================
            // BUTTON LOADING STATE
            // ==============================================

            button.disabled = true;

            button.textContent =
                'Loading...';


            // ==============================================
            // GET COMPLETE PATIENT
            // ==============================================

            const response =
                await fetch(
                    `${doctorUrls.getPatient}?saIdNumber=${encodeURIComponent(saIdNumber)}`
                );


            if (!response.ok) {

                throw new Error(
                    'Unable to load patient details.'
                );
            }


            const patient =
                await response.json();


            // ==============================================
            // UPDATE SELECTED PATIENT
            // ==============================================

            selectedPatient =
                patient;


            const select =
                document.getElementById(
                    'doc-pat-id'
                );

            select.value =
                saIdNumber;


            // ==============================================
            // DISPLAY PATIENT INFORMATION ABOVE
            // ==============================================

            displayPatientDetails(
                patient
            );


            document.getElementById(
                'selected-patient-summary'
            ).style.display =
                'block';


            // ==============================================
            // FIND TABLE ROW
            // ==============================================

            const row =
                button.closest('tr');


            if (!row) {

                throw new Error(
                    'Patient table row was not found.'
                );
            }


            // ==============================================
            // CONDITIONS
            // ==============================================

            const conditions =
                patient.knownMedicalConditions ||
                patient.medicalConditions ||
                patient.conditions ||
                'None recorded';


            row.querySelector(
                '.patient-conditions'
            ).innerHTML = `

                <span class="medical-cell">
                    ${escapeHtml(conditions)}
                </span>
            `;


            // ==============================================
            // ALLERGIES
            // ==============================================

            const allergies =
                patient.allergies ||
                'None recorded';


            row.querySelector(
                '.patient-allergies'
            ).innerHTML = `

                <span class="medical-cell">
                    ${escapeHtml(allergies)}
                </span>
            `;


            // ==============================================
            // MEDICATION
            // ==============================================

            const medication =
                patient.medication ||
                patient.medications ||
                'None recorded';


            row.querySelector(
                '.patient-medication'
            ).innerHTML = `

                <span class="medical-cell">
                    ${escapeHtml(medication)}
                </span>
            `;


            // Scroll patient details into view
            document.getElementById(
                'selected-patient-summary'
            ).scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });

        }
        catch (error) {

            console.error(error);

            toast(
                error.message ||
                'Unable to load patient details.'
            );

        }
        finally {

            button.disabled =
                false;

            button.textContent =
                originalText;
        }
    }

    // ================================================================
    // CONTROLLER URLS
    // ================================================================

    const doctorUrls = {

        getPatients:
            '@Url.Action("GetPatients", "Doctor")',

        getPatient:
            '@Url.Action("GetPatient", "Doctor")',

        getConditionCategories:
            '@Url.Action("GetConditionCategories", "Doctor")',

        getConditionsByCategory:
            '@Url.Action("GetConditionsByCategory", "Doctor")',

        addPatientCondition:
            '@Url.Action("AddPatientCondition", "Doctor")',

        deletePatientCondition:
            '@Url.Action("DeletePatientCondition", "Doctor")',

        getAllergyCategories:
            '@Url.Action("GetAllergyCategories", "Doctor")',

        getAllergiesByCategory:
            '@Url.Action("GetAllergiesByCategory", "Doctor")',

        addPatientAllergy:
            '@Url.Action("AddPatientAllergy", "Doctor")',

        deletePatientAllergy:
            '@Url.Action("DeletePatientAllergy", "Doctor")',

        getMedicationCategories:
            '@Url.Action("GetMedicationCategories", "Doctor")',

        getMedicationsByCategory:
            '@Url.Action("GetMedicationsByCategory", "Doctor")',

        addPatientMedication:
            '@Url.Action("AddPatientMedication", "Doctor")',

        deletePatientMedication:
            '@Url.Action("DeletePatientMedication", "Doctor")'

    };


    // ================================================================
    // GLOBAL STATE
    // ================================================================

    let selectedPatient = null;


    // ================================================================
    // TOAST / MESSAGE
    // ================================================================

    function toast(message) {

        alert(message);

    }


    // ================================================================
    // LOAD PATIENTS
    // ================================================================

        async function loadPatients() {

        const select =
            document.getElementById('doc-pat-id');

        const tbody =
            document.getElementById('doctor-patients-tbody');

        try {

            const response =
                await fetch(doctorUrls.getPatients);

            if (!response.ok) {

                throw new Error(
                    'Unable to load patients.'
                );
            }

            const patients =
                await response.json();


            // Reset patient dropdown
            select.innerHTML = `
                <option value="">
                    -- Select patient SA ID --
                </option>
            `;


            // Reset table
            tbody.innerHTML = '';


            if (!patients || patients.length === 0) {

                tbody.innerHTML = `
                    <tr>
                        <td colspan="6">
                            No patients found.
                        </td>
                    </tr>
                `;

                return;
            }


            patients.forEach(patient => {

                // ==============================================
                // ADD PATIENT TO SA ID DROPDOWN
                // ==============================================

                const option =
                    document.createElement('option');

                option.value =
                    patient.saIdNumber;

                option.textContent =
                    patient.saIdNumber;

                select.appendChild(option);


                // ==============================================
                // CREATE PATIENT TABLE ROW
                // ==============================================

                const row =
                    document.createElement('tr');

                row.id =
                    `patient-row-${patient.patientId}`;


                row.innerHTML = `

                    <td data-label="ID Number">
                        ${escapeHtml(
                            patient.saIdNumber || 'N/A'
                        )}
                    </td>


                    <td data-label="Physical Address">
                        ${escapeHtml(
                            patient.address ||
                            patient.homeAddress ||
                            'N/A'
                        )}
                    </td>


                    <td data-label="Conditions"
                        class="patient-conditions">

                        <span class="medical-empty">
                            Click View
                        </span>

                    </td>


                    <td data-label="Allergies"
                        class="patient-allergies">

                        <span class="medical-empty">
                            Click View
                        </span>

                    </td>


                    <td data-label="Medication"
                        class="patient-medication">

                        <span class="medical-empty">
                            Click View
                        </span>

                    </td>


                    <td data-label="Action">

                        <button
                            type="button"
                            class="btn btn-primary patient-view-btn"
                            data-sa-id="${escapeHtml(
                                patient.saIdNumber || ''
                            )}"
                            onclick="viewPatientFromTable(this)">

                            View

                        </button>

                    </td>
                `;


                tbody.appendChild(row);
            });

        }
        catch (error) {

            console.error(
                'loadPatients error:',
                error
            );


            tbody.innerHTML = `
                <tr>
                    <td colspan="6">
                        Unable to load patients.
                    </td>
                </tr>
            `;


            toast(
                'Unable to load patients from the database.'
            );
        }
    }


    // ================================================================
    // SELECT PATIENT
    // ================================================================

    async function loadSelectedPatientSummary() {

        const saIdNumber =
            document.getElementById('doc-pat-id').value;


        const panel =
            document.getElementById(
                'selected-patient-summary'
            );


        if (!saIdNumber) {

            selectedPatient = null;

            panel.style.display = 'none';

            clearPatientDetails();

            return;

        }


        try {

            const response =
                await fetch(
                    `${doctorUrls.getPatient}?saIdNumber=${encodeURIComponent(saIdNumber)}`
                );


            if (!response.ok) {

                throw new Error(
                    'Patient could not be loaded.'
                );

            }


            const patient =
                await response.json();


            selectedPatient = patient;


            displayPatientDetails(patient);


            panel.style.display = 'block';


            clearMedicalHistoryPills();

        }
        catch (error) {

            console.error(error);

            selectedPatient = null;

            panel.style.display = 'none';

            toast(
                'Unable to load the selected patient.'
            );

        }

    }


    // ================================================================
    // DISPLAY PATIENT DETAILS
    // ================================================================

    function displayPatientDetails(patient) {

        document.getElementById(
            'selected-patient-name'
        ).textContent =
            `${patient.name || ''} ${patient.surname || ''}`.trim();


        document.getElementById(
            'selected-patient-id'
        ).textContent =
            patient.saIdNumber || 'N/A';


        document.getElementById(
            'selected-patient-dob'
        ).textContent =
            formatDate(patient.dateOfBirth);


        document.getElementById(
            'selected-patient-address'
        ).textContent =
            patient.address ||
            patient.homeAddress ||
            'N/A';


        document.getElementById(
            'selected-patient-contact'
        ).textContent =
            patient.contactNumber ||
            patient.cellphone ||
            'N/A';


        document.getElementById(
            'selected-patient-email'
        ).textContent =
            patient.email ||
            patient.Email ||
            'N/A';

    }


    // ================================================================
    // CLEAR PATIENT DETAILS
    // ================================================================

    function clearPatientDetails() {

        document.getElementById(
            'selected-patient-name'
        ).textContent = '';


        document.getElementById(
            'selected-patient-id'
        ).textContent = '';


        document.getElementById(
            'selected-patient-dob'
        ).textContent = '';


        document.getElementById(
            'selected-patient-address'
        ).textContent = '';


        document.getElementById(
            'selected-patient-contact'
        ).textContent = '';


        document.getElementById(
            'selected-patient-email'
        ).textContent = '';

    }


    // ================================================================
    // SELECT PATIENT FROM TABLE
    // ================================================================

    function selectPatientFromTable(saIdNumber) {

        const select =
            document.getElementById('doc-pat-id');


        select.value = saIdNumber;


        loadSelectedPatientSummary();

    }


    // ================================================================
    // CONDITION CATEGORIES
    // ================================================================

    async function loadConditionCategories() {

        const select =
            document.getElementById(
                'doc-pat-condition-category'
            );


        try {

            const response =
                await fetch(
                    doctorUrls.getConditionCategories
                );


            if (!response.ok) {

                throw new Error(
                    'Unable to load condition categories.'
                );

            }


            const categories =
                await response.json();


            select.innerHTML = `
                <option value="">
                    -- Select Category --
                </option>
            `;


            const uniqueCategories =
                [...new Map(
                    categories.map(item => [
                        item.category,
                        item
                    ])
                ).values()];


            uniqueCategories.forEach(item => {

                const option =
                    document.createElement('option');


                option.value =
                    item.category;


                option.textContent =
                    item.category;


                select.appendChild(option);

            });

        }
        catch (error) {

            console.error(error);

            toast(
                'Unable to load medical condition categories.'
            );

        }

    }


    // ================================================================
    // CONDITIONS BY CATEGORY
    // ================================================================

    async function populateConditionNames() {

        const category =
            document.getElementById(
                'doc-pat-condition-category'
            ).value;


        const nameSelect =
            document.getElementById(
                'doc-pat-condition-name'
            );


        nameSelect.innerHTML = `
            <option value="">
                -- Select Condition --
            </option>
        `;


        nameSelect.disabled = true;


        if (!category) {

            return;

        }


        try {

            const response =
                await fetch(
                    `${doctorUrls.getConditionsByCategory}?category=${encodeURIComponent(category)}`
                );


            if (!response.ok) {

                throw new Error(
                    'Unable to load conditions.'
                );

            }


            const conditions =
                await response.json();


            conditions.forEach(condition => {

                const option =
                    document.createElement('option');


                option.value =
                    condition.medicalConditionId;


                option.textContent =
                    condition.conditionName;


                nameSelect.appendChild(option);

            });


            nameSelect.disabled =
                conditions.length === 0;

        }
        catch (error) {

            console.error(error);

            toast(
                'Unable to load medical conditions.'
            );

        }

    }


    // ================================================================
    // ADD PATIENT CONDITION
    // ================================================================

    async function addPatientCondition() {

        if (!selectedPatient) {

            toast(
                'Please select a patient first.'
            );

            return;

        }


        const conditionId =
            document.getElementById(
                'doc-pat-condition-name'
            ).value;


        const conditionSelect =
            document.getElementById(
                'doc-pat-condition-name'
            );


        const conditionName =
            conditionSelect.options[
                conditionSelect.selectedIndex
            ]?.textContent;


        if (!conditionId) {

            toast(
                'Please select a medical condition.'
            );

            return;

        }


        try {

            const body =
                new URLSearchParams();


            body.append(
                'patientId',
                selectedPatient.patientId
            );


            body.append(
                'medicalConditionId',
                conditionId
            );


            const response =
                await fetch(
                    doctorUrls.addPatientCondition,
                    {
                        method: 'POST',
                        headers: {
                            'Content-Type':
                                'application/x-www-form-urlencoded'
                        },
                        body: body.toString()
                    }
                );


            const result =
                await response.json();


            if (!response.ok || !result.success) {

                throw new Error(
                    result.message ||
                    'Unable to add condition.'
                );

            }


            addPill(
                'condition-pills',
                conditionName,
                result.patientConditionId,
                'condition'
            );


            toast(
                result.message ||
                'Medical condition added successfully.'
            );

        }
        catch (error) {

            console.error(error);

            toast(
                error.message ||
                'Unable to add medical condition.'
            );

        }

    }


    // ================================================================
    // DELETE PATIENT CONDITION
    // ================================================================

    async function deletePatientCondition(
        patientConditionId,
        pill
    ) {

        if (!confirm(
            'Are you sure you want to remove this medical condition?'
        )) {

            return;

        }


        try {

            const body =
                new URLSearchParams();


            body.append(
                'patientConditionId',
                patientConditionId
            );


            const response =
                await fetch(
                    doctorUrls.deletePatientCondition,
                    {
                        method: 'POST',
                        headers: {
                            'Content-Type':
                                'application/x-www-form-urlencoded'
                        },
                        body: body.toString()
                    }
                );


            const result =
                await response.json();


            if (!response.ok || !result.success) {

                throw new Error(
                    result.message ||
                    'Unable to remove condition.'
                );

            }


            pill.remove();


            toast(
                result.message ||
                'Medical condition removed successfully.'
            );

        }
        catch (error) {

            console.error(error);

            toast(
                error.message ||
                'Unable to remove medical condition.'
            );

        }

    }


