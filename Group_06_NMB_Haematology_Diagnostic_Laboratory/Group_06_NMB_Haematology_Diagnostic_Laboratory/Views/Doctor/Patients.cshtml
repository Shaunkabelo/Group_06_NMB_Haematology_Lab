    // ================================================================

    async function refreshPatientData() {

        const selectedSaId = selectedPatient
            ? selectedPatient.saIdNumber
            : null;

        await loadPatients();

        await loadConditionCategories();

        await loadAllergyCategories();

        await loadMedicationCategories();


        if (selectedSaId) {

            document.getElementById(
                'doc-pat-id'
            ).value = selectedSaId;


            await loadSelectedPatientSummary();

        }


        toast(
            'Patient data refreshed.'
        );

    }


    // ================================================================
    // DATE FORMATTER
    // ================================================================

    function formatDate(value) {

        if (!value) {

            return 'N/A';

        }


        const date =
            new Date(value);


        if (isNaN(date.getTime())) {

            return value;

        }


        return date.toLocaleDateString();

    }


    // ================================================================
    // HTML ENCODING
    // ================================================================

    function escapeHtml(value) {

        if (value === null ||
            value === undefined) {

            return '';

        }


        return String(value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');

    }


