    // ================================================================
    // ADD PATIENT ALLERGY
    // ================================================================

    async function addPatientAllergy() {

        if (!selectedPatient) {

            toast(
                'Please select a patient first.'
            );

            return;

        }


        const allergySelect =
            document.getElementById(
                'doc-pat-allergy-name'
            );


        const allergyId =
            allergySelect.value;


        const allergyName =
            allergySelect.options[
                allergySelect.selectedIndex
            ]?.textContent;


        if (!allergyId) {

            toast(
                'Please select an allergy.'
            );

            return;

        }


        try {

