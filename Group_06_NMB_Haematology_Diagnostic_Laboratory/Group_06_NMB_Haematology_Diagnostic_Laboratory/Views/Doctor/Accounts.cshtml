@{
    ViewData["Title"] = "Doctor Account";
    Layout = "~/Views/Shared/_LayoutDoctor.cshtml";
}


<div class="page-body">
    <div class="section-header">
        <div class="section-title">Doctor Profile</div>
        <div class="section-sub">Manage your profile, security settings, and notification preferences.</div>
    </div>

    <section class="card account-panel profile-panel">
        <div class="card-header">
            <span class="card-title">Personal information</span>
        </div>
        <div class="card-body">
            <div class="profile-summary">
                <div class="profile-avatar" id="doctor-profile-avatar" aria-hidden="true">DR</div>
                <div>
                    <h2 id="doctor-profile-name">Loading...</h2>
                    <p id="doctor-profile-role">Loading...</p>
                </div>
            </div>

            <form class="account-form" onsubmit="saveDoctorProfile(event)">
                <div id="account-profile-message" class="auth-message" hidden></div>
                <div class="profile-form-grid">
                    <div class="form-group">
                        <label class="form-label" for="doctor-account-name">Name</label>
                        <input class="form-control" id="doctor-account-name" type="text" autocomplete="given-name" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="doctor-account-surname">Surname</label>
                        <input class="form-control" id="doctor-account-surname" type="text" autocomplete="family-name" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="doctor-account-email">Email address</label>
                        <input class="form-control" id="doctor-account-email" type="email" autocomplete="email" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="doctor-account-phone">Contact number</label>
                        <input class="form-control" id="doctor-account-phone" type="tel" autocomplete="tel">
                    </div>
                </div>
                <div class="profile-readonly-grid">
                    <div class="profile-info-item">
                        <span>Role</span>
                        <strong id="doctor-info-role">-</strong>
                    </div>
                    <div class="profile-info-item">
                        <span>HPCSA Number</span>
                        <strong id="doctor-info-hpcsa">-</strong>
                    </div>
                </div>
                <div class="btn-row">
                    <button class="btn btn-primary" type="submit">Save profile</button>
                    <button class="btn btn-secondary" type="reset" onclick="loadDoctorProfile()">Cancel</button>
                </div>
            </form>
        </div>
    </section>

    <section class="card account-panel">
        <div class="card-header">
            <span class="card-title">Notification preferences</span>
        </div>
        <div class="card-body">
            <div id="account-notification-message" class="auth-message" hidden></div>
            <div class="preference-list">
                <label class="preference-row">
                    <span>
                        <strong>Result notifications</strong>
                        <small>Receive an alert when laboratory results are ready for review.</small>
                    </span>
                    <input id="preference-results" type="checkbox">
                </label>
                <label class="preference-row">
                    <span>
                        <strong>Urgent request notifications</strong>
                        <small>Be notified when an urgent test request needs attention.</small>
                    </span>
                    <input id="preference-urgent" type="checkbox">
                </label>
                <label class="preference-row">
                    <span>
                        <strong>Weekly activity summary</strong>
                        <small>Receive a weekly overview of requests, results, and alerts.</small>
                    </span>
                    <input id="preference-summary" type="checkbox">
                </label>
            </div>
            <div class="btn-row">
                <button class="btn btn-primary" type="button" onclick="saveDoctorPreferences()">Save preferences</button>
            </div>
        </div>
    </section>

    <section class="card account-panel">
        <div class="card-header">
            <span class="card-title">Change Password</span>
        </div>
        <div class="card-body">
            <form class="account-form" onsubmit="changeLoggedInDoctorPassword(event)">
                <div id="account-password-message" class="auth-message" hidden></div>

                <div class="form-group">
                    <label class="form-label" for="doctor-current-password">Current Password</label>
                    <div class="password-field">
                        <input class="form-control" id="doctor-current-password" type="password" autocomplete="current-password" required>
                        <button class="btn btn-secondary" type="button" onclick="togglePassword('doctor-current-password', this)">Show</button>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="doctor-account-new-password">New Password</label>
                        <div class="password-field">
                            <input class="form-control" id="doctor-account-new-password" type="password" autocomplete="new-password" required>
                            <button class="btn btn-secondary" type="button" onclick="togglePassword('doctor-account-new-password', this)">Show</button>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="doctor-account-confirm-password">Confirm Password</label>
                        <div class="password-field">
                            <input class="form-control" id="doctor-account-confirm-password" type="password" autocomplete="new-password" required>
                            <button class="btn btn-secondary" type="button" onclick="togglePassword('doctor-account-confirm-password', this)">Show</button>
                        </div>
                    </div>
                </div>

                <div class="login-hint">
                    Password rules: minimum 8 characters, 1 uppercase letter, 1 number, and 1 special character.
                </div>

                <div class="btn-row">
                    <button class="btn btn-primary" type="submit">Update password</button>
                    <button class="btn btn-secondary" type="reset" onclick="clearInlineMessage('account-password-message')">Clear</button>
                </div>
            </form>
        </div>
    </section>
</div>

<script>
    const getDoctorAccountUrl =
        '@Url.Action("GetDoctorAccount", "Doctor")';

    const updateDoctorAccountUrl =
        '@Url.Action("UpdateDoctorAccount", "Doctor")';

    const changeDoctorPasswordUrl =
        '@Url.Action("ChangeDoctorPassword", "Doctor")';

    const doctorPreferencesStorageKey =
        'doctorPreferences';


    function showAccountMessage(elementId, message, type) {
        const messageElement =
            document.getElementById(elementId);

        if (!messageElement) {
            return;
        }

        messageElement.textContent = message;
        messageElement.className = 'auth-message ' + type;
        messageElement.hidden = false;
    }


    function clearInlineMessage(elementId) {
        const messageElement =
            document.getElementById(elementId);

        if (!messageElement) {
            return;
        }

        messageElement.textContent = '';
        messageElement.className = 'auth-message';
        messageElement.hidden = true;
    }


    function getDoctorInitials(name, surname) {
        const firstInitial =
            name ? name.charAt(0) : '';

        const secondInitial =
            surname ? surname.charAt(0) : '';

        const initials =
            (firstInitial + secondInitial).toUpperCase();

        return initials || 'DR';
    }


    async function loadDoctorProfile() {
        clearInlineMessage('account-profile-message');

        try {
            const response =
                await fetch(
                    getDoctorAccountUrl,
                    {
                        method: 'GET',
                        headers: {
                            'Accept': 'application/json'
                        }
                    }
                );

            const data =
                await response.json();

            if (!response.ok) {
                throw new Error(
                    data.message ||
                    'Could not load doctor profile.'
                );
            }

            const name =
                data.name ?? data.Name ?? '';

            const surname =
                data.surname ?? data.Surname ?? '';

            const email =
                data.email ?? data.Email ?? '';

            const cellphone =
                data.cellphone ?? data.Cellphone ?? '';

            const role =
                data.role ?? data.Role ?? '';

            const hpcsaNumber =
                data.hpcsaNumber ??
                data.HpcsaNumber ??
                '';

            document.getElementById(
                'doctor-account-name'
            ).value = name;

            document.getElementById(
                'doctor-account-surname'
            ).value = surname;

            document.getElementById(
                'doctor-account-email'
            ).value = email;

            document.getElementById(
                'doctor-account-phone'
            ).value = cellphone;

            const fullName =
                (name + ' ' + surname).trim();

            document.getElementById(
                'doctor-profile-name'
            ).textContent =
                fullName
                    ? 'Dr. ' + fullName
                    : 'Doctor';

            document.getElementById(
                'doctor-profile-role'
            ).textContent =
                role || '-';

            document.getElementById(
                'doctor-info-role'
            ).textContent =
                role || '-';

            document.getElementById(
                'doctor-info-hpcsa'
            ).textContent =
                hpcsaNumber || '-';

            document.getElementById(
                'doctor-profile-avatar'
            ).textContent =
                getDoctorInitials(
                    name,
                    surname
                );
        }
        catch (error) {
            console.error(
                'Doctor profile load error:',
                error
            );

            showAccountMessage(
                'account-profile-message',
                error.message ||
                'Could not load doctor profile.',
                'error'
            );
        }
    }


    async function saveDoctorProfile(event) {
        event.preventDefault();

        clearInlineMessage(
            'account-profile-message'
        );

        const model = {
            name:
                document.getElementById(
                    'doctor-account-name'
                ).value.trim(),

            surname:
                document.getElementById(
                    'doctor-account-surname'
                ).value.trim(),

            email:
                document.getElementById(
                    'doctor-account-email'
                ).value.trim(),

            cellphone:
                document.getElementById(
                    'doctor-account-phone'
                ).value.trim()
        };

        try {
            const response =
                await fetch(
                    updateDoctorAccountUrl,
                    {
                        method: 'POST',
                        headers: {
                            'Content-Type':
                                'application/json'
                        },
                        body:
                            JSON.stringify(model)
                    }
                );

            const result =
                await response.json();

            if (!response.ok) {
                throw new Error(
                    result.message ||
                    'Could not update profile.'
                );
            }

            showAccountMessage(
                'account-profile-message',
                result.message ||
                'Profile updated successfully.',
                'success'
            );

            await loadDoctorProfile();
        }
        catch (error) {
            console.error(
                'Doctor profile update error:',
                error
            );

            showAccountMessage(
                'account-profile-message',
                error.message ||
                'Could not update profile.',
                'error'
            );
        }
    }


    function loadDoctorPreferences() {
        let preferences = null;

        try {
            preferences =
                JSON.parse(
                    localStorage.getItem(
                        doctorPreferencesStorageKey
                    )
                );
        }
        catch {
            preferences = null;
        }

        if (!preferences) {
            preferences = {
                results: false,
                urgent: false,
                summary: false
            };
        }

        document.getElementById(
            'preference-results'
        ).checked =
            Boolean(preferences.results);

        document.getElementById(
            'preference-urgent'
        ).checked =
            Boolean(preferences.urgent);

        document.getElementById(
            'preference-summary'
        ).checked =
            Boolean(preferences.summary);
    }


    function saveDoctorPreferences() {
        const preferences = {
            results:
                document.getElementById(
                    'preference-results'
                ).checked,

            urgent:
                document.getElementById(
                    'preference-urgent'
                ).checked,

            summary:
                document.getElementById(
                    'preference-summary'
                ).checked
        };

        localStorage.setItem(
            doctorPreferencesStorageKey,
            JSON.stringify(preferences)
        );

        showAccountMessage(
            'account-notification-message',
            'Notification preferences have been saved.',
            'success'
        );
    }


    async function changeLoggedInDoctorPassword(event) {
        event.preventDefault();

        clearInlineMessage(
            'account-password-message'
        );

        const currentPassword =
            document.getElementById(
                'doctor-current-password'
            ).value;

        const newPassword =
            document.getElementById(
                'doctor-account-new-password'
            ).value;

        const confirmPassword =
            document.getElementById(
                'doctor-account-confirm-password'
            ).value;

        if (newPassword !== confirmPassword) {
            showAccountMessage(
                'account-password-message',
                'New password and confirm password do not match.',
                'error'
            );

            return;
        }

        const passwordPattern =
            /^(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).{8,}$/;

        if (!passwordPattern.test(newPassword)) {
            showAccountMessage(
                'account-password-message',
                'Password must contain at least 8 characters, 1 uppercase letter, 1 number, and 1 special character.',
                'error'
            );

            return;
        }

        const model = {
            currentPassword:
                currentPassword,

            newPassword:
                newPassword,

            confirmPassword:
                confirmPassword
        };

        try {
            const response =
                await fetch(
                    changeDoctorPasswordUrl,
                    {
                        method: 'POST',
                        headers: {
                            'Content-Type':
                                'application/json'
                        },
                        body:
                            JSON.stringify(model)
                    }
                );

            const result =
                await response.json();

            if (!response.ok) {
                throw new Error(
                    result.message ||
                    'Could not update password.'
                );
            }

            showAccountMessage(
                'account-password-message',
                result.message ||
                'Password updated successfully.',
                'success'
            );

            document.getElementById(
                'doctor-current-password'
            ).value = '';

            document.getElementById(
                'doctor-account-new-password'
            ).value = '';

            document.getElementById(
                'doctor-account-confirm-password'
            ).value = '';
        }
        catch (error) {
            console.error(
                'Password update error:',
                error
            );

            showAccountMessage(
                'account-password-message',
                error.message ||
                'Could not update password.',
                'error'
            );
        }
    }


    function togglePassword(inputId, button) {
        const input =
            document.getElementById(inputId);

        if (!input) {
            return;
        }

        if (input.type === 'password') {
            input.type = 'text';
            button.textContent = 'Hide';
        }
        else {
            input.type = 'password';
            button.textContent = 'Show';
        }
    }


    document.addEventListener(
        'DOMContentLoaded',
        function () {
            loadDoctorProfile();
            loadDoctorPreferences();
        }
    );
</script>
