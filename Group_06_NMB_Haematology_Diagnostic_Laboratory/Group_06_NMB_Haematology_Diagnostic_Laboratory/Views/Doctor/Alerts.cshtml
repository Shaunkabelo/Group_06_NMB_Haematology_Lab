@{
    ViewData["Title"] = "Doctor Alerts";
    Layout = "~/Views/Shared/_LayoutDoctor.cshtml";
}

<div class="page-body doctor-alerts-page">
    <div class="section-header">
        <div class="section-title alert-page-title">Abnormal Results Alerts</div>
        <div class="section-sub">Review abnormal test results</div>
    </div>

    <section class="alerts-filter-panel">
        <div class="alerts-filter-controls">
            <div class="alerts-date-field">
                <span class="date-icon">From</span>
                <input id="alerts-start-date" class="alerts-date-input" type="date" aria-label="Alert start date" />
            </div>
            <div class="alerts-date-field">
                <span class="date-icon">To</span>
                <input id="alerts-end-date" class="alerts-date-input" type="date" aria-label="Alert end date" />
            </div>
            <button id="alerts-apply-btn" class="btn btn-primary" type="button" onclick="renderAlerts()">Apply</button>
        </div>
        <div id="alerts-range-note" class="alerts-range-note">Showing alerts from last 5 days</div>
    </section>

    <section class="alerts-priority-grid">
        <div class="priority-tile abnormal"><div>Abnormal</div><strong id="alerts-abnormal-count">0</strong></div>
        <div class="priority-tile urgent"><div>Urgent</div><strong id="alerts-urgent-count">0</strong></div>
        <div class="priority-tile routine"><div>Routine</div><strong id="alerts-routine-count">0</strong></div>
        <div class="priority-tile stat"><div>STAT</div><strong id="alerts-stat-count">0</strong></div>
    </section>

    <section id="alerts-empty-panel" class="alerts-empty-panel" hidden>
        <div class="alerts-empty-icon">!</div>
        <div id="alerts-empty-text" class="alerts-empty-text" role="status">No abnormal results were found for the selected period.</div>
    </section>

    <section id="alerts-table-panel" class="alerts-table-panel">
        <div class="table-wrap" style="overflow-x:auto;">
            <table class="alerts-table">
                <thead>
                    <tr><th>Date</th><th>Patient</th><th>Test</th><th>Flag</th></tr>
                </thead>
                <tbody id="alerts-tbody">
                    <tr><td colspan="4">Loading abnormal results...</td></tr>
                </tbody>
            </table>
        </div>
    </section>
</div>

<style>
    .doctor-alerts-page .alerts-table {
        width: 100%;
    }

    .doctor-alerts-page .alert-row {
        cursor: pointer;
    }

        .doctor-alerts-page .alert-row:hover {
            background: #f2f7fb;
        }

        .doctor-alerts-page .alert-row:focus-visible {
            outline: 2px solid #2563eb;
            outline-offset: -2px;
        }

    .doctor-alerts-page .alerts-filter-controls {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: end;
    }

    .doctor-alerts-page .alerts-date-field {
        min-width: 0;
    }

    @@media (max-width: 640px) {
        .doctor-alerts-page .alerts-filter-controls {
            align-items: stretch;
        }

        .doctor-alerts-page .alerts-date-field {
            flex: 1 1 130px;
        }

        .doctor-alerts-page .alerts-date-input {
            max-width: 100%;
            width: 100%;
        }

        .doctor-alerts-page .alerts-filter-controls .btn {
            flex: 1 1 100%;
        }

        .doctor-alerts-page .alerts-table {
            min-width: 520px;
        }
    }
</style>

<script>
    // Requires an authorized DoctorController.GetDoctorAlerts(startDate, endDate)
    // endpoint returning DoctorAlertDto JSON with camelCase property names.
    const alertsUrl = '@Url.Action("GetDoctorAlerts", "Doctor")';
    const requestDetailsUrl = '@Url.Action("RequestDetails", "Doctor")';
    let alertLoadVersion = 0;

    function addDays(date, days) {
        const next = new Date(date);
        next.setDate(next.getDate() + days);
        return next;
    }

    function toDateInputValue(date) {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
    }

    function formatDate(value) {
        if (!value) return 'Not available';
        const date = new Date(value);
        return Number.isNaN(date.getTime()) ? 'Not available' : date.toLocaleDateString();
    }

    function escapeHtml(value) {
        return String(value ?? '')
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#39;');
    }

    function getSelectedDateRange() {
        const today = new Date();
        const start = document.getElementById('alerts-start-date').value ||
            toDateInputValue(addDays(today, -5));
        const end = document.getElementById('alerts-end-date').value ||
            toDateInputValue(today);
        return { start, end };
    }

    function updatePriorityCounts(alerts) {
        const counts = { abnormal: alerts.length, urgent: 0, routine: 0, stat: 0 };
        for (const item of alerts) {
            const urgency = String(item.urgency ?? '').toLowerCase();
            if (urgency === 'urgent') counts.urgent++;
            else if (urgency === 'routine') counts.routine++;
            else if (urgency === 'stat') counts.stat++;
        }
        document.getElementById('alerts-abnormal-count').textContent = counts.abnormal;
        document.getElementById('alerts-urgent-count').textContent = counts.urgent;
        document.getElementById('alerts-routine-count').textContent = counts.routine;
        document.getElementById('alerts-stat-count').textContent = counts.stat;
    }

    function displayAlerts(alerts) {
        const tablePanel = document.getElementById('alerts-table-panel');
        const emptyPanel = document.getElementById('alerts-empty-panel');
        const tbody = document.getElementById('alerts-tbody');
        updatePriorityCounts(alerts);

        if (!alerts.length) {
            tablePanel.hidden = true;
            emptyPanel.hidden = false;
            document.getElementById('alerts-empty-text').textContent =
                'No abnormal results were found for the selected period.';
            tbody.innerHTML = '';
            return;
        }

        tablePanel.hidden = false;
        emptyPanel.hidden = true;
        tbody.innerHTML = alerts.map(item => {
            const id = Number(item.testRequestId);
            if (!Number.isSafeInteger(id) || id <= 0) return '';
            const urgency = String(item.urgency ?? '').toLowerCase();
            const badge = urgency === 'stat' ? 'red' : urgency === 'urgent' ? 'amber' : 'blue';
            return `
                <tr class="alert-row" tabindex="0" data-request-id="${id}"
                    aria-label="Open request ${id} details">
                    <td data-label="Date">${escapeHtml(formatDate(item.captureDateTime))}</td>
                    <td data-label="Patient">${escapeHtml(item.patientName)}</td>
                    <td data-label="Test">${escapeHtml(item.testName)}</td>
                    <td data-label="Flag"><span class="badge ${badge}">
                        Abnormal (${escapeHtml(item.urgency || 'Unspecified')})
                    </span></td>
                </tr>`;
        }).join('');
    }

    async function renderAlerts() {
        const version = ++alertLoadVersion;
        const { start, end } = getSelectedDateRange();
        const tablePanel = document.getElementById('alerts-table-panel');
        const emptyPanel = document.getElementById('alerts-empty-panel');
        const tbody = document.getElementById('alerts-tbody');
        const applyButton = document.getElementById('alerts-apply-btn');

        if (start > end) {
            document.getElementById('alerts-range-note').textContent =
                'Start date must be on or before end date.';
            return;
        }

        const today = new Date();
        const defaultStart = toDateInputValue(addDays(today, -5));
        const defaultEnd = toDateInputValue(today);
        document.getElementById('alerts-range-note').textContent =
            start === defaultStart && end === defaultEnd
                ? 'Showing alerts from last 5 days'
                : `Showing alerts from ${start} to ${end}`;

        applyButton.disabled = true;
        tablePanel.hidden = false;
        emptyPanel.hidden = true;
        tbody.innerHTML = '<tr><td colspan="4">Loading abnormal results...</td></tr>';

        try {
            const url = new URL(alertsUrl, window.location.origin);
            url.searchParams.set('startDate', start);
            url.searchParams.set('endDate', end);
            const response = await fetch(url, {
                credentials: 'same-origin',
                headers: { 'Accept': 'application/json' }
            });
            if (!response.ok) throw new Error(`Unable to load alerts (HTTP ${response.status}).`);
            const alerts = await response.json();
            if (!Array.isArray(alerts)) throw new Error('Invalid response from alerts endpoint.');
            if (version !== alertLoadVersion) return;
            displayAlerts(alerts.filter(item => item.isAbnormal === true));
        } catch (error) {
            if (version !== alertLoadVersion) return;
            console.error('Doctor alerts:', error);
            updatePriorityCounts([]);
            tbody.innerHTML = '';
            tablePanel.hidden = true;
            emptyPanel.hidden = false;
            document.getElementById('alerts-empty-text').textContent =
                'Unable to load alerts. Please try again.';
        } finally {
            if (version === alertLoadVersion) applyButton.disabled = false;
        }
    }

    function openAlertRequest(row) {
        const requestId = Number(row.dataset.requestId);
        if (!Number.isSafeInteger(requestId) || requestId <= 0) return;
        const url = new URL(requestDetailsUrl, window.location.origin);
        url.searchParams.set('id', String(requestId));
        window.location.assign(url.toString());
    }

    document.addEventListener('DOMContentLoaded', () => {
        const today = new Date();
        document.getElementById('alerts-start-date').value = toDateInputValue(addDays(today, -5));
        document.getElementById('alerts-end-date').value = toDateInputValue(today);
        const tbody = document.getElementById('alerts-tbody');
        tbody.addEventListener('click', event => {
            const row = event.target.closest('.alert-row');
            if (row) openAlertRequest(row);
        });
        tbody.addEventListener('keydown', event => {
            if (event.key !== 'Enter' && event.key !== ' ') return;
            const row = event.target.closest('.alert-row');
            if (!row) return;
            event.preventDefault();
            openAlertRequest(row);
        });
        renderAlerts();
    });
</script>
                                                              