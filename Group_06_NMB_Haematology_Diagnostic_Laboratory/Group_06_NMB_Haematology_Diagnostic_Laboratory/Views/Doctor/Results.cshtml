@{
    ViewData["Title"] = "Results";
    Layout = "~/Views/Shared/_LayoutDoctor.cshtml";
}

<div class="page-body">
    <div class="section-header">
        <div class="section-title">Review and Release Results</div>
        <div class="section-sub">Manage result cards, request patient appointments, and release completed reports.</div>
    </div>

    <div class="card" style="margin-bottom: 18px;">
        <div class="card-body" style="padding: 16px 24px; display: flex; flex-wrap: wrap; gap: 16px; align-items: center;">
            <div style="flex: 1 1 260px; min-width: 0;">
                <div class="form-label">Search</div>
                <input id="results-search" class="form-control" type="search" placeholder="Search by patient, test type, or request ID..." oninput="renderResultCards()" />
            </div>
            <div class="btn-row" style="justify-self: end; gap: 10px;">
                <button class="btn btn-secondary" type="button" onclick="renderResultCards(true)">Refresh</button>
            </div>
        </div>
    </div>

    <div id="results-list"></div>
</div>

<style>
    .modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(11, 25, 41, 0.58);
    }

        .modal-overlay.is-open {
            display: flex;
        }

    .modal-subtitle {
        display: block;
        margin-top: 4px;
        color: #7A8CA0;
        font-size: 12px;
        line-height: 1.4;
    }

    .release-description {
        margin: 0 0 18px;
        color: #4A5563;
        font-size: 13px;
        line-height: 1.55;
    }

    .release-options {
        display: grid;
        gap: 10px;
        margin: 0 0 18px;
        padding: 0;
        border: 0;
    }

        .release-options legend {
            width: 100%;
            margin-bottom: 8px;
        }

    .release-option {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 12px 14px;
        border: 1px solid #E3E8F0;
        border-radius: 8px;
        background: #FFFFFF;
        cursor: pointer;
        transition: border-color 0.2s ease, background 0.2s ease;
    }

        .release-option:hover,
        .release-option:has(input:checked) {
            border-color: #00A98D;
            background: #F2FCFA;
        }

        .release-option input {
            margin-top: 3px;
            accent-color: #00A98D;
        }

        .release-option strong,
        .release-option small {
            display: block;
        }

        .release-option strong {
            color: #1A2A3A;
            font-size: 13px;
        }

        .release-option small {
            margin-top: 3px;
            color: #7A8CA0;
            font-size: 12px;
            line-height: 1.4;
        }

    .form-label-hint {
        color: #7A8CA0;
        font-size: 11px;
        font-weight: 400;
    }

    .result-card {
        background: #FFFFFF;
        border-radius: 12px;
        box-shadow: 0 10px 28px rgba(15, 30, 60, 0.08);
        margin-bottom: 12px;
        overflow: hidden;
    }

    .result-card-header {
        padding: 16px 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

        .result-card-header h2 {
            margin: 0;
            font-size: 17px;
            font-weight: 700;
        }

    .result-card-summary {
        min-width: 0;
    }

        .result-card-summary h2 {
            overflow-wrap: anywhere;
        }

    .result-meta {
        color: #7A8CA0;
        font-size: 13px;
        line-height: 1.6;
    }

    .result-card:not(.expanded) .result-meta {
        display: none;
    }

    .result-card:not(.expanded) .result-warning,
    .result-card:not(.expanded) .result-card-body,
    .result-card:not(.expanded) .result-actions {
        display: none;
    }

    .result-status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

        .result-status .badge {
            padding: 6px 10px;
        }

    .result-warning {
        margin: 0 24px 18px;
        padding: 14px 18px;
        border-radius: 12px;
        background: #FFF4E6;
        color: #7A4E05;
        border: 1px solid rgba(245, 166, 35, 0.24);
        font-size: 14px;
    }

    .result-card-body {
        padding: 0 24px 22px;
    }

    .result-item {
        background: #FAFAFB;
        border-radius: 14px;
        padding: 18px 20px;
        margin-bottom: 16px;
    }

        .result-item:last-child {
            margin-bottom: 0;
        }

    .result-item-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
    }

        .result-item-title strong {
            font-size: 16px;
            font-weight: 700;
        }

    .result-item-details {
        display: grid;
        grid-template-columns: repeat(3, minmax(140px, 1fr));
        gap: 18px;
        margin-bottom: 16px;
    }

    .result-item-detail {
        font-size: 12px;
        color: #4A5563;
    }

        .result-item-detail strong {
            display: block;
            margin-bottom: 6px;
            color: #1A2A3A;
        }

    .result-note {
        color: #4A5563;
        font-size: 13px;
        line-height: 1.6;
    }

    .result-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin: 14px 24px 20px;
    }

        .result-actions .btn {
            min-width: 130px;
        }

        .result-actions .btn-primary {
            background: #1D5BFF;
        }

        .result-actions .btn-secondary {
            border-color: #E3E8F0;
            color: #516174;
        }

    .result-card-details[hidden] {
        display: none;
    }

    .result-toggle {
        min-width: 94px;
    }

    @@media (max-width: 640px) {
        .result-card-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .result-status {
            justify-content: flex-start;
            width: 100%;
        }

        .result-toggle {
            width: 100%;
        }
    }
</style>

<script>
    // Loads real laboratory results from the DoctorController endpoint.
    // Release and email operations remain unavailable until server-side workflows exist.
    const resultsUrl = '@Url.Action("GetDoctorResults", "Doctor")';
    const expandedResultCards = new Set();
    let resultRequests = [];

    function escapeHtml(value) {
        return String(value ?? '')
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#39;');
    }

    function formatDate(value) {
        if (!value) return 'Not available';
        const date = new Date(value);
        return Number.isNaN(date.getTime()) ? 'Not available' : date.toLocaleString();
    }

    function normalizeStatus(status) {
        const value = String(status || '').toLowerCase();
        if (value === 'released') return 'Released by doctor';
        return status || 'Unknown';
    }

    function groupResults(rows) {
        const requests = new Map();
        for (const row of rows) {
            const id = row.testRequestId;
            if (!requests.has(id)) {
                requests.set(id, {
                    id,
                    patientName: row.patientName,
                    createdAt: row.requestDate,
                    status: row.requestStatus,
                    urgency: row.urgency,
                    tests: []
                });
            }
            requests.get(id).tests.push({
                testName: row.testName,
                result: row.resultValue != null
                    ? String(row.resultValue)
                    : (row.resultText || 'Not recorded'),
                notes: row.notes || '',
                abnormal: row.isAbnormal === true,
                verificationStatus: row.verificationStatus || 'Not verified',
                reviewStatus: row.reviewStatus || 'Not reviewed',
                reviewNotes: row.reviewNotes || '',
                captureDateTime: row.captureDateTime
            });
        }
        return [...requests.values()];
    }

    async function loadDoctorResults() {
        const list = document.getElementById('results-list');
        list.innerHTML = '<div class="card"><div class="card-body">Loading results...</div></div>';
        try {
            const response = await fetch(resultsUrl, {
                credentials: 'same-origin',
                headers: { Accept: 'application/json' }
            });
            if (!response.ok || response.redirected) {
                throw new Error(response.status === 401 || response.redirected
                    ? 'Please sign in as a doctor to view results.'
                    : 'The server could not retrieve your results.');
            }
            const rows = await response.json();
            if (!Array.isArray(rows)) throw new Error('Unexpected response from server.');
            resultRequests = groupResults(rows);
            renderResultCards();
        } catch (error) {
            console.error('Doctor results:', error);
            list.textContent = error.message || 'Unable to load results.';
        }
    }

    function renderResultCards(forceRefresh = false) {
        if (forceRefresh) {
            loadDoctorResults();
            return;
        }
        const list = document.getElementById('results-list');
        const searchTerm = document.getElementById('results-search').value.toLowerCase().trim();
        const filtered = resultRequests.filter(item =>
            [item.patientName, item.id, item.status, ...item.tests.map(t => t.testName)]
                .some(value => String(value ?? '').toLowerCase().includes(searchTerm))
        );
        if (!filtered.length) {
            list.innerHTML = '<div class="card"><div class="card-body">No laboratory results found.</div></div>';
            return;
        }
        list.innerHTML = filtered.map(item => {
            const testsHtml = item.tests.map(test => `
                <div class="result-item">
                    <div class="result-item-title">
                        <strong>${escapeHtml(test.testName)}</strong>
                        <span class="badge ${test.abnormal ? 'red' : 'blue'}">
                            ${test.abnormal ? 'Abnormal' : 'Not flagged abnormal'}
                        </span>
                    </div>
                    <div class="result-item-details">
                        <div class="result-item-detail"><strong>Result</strong>${escapeHtml(test.result)}</div>
                        <div class="result-item-detail"><strong>Verification</strong>${escapeHtml(test.verificationStatus)}</div>
                        <div class="result-item-detail"><strong>Review</strong>${escapeHtml(test.reviewStatus)}</div>
                        <div class="result-item-detail"><strong>Captured</strong>${escapeHtml(formatDate(test.captureDateTime))}</div>
                    </div>
                    <div class="result-note">${escapeHtml(test.notes || 'No notes recorded')}</div>
                    ${test.reviewNotes ? `<div class="result-note"><strong>Review notes:</strong> ${escapeHtml(test.reviewNotes)}</div>` : ''}
                </div>
            `).join('');
            const hasAbnormal = item.tests.some(t => t.abnormal);
            const expanded = expandedResultCards.has(item.id);
            const released = normalizeStatus(item.status).toLowerCase() === 'released by doctor';
            return `
                <div class="result-card ${expanded ? 'expanded' : ''}">
                    <div class="result-card-header">
                        <div class="result-card-summary">
                            <h2>${escapeHtml(item.patientName)} - Request ${item.id}</h2>
                            <div class="result-meta">${escapeHtml(formatDate(item.createdAt))} · ${item.tests.length} test(s)</div>
                        </div>
                        <div class="result-status">
                            <span class="badge ${released ? 'green' : hasAbnormal ? 'amber' : 'blue'}">${escapeHtml(normalizeStatus(item.status))}</span>
                            <button class="btn btn-secondary result-toggle" type="button" aria-expanded="${expanded}" onclick="toggleResultCard(${item.id})">${expanded ? 'Minimize' : 'Expand'}</button>
                        </div>
                    </div>
                    ${hasAbnormal ? '<div class="result-warning">Contains abnormal results</div>' : ''}
                    <div class="result-card-body">${testsHtml}</div>
                    <div class="result-actions">
                        <button class="btn btn-secondary" type="button" disabled title="Requires backend email integration">Request Appointment</button>
                        <button class="btn btn-primary" type="button" disabled title="Requires secure release, PDF and email integration">${released ? 'Released by doctor' : 'Release Results'}</button>
                    </div>
                </div>
            `;
        }).join('');
    }

    function toggleResultCard(requestId) {
        if (expandedResultCards.has(requestId)) expandedResultCards.delete(requestId);
        else expandedResultCards.add(requestId);
        renderResultCards();
    }

    document.addEventListener('DOMContentLoaded', loadDoctorResults);
</script>
