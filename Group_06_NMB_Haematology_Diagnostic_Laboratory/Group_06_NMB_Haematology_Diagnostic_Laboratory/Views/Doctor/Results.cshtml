@{
    ViewData["Title"] = "Results";
    Layout = "~/Views/Shared/_LayoutDoctor.cshtml";
}

<div class="page-body">
    <div class="section-header">
        <div class="section-title">Review and Release Results</div>
        <div class="section-sub">Manage result cards, send patient emails, and release completed reports.</div>
    </div>

    <div class="card" style="margin-bottom: 18px;">
        <div class="card-body" style="padding: 16px 24px; display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: center;">
            <div>
                <div class="form-label">Search</div>
                <input id="results-search" class="form-control" type="search" placeholder="Search by patient, test type, or request ID..." oninput="renderResultCards()" />
            </div>
            <div class="btn-row" style="justify-self: end; gap: 10px;">
                <button class="btn btn-secondary" type="button" onclick="renderResultCards(true)">Refresh</button>
            </div>
        </div>
    </div>

    <div id="results-list"></div>
</div>

<div class="modal-overlay" id="modal-release">
    <div class="modal modal-md release-modal" role="dialog" aria-modal="true" aria-labelledby="release-modal-title" aria-describedby="release-modal-description">
        <div class="modal-header">
            <div>
                <span class="modal-title" id="release-modal-title">Release results to patient</span>
                <span class="modal-subtitle">Choose what the patient should receive with the report.</span>
            </div>
            <button class="modal-close" type="button" aria-label="Close release results dialog" onclick="closeModal('modal-release')">×</button>
        </div>
        <div class="modal-body">
            <p class="release-description" id="release-modal-description">The patient will be notified by email when the results are released. Select an appropriate message for the patient.</p>
            <fieldset class="release-options">
                <legend class="form-label">Patient message</legend>
                <label class="release-option" for="release-option-1">
                    <input type="radio" name="release-option" id="release-option-1" value="normal" checked />
                    <span>
                        <strong>Results are ready to view</strong>
                        <small>The patient can review the results online.</small>
                    </span>
                </label>
                <label class="release-option" for="release-option-2">
                    <input type="radio" name="release-option" id="release-option-2" value="appointment" />
                    <span>
                        <strong>Request an appointment</strong>
                        <small>The patient should arrange an appointment to discuss the results.</small>
                    </span>
                </label>
            </fieldset>
            <div class="form-group">
                <label class="form-label" for="release-note">Additional message <span class="form-label-hint">Optional</span></label>
                <textarea id="release-note" class="form-control" rows="4" placeholder="Add any instructions or context for the patient..."></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" type="button" onclick="closeModal('modal-release')">Cancel</button>
            <button class="btn btn-primary" type="button" onclick="submitReleaseResult()">Send &amp; email patient</button>
        </div>
    </div>
</div>

<div class="modal-overlay" id="modal-email">
    <div class="modal modal-md release-modal" role="dialog" aria-modal="true" aria-labelledby="email-modal-title" aria-describedby="email-modal-description">
        <div class="modal-header">
            <div>
                <span class="modal-title" id="email-modal-title">Email results to patient</span>
                <span class="modal-subtitle">Send the report securely with a short message.</span>
            </div>
            <button class="modal-close" type="button" aria-label="Close email results dialog" onclick="closeModal('modal-email')">×</button>
        </div>
        <div class="modal-body">
            <p class="release-description" id="email-modal-description">The patient will receive an email with the PDF report attached. Review the message before sending.</p>
            <div class="form-group">
                <label class="form-label" for="email-message">Email message</label>
                <textarea id="email-message" class="form-control" rows="6" placeholder="Dear patient, please find your test results attached..."></textarea>
                <small class="form-hint">Do not include sensitive information that is not part of the report.</small>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" type="button" onclick="closeModal('modal-email')">Cancel</button>
            <button class="btn btn-primary" type="button" onclick="submitEmailResult()">Send email with PDF</button>
        </div>
    </div>
</div>

<style>
    .modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(11, 25, 41, 0.58);
    }

    .modal-overlay.is-open {
        display: flex;
    }

    .modal-subtitle {
        display: block;
        margin-top: 4px;
        color: #7A8CA0;
        font-size: 12px;
        line-height: 1.4;
    }

    .release-description {
        margin: 0 0 18px;
        color: #4A5563;
        font-size: 13px;
        line-height: 1.55;
    }

    .release-options {
        display: grid;
        gap: 10px;
        margin: 0 0 18px;
        padding: 0;
        border: 0;
    }

    .release-options legend {
        width: 100%;
        margin-bottom: 8px;
    }

    .release-option {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 12px 14px;
        border: 1px solid #E3E8F0;
        border-radius: 8px;
        background: #FFFFFF;
        cursor: pointer;
        transition: border-color 0.2s ease, background 0.2s ease;
    }

    .release-option:hover,
    .release-option:has(input:checked) {
        border-color: #00A98D;
        background: #F2FCFA;
    }

    .release-option input {
        margin-top: 3px;
        accent-color: #00A98D;
    }

    .release-option strong,
    .release-option small {
        display: block;
    }

    .release-option strong {
        color: #1A2A3A;
        font-size: 13px;
    }

    .release-option small {
        margin-top: 3px;
        color: #7A8CA0;
        font-size: 12px;
        line-height: 1.4;
    }

    .form-label-hint {
        color: #7A8CA0;
        font-size: 11px;
        font-weight: 400;
    }

    .result-card {
        background: #FFFFFF;
        border-radius: 12px;
        box-shadow: 0 10px 28px rgba(15, 30, 60, 0.08);
        margin-bottom: 12px;
        overflow: hidden;
    }

    .result-card-header {
        padding: 16px 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

        .result-card-header h2 {
            margin: 0;
            font-size: 17px;
            font-weight: 700;
        }

    .result-card-summary {
        min-width: 0;
    }

        .result-card-summary h2 {
            overflow-wrap: anywhere;
        }

    .result-meta {
        color: #7A8CA0;
        font-size: 13px;
        line-height: 1.6;
    }

    .result-card:not(.expanded) .result-meta {
        display: none;
    }

    .result-card:not(.expanded) .result-warning,
    .result-card:not(.expanded) .result-card-body,
    .result-card:not(.expanded) .result-actions {
        display: none;
    }

    .result-status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

        .result-status .badge {
            padding: 6px 10px;
        }

    .result-warning {
        margin: 0 24px 18px;
        padding: 14px 18px;
        border-radius: 12px;
        background: #FFF4E6;
        color: #7A4E05;
        border: 1px solid rgba(245, 166, 35, 0.24);
        font-size: 14px;
    }

    .result-card-body {
        padding: 0 24px 22px;
    }

    .result-item {
        background: #FAFAFB;
        border-radius: 14px;
        padding: 18px 20px;
        margin-bottom: 16px;
    }

        .result-item:last-child {
            margin-bottom: 0;
        }

    .result-item-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
    }

        .result-item-title strong {
            font-size: 16px;
            font-weight: 700;
        }

    .result-item-details {
        display: grid;
        grid-template-columns: repeat(3, minmax(140px, 1fr));
        gap: 18px;
        margin-bottom: 16px;
    }

    .result-item-detail {
        font-size: 12px;
        color: #4A5563;
    }

        .result-item-detail strong {
            display: block;
            margin-bottom: 6px;
            color: #1A2A3A;
        }

    .result-note {
        color: #4A5563;
        font-size: 13px;
        line-height: 1.6;
    }

    .result-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin: 14px 24px 20px;
    }

        .result-actions .btn {
            min-width: 130px;
        }

        .result-actions .btn-primary {
            background: #1D5BFF;
        }

        .result-actions .btn-secondary {
            border-color: #E3E8F0;
            color: #516174;
        }

    .result-card-details[hidden] {
        display: none;
    }

    .result-toggle {
        min-width: 94px;
    }

    @@media (max-width: 640px) {
        .result-card-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .result-status {
            justify-content: flex-start;
            width: 100%;
        }

        .result-toggle {
            width: 100%;
        }
    }
</style>

<script>
    const requestsStorageKey = 'doctorRequests';
    const expandedResultCards = new Set();
    let currentActionRequestId = null;

    function openModal(modalId) {
        document.getElementById(modalId)?.classList.add('is-open');
    }

    function closeModal(modalId) {
        document.getElementById(modalId)?.classList.remove('is-open');
    }

    document.querySelectorAll('.modal-overlay').forEach(modal => {
        modal.addEventListener('click', event => {
            if (event.target === modal) {
                modal.classList.remove('is-open');
            }
        });
    });

    function getStoredRequests() {
        try {
            const stored = localStorage.getItem(requestsStorageKey);
            const parsed = stored ? JSON.parse(stored) : [];
            return Array.isArray(parsed) ? parsed : [];
        } catch {
            return [];
        }
    }

    function saveStoredRequests(items) {
        localStorage.setItem(requestsStorageKey, JSON.stringify(items));
    }

    function ensureStoredRequests() {
        const stored = getStoredRequests();
        saveStoredRequests(stored);
        return stored;
    }

    function getTestDetails(testName) {
        return {
            performedBy: 'Pending lab review',
            result: 'Awaiting result entry',
            normalRange: 'Pending',
            verifiedBy: 'Pending verification',
            notes: 'No result details are available yet for this test.',
            abnormal: false
        };
    }

    function normalizeStatus(status) {
        const value = String(status || '').toLowerCase();
        if (value === 'released') return 'Released by doctor';
        if (value === 'samples received') return 'Samples Received';
        if (value === 'in progress') return 'In progress';
        if (value === 'released by doctor') return 'Released by doctor';
        if (value === 'submitted') return 'Submitted';
        if (value === 'completed') return 'Completed';
        if (value === 'cancelled') return 'Cancelled';
        return status || 'Unknown';
    }

    function renderResultCards(forceRefresh = false) {
        if (forceRefresh) {
            saveStoredRequests(ensureStoredRequests());
        }
        const searchTerm = document.getElementById('results-search').value.toLowerCase().trim();
        const list = document.getElementById('results-list');
        const requests = ensureStoredRequests();
        const filtered = requests.filter(item => {
            if (!searchTerm) return true;
            const searchFields = [item.patientName, item.id, item.status, ...(Array.isArray(item.tests) ? item.tests.map(t => typeof t === 'string' ? t : t.testName) : [])];
            return searchFields.some(value => String(value).toLowerCase().includes(searchTerm));
        });

        if (filtered.length === 0) {
            list.innerHTML = '<div class="card"><div class="card-body">No results found matching your search.</div></div>';
            return;
        }

        list.innerHTML = filtered.map(item => {
            const tests = Array.isArray(item.tests) ? item.tests : [];
            const testsHtml = tests.map(test => {
                const isString = typeof test === 'string';
                const testName = isString ? test : (test && test.testName ? test.testName : 'Unnamed test');
                const data = isString ? getTestDetails(testName) : { ...getTestDetails(testName), ...test };
                return `
                    <div class="result-item">
                        <div class="result-item-title"><strong>${testName}</strong><span class="badge ${data.abnormal ? 'red' : 'green'}">${data.abnormal ? 'Abnormal' : 'Normal'}</span></div>
                        <div class="result-item-details">
                            <div class="result-item-detail"><strong>Performed by</strong>${data.performedBy}</div>
                            <div class="result-item-detail"><strong>Result</strong>${data.result}</div>
                            <div class="result-item-detail"><strong>Normal Range</strong>${data.normalRange}</div>
                            <div class="result-item-detail"><strong>Verified</strong>${data.verifiedBy}</div>
                        </div>
                        <div class="result-note">${data.notes}</div>
                    </div>
                `;
            }).join('');

            const hasAbnormal = tests.some(test => {
                if (typeof test === 'string') return getTestDetails(test).abnormal;
                return test.abnormal;
            });
            const displayStatus = normalizeStatus(item.status);
            const isReleased = item.released || displayStatus === 'Released by doctor';
            const badgeClass = isReleased ? 'green' : hasAbnormal ? 'amber' : 'blue';
            const badgeLabel = displayStatus || (isReleased ? 'Released by doctor' : 'Pending release');
            const isExpanded = expandedResultCards.has(item.id);

            const actionButton = isReleased
                ? `<button class="btn btn-secondary" disabled>Released by doctor</button>`
                : `<button class="btn btn-primary" type="button" onclick="openReleaseModal('${item.id}')">Release Results</button>`;

            const emailButton = `<button class="btn btn-secondary" type="button" onclick="openEmailModal('${item.id}')">Email</button>`;
            const pdfButton = `<button class="btn btn-secondary" type="button" onclick="toast('Download PDF generated for ${item.patientName}.')">PDF</button>`;
            const toggleButton = `<button class="btn btn-secondary result-toggle" type="button" aria-expanded="${isExpanded}" onclick="toggleResultCard('${item.id}')">${isExpanded ? 'Minimize' : 'Expand'}</button>`;

            return `
                <div class="result-card ${isExpanded ? 'expanded' : ''}">
                    <div class="result-card-header">
                        <div class="result-card-summary">
                            <h2>${item.patientName} - ${item.id}</h2>
                            <div class="result-meta">${item.createdAt ? item.createdAt.split('T')[0] : 'Unknown date'} · ${tests.length} test(s)</div>
                        </div>
                        <div class="result-status">
                            <span class="badge ${badgeClass}">${badgeLabel}</span>
                            ${toggleButton}
                        </div>
                    </div>
                    ${hasAbnormal ? '<div class="result-warning">Contains abnormal results</div>' : ''}
                    <div class="result-card-body">${testsHtml}</div>
                    <div class="result-actions">
                        ${pdfButton}
                        ${emailButton}
                        ${actionButton}
                    </div>
                </div>
            `;
        }).join('');
    }

    function toggleResultCard(requestId) {
        if (expandedResultCards.has(requestId)) {
            expandedResultCards.delete(requestId);
        } else {
            expandedResultCards.add(requestId);
        }
        renderResultCards();
    }

    function openReleaseModal(requestId) {
        currentActionRequestId = requestId;
        document.getElementById('release-option-1').checked = true;
        document.getElementById('release-note').value = '';
        openModal('modal-release');
    }

    function openEmailModal(requestId) {
        currentActionRequestId = requestId;
        const item = ensureStoredRequests().find(r => r.id === requestId);
        const message = `Dear ${item?.patientName || 'patient'}, please find your test results attached. If you have any questions, reply to this email.`;
        document.getElementById('email-message').value = message;
        openModal('modal-email');
    }

    function submitReleaseResult() {
        const requests = ensureStoredRequests();
        const item = requests.find(r => r.id === currentActionRequestId);
        if (!item) return;
        item.status = 'Released by doctor';
        item.released = true;
        saveStoredRequests(requests);
        closeModal('modal-release');
        renderResultCards();
        toast(`Results released for ${item.patientName}.`);
    }

    function submitEmailResult() {
        const item = ensureStoredRequests().find(r => r.id === currentActionRequestId);
        if (!item) return;
        closeModal('modal-email');
        toast(`Email sent to ${item.patientName}.`);
    }

    document.addEventListener('DOMContentLoaded', () => {
        ensureStoredRequests();
        renderResultCards();
    });
</script>
