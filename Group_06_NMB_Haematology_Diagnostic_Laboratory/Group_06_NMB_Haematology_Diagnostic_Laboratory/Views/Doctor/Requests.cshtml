@{
    ViewData["Title"] = "Test Request Management";
    Layout = "~/Views/Shared/_LayoutDoctor.cshtml";
}

<div class="page-body">
    <div class="section-header">
        <div class="section-title">Test Request Management</div>
        <div class="section-sub">Create and track laboratory test requests</div>
    </div>

    <div class="card" style="margin-bottom: 20px;">
        <div class="card-body" style="display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: center;">
            <div style="display: grid; grid-template-columns: 1fr minmax(140px, 1fr) minmax(140px, 1fr); gap: 12px; align-items: center;">
                <input id="requests-search" class="form-control" type="search" placeholder="Search requests..." aria-label="Search requests" />
                <select id="requests-filter-status" class="form-control">
                    <option value="">All statuses</option>
                    <option>Submitted</option>
                    <option>Samples Received</option>
                    <option>In progress</option>
                    <option>Completed</option>
                    <option>Released by doctor</option>
                    <option>Cancelled</option>
                </select>
                <select id="requests-filter-urgency" class="form-control">
                    <option value="">All urgencies</option>
                    <option>Routine</option>
                    <option>Urgent</option>
                    <option>STAT</option>
                </select>
            </div>
            <a class="btn btn-primary" asp-controller="Doctor" asp-action="CreateRequest">+ New Test Request</a>
        </div>
    </div>

    <div id="technician-cancel-alerts"></div>
    <p id="request-action-message" role="status" aria-live="polite" tabindex="-1" hidden></p>

    <div class="card" style="margin-bottom: 20px;">
        <div class="card-header"><span class="card-title">Progress Status Guide</span></div>
        <div class="card-body">
            <div class="status-guide">
                <div><span class="badge blue">Submitted</span><span>Doctor has submitted the test request.</span></div>
                <div><span class="badge amber">Samples Received</span><span>Lab technician has marked the samples as received.</span></div>
                <div><span class="badge blue">In progress</span><span>At least one test type has been selected by a lab technician.</span></div>
                <div><span class="badge green">Completed</span><span>All tests have been completed and results captured.</span></div>
                <div><span class="badge green">Released by doctor</span><span>Doctor has made the results available to the patient.</span></div>
                <div><span class="badge red">Cancelled</span><span>The cancellation reason is captured and kept with the request.</span></div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Request ID</th>
                        <th>Patient</th>
                        <th>Date</th>
                        <th>Urgency</th>
                        <th>Status</th>
                        <th>Tests</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="requests-tbody"></tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .doctor-cancel-dialog {
        width: min(520px, calc(100vw - 32px));
        max-height: calc(100vh - 40px);
        margin: auto;
        padding: 0;
        border: 0;
        border-radius: 12px;
        background: #fff;
        color: #1A2A3A;
        box-shadow: 0 22px 70px rgba(10, 30, 60, .25);
    }

    .doctor-cancel-dialog::backdrop {
        background: rgba(11, 25, 41, .58);
    }

    #cancel-request-error {
        color: #a71930;
        margin-top: 12px;
    }

    #request-action-message {
        padding: 12px 16px;
        background: #e9f8f2;
        border-radius: 8px;
    }

    .status-guide {
        display: grid;
        grid-template-columns: repeat(2, minmax(220px, 1fr));
        gap: 12px 18px;
    }

        .status-guide > div {
            display: grid;
            grid-template-columns: minmax(140px, auto) 1fr;
            gap: 10px;
            align-items: start;
            color: #4A5563;
            font-size: 13px;
        }

    .technician-cancel-alert {
        border: 1px solid rgba(255, 71, 87, 0.22);
        background: #FFF2F3;
        color: #7A1E28;
        border-radius: 10px;
        margin-bottom: 16px;
        padding: 14px 16px;
        font-size: 14px;
    }

    .cancel-reason-note {
        display: block;
        color: #7A8CA0;
        font-size: 12px;
        margin-top: 4px;
    }

    @@media (max-width: 720px) {
        .status-guide {
            grid-template-columns: 1fr;
        }

            .status-guide > div {
                grid-template-columns: 1fr;
            }
    }
</style>

<dialog class="doctor-cancel-dialog" id="cancel-request-dialog" aria-labelledby="cancel-request-title" aria-describedby="cancel-request-summary">
    <form id="cancel-request-form">
        <div class="modal-header">
            <h2 class="modal-title" id="cancel-request-title">Cancel Test Request</h2>
            <button class="modal-close" type="button" data-close-cancel aria-label="Close cancellation popup">&times;</button>
        </div>
        <div class="modal-body">
            @Html.AntiForgeryToken()
            <p id="cancel-request-summary" style="margin-bottom: 14px; color: #4A5563;"></p>
            <div class="form-group">
                <label class="form-label" for="cancelled-by">Cancelled by</label>
                <input id="cancelled-by" class="form-control" value="@(User.Identity?.Name ?? "Doctor")" readonly />
            </div>
            <div class="form-group">
                <label class="form-label" for="cancelled-date">Cancellation date and time</label>
                <input id="cancelled-date" class="form-control" readonly />
                <small>The cancellation time is recorded when you confirm.</small>
            </div>
            <div class="form-group">
                <label class="form-label" for="cancel-request-reason">Reason for cancellation</label>
                <textarea id="cancel-request-reason" name="reason" class="form-control" rows="5" maxlength="500" placeholder="Enter the reason for cancelling this test request..." aria-describedby="cancel-reason-hint cancel-request-error" required></textarea>
                <small id="cancel-reason-hint">Enter a reason of 1 to 500 characters.</small>
            </div>
            <p id="cancel-request-error" role="alert" hidden></p>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" type="button" data-close-cancel>Keep Request</button>
            <button class="btn btn-danger" id="confirm-cancel-request" type="submit">Cancel Request</button>
        </div>
    </form>
</dialog>

<script id="doctor-requests-script" src="~/js/doctor-requests.js" asp-append-version="true"
    data-list-url="@Url.Action("GetRequests", "Doctor")"
    data-details-url="@Url.Action("RequestDetails", "Doctor")"
    data-cancel-url="@Url.Action("CancelTestRequest", "Doctor")"></script>
