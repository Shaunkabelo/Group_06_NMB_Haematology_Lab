```cshtml
@{
    ViewData["Title"] = "Create Test Request";
    Layout = "~/Views/Shared/_LayoutDoctor.cshtml";
}

<div class="page-body">

    <div class="section-header">
        <div class="section-title">Create Test Request</div>

        <div class="section-sub">
            Select a patient, review their medical details, and assign samples for each requested test.
        </div>
    </div>

    <section class="grid-2">

        <!-- ===================================================== -->
        <!-- REQUEST DETAILS -->
        <!-- ===================================================== -->

        <div class="card">

            <div class="card-header">
                <span class="card-title">Request Details</span>
            </div>

            <div class="card-body">

                <!-- PATIENT + URGENCY -->
                <div class="form-row">

                    <div class="form-group">

                        <label class="form-label" for="patient-select">
                            Patient
                        </label>

                        <select id="patient-select"
                                class="form-control">
                            <option value="">
                                -- Select Patient --
                            </option>
                        </select>

                    </div>


                    <div class="form-group">

                        <label class="form-label" for="urgency-select">
                            Urgency
                        </label>

                        <select class="form-control"
                                id="urgency-select">

                            <option value="Routine">Routine</option>
                            <option value="Urgent">Urgent</option>
                            <option value="STAT">STAT</option>

                        </select>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- PATIENT INFORMATION -->
                <!-- ================================================= -->

                <div id="patient-info-panel"
                     class="patient-info-panel"
                     style="display:none;">

                    <div class="info-section">

                        <h4>Patient Medical Information</h4>

                        <div class="info-grid">

                            <div class="info-item">
                                <label>Name</label>
                                <span id="patient-name"></span>
                            </div>

                            <div class="info-item">
                                <label>Cellphone</label>
                                <span id="patient-cellphone"></span>
                            </div>

                            <div class="info-item">
                                <label>Email</label>
                                <span id="patient-email"></span>
                            </div>

                        </div>


                        <div class="info-section-box">

                            <label class="section-label">
                                Known Medical Conditions
                            </label>

                            <div id="patient-conditions"
                                 class="info-text">
                            </div>

                        </div>


                        <div class="info-section-box">

                            <label class="section-label">
                                Allergies
                            </label>

                            <div id="patient-allergies"
                                 class="info-text">
                            </div>

                        </div>


                        <div class="info-section-box">

                            <label class="section-label">
                                Current Medications
                            </label>

                            <div id="patient-medication"
                                 class="info-text">
                            </div>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- CLINICAL NOTES -->
                <!-- ================================================= -->

                <div class="form-group">

                    <label class="form-label" for="clinical-notes">
                        Clinical Notes
                    </label>

                    <textarea id="clinical-notes"
                              class="form-control"
                              placeholder="Enter relevant clinical context"></textarea>

                </div>


                <!-- ================================================= -->
                <!-- TEST SELECTION -->
                <!-- ================================================= -->

                <div class="form-group">

                    <label class="form-label">
                        Requested Test Types
                    </label>


                    <div class="form-row test-selection-row">

                        <!-- CATEGORY -->

                        <div class="form-group">

                            <label class="form-label"
                                   for="test-category-select">
                                Test Category
                            </label>

                            <select id="test-category-select"
                                    class="form-control">

                                <option value="">
                                    -- Select Category --
                                </option>

                            </select>

                        </div>


                        <!-- TEST -->

                        <div class="form-group">

                            <label class="form-label"
                                   for="test-select">
                                Test
                            </label>

                            <select id="test-select"
                                    class="form-control"
                                    disabled>

                                <option value="">
                                    -- Select a category first --
                                </option>

                            </select>

                        </div>


                        <!-- ADD TEST -->

                        <button class="btn btn-primary add-test-button"
                                type="button"
                                id="add-test-button">

                            Add Test

                        </button>

                    </div>


                    <small class="form-hint">
                        Select a category, choose a test, and add it to the request.
                        Each selected test requires a sample barcode.
                    </small>

                </div>


                <!-- ================================================= -->
                <!-- BUTTONS -->
                <!-- ================================================= -->

                <div class="form-row">

                    <button class="btn btn-secondary"
                            type="button"
                            id="back-button">

                        Back to Requests

                    </button>


                    <button class="btn btn-primary"
                            type="button"
                            id="submit-request-button">

                        Submit Request

                    </button>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- SELECTED TESTS -->
        <!-- ===================================================== -->

        <div class="card">

            <div class="card-header">

                <span class="card-title">
                    Selected Tests & Samples
                </span>

            </div>


            <div class="card-body sample-summary-card">

                <div class="summary-help">
                    For every selected test, enter the barcode from the sample tube used.
                </div>


                <div id="selected-tests-list"
                     class="selected-tests-list">

                    <div class="summary-empty">
                        No tests selected.
                        Choose a test type to build the sample list.
                    </div>

                </div>

            </div>

        </div>

    </section>

</div>


<script>

    // =============================================================
    // BACKEND ROUTES
    // =============================================================

    const routes = {
        getPatients: '@Url.Action("GetPatients", "Doctor")',
        getPatient: '@Url.Action("GetPatient", "Doctor")',
        getTestCategories: '@Url.Action("GetTestCategories", "Doctor")',
        getTestsByCategory: '@Url.Action("GetTestsByCategory", "Doctor")',
        createTestRequest: '@Url.Action("CreateTestRequest", "Doctor")',
        requests: '@Url.Action("Requests", "Doctor")'
    };


    // =============================================================
    // DATA
    // =============================================================

    const selectedTests = [];
    const sampleBarcodes = {};

    let patientList = [];


    // =============================================================
    // PAGE LOAD
    // =============================================================

    document.addEventListener("DOMContentLoaded", function () {

        loadPatients();
        loadTestCategories();

        document
            .getElementById("patient-select")
            .addEventListener("change", loadPatientDetails);

        document
            .getElementById("test-category-select")
            .addEventListener("change", loadTestsForCategory);

        document
            .getElementById("add-test-button")
            .addEventListener("click", addSelectedTest);

        document
            .getElementById("submit-request-button")
            .addEventListener("click", submitRequest);

        document
            .getElementById("back-button")
            .addEventListener("click", function () {
                window.location.href = routes.requests;
            });

    });


    // =============================================================
    // LOAD PATIENTS
    // =============================================================

    async function loadPatients() {

        try {

            const response = await fetch(routes.getPatients);

            if (!response.ok) {
                throw new Error("Unable to load patients.");
            }

            const data = await response.json();

            patientList = Array.isArray(data) ? data : [];

            const select =
                document.getElementById("patient-select");

            select.innerHTML =
                '<option value="">-- Select Patient --</option>';


            patientList.forEach(patient => {

                const option =
                    document.createElement("option");

                /*
                 * These properties must match your Patient
                 * model returned by the controller.
                 */

                option.value = patient.patientID;

                const firstName =
                    patient.firstName ?? "";

                const lastName =
                    patient.lastName ?? "";

                const saIdNumber =
                    patient.saIdNumber ?? "";

                option.textContent =
                    `${saIdNumber} - ${firstName} ${lastName}`;

                select.appendChild(option);

            });

        }
        catch (error) {

            console.error(error);

            alert("Unable to load patients.");

        }

    }


    // =============================================================
    // LOAD PATIENT DETAILS
    // =============================================================

    async function loadPatientDetails() {

        const patientId =
            document.getElementById("patient-select").value;

        const panel =
            document.getElementById("patient-info-panel");


        if (!patientId) {

            panel.style.display = "none";

            return;

        }


        try {

            const url =
                `${routes.getPatient}?patientId=${encodeURIComponent(patientId)}`;

            const response =
                await fetch(url);


            if (!response.ok) {

                throw new Error("Patient not found.");

            }


            const data =
                await response.json();


            document.getElementById("patient-name").textContent =
                `${data.firstName ?? ""} ${data.lastName ?? ""}`.trim()
                || "N/A";


            document.getElementById("patient-cellphone").textContent =
                data.cellphone ?? "N/A";


            document.getElementById("patient-email").textContent =
                data.email ?? "N/A";


            document.getElementById("patient-conditions").textContent =
                data.knownMedicalConditions
                ?? "None recorded";


            document.getElementById("patient-allergies").textContent =
                data.allergies
                ?? "None recorded";


            document.getElementById("patient-medication").textContent =
                data.medication
                ?? "None recorded";


            panel.style.display = "block";

        }
        catch (error) {

            console.error(error);

            alert("Unable to load patient information.");

            panel.style.display = "none";

        }

    }


    // =============================================================
    // LOAD TEST CATEGORIES
    // =============================================================

    async function loadTestCategories() {

        try {

            const response =
                await fetch(routes.getTestCategories);


            if (!response.ok) {

                throw new Error(
                    "Unable to load test categories."
                );

            }


            const data =
                await response.json();


            const select =
                document.getElementById(
                    "test-category-select"
                );


            select.innerHTML =
                '<option value="">-- Select Category --</option>';


            if (!Array.isArray(data)) {
                return;
            }


            data.forEach(category => {

                const option =
                    document.createElement("option");


                option.value =
                    category.testCategoryID;


                option.textContent =
                    category.categoryName;


                select.appendChild(option);

            });

        }
        catch (error) {

            console.error(error);

            alert("Unable to load test categories.");

        }

    }


    // =============================================================
    // LOAD TESTS BY CATEGORY
    // =============================================================

    async function loadTestsForCategory() {

        const categoryId =
            document.getElementById(
                "test-category-select"
            ).value;


        const testSelect =
            document.getElementById("test-select");


        if (!categoryId) {

            testSelect.innerHTML =
                '<option value="">-- Select a category first --</option>';

            testSelect.disabled = true;

            return;

        }


        try {

            const url =
                `${routes.getTestsByCategory}?testCategoryId=${encodeURIComponent(categoryId)}`;


            const response =
                await fetch(url);


            if (!response.ok) {

                throw new Error(
                    "Unable to load tests."
                );

            }


            const data =
                await response.json();


            testSelect.innerHTML =
                '<option value="">-- Select Test --</option>';


            if (!Array.isArray(data) || data.length === 0) {

                testSelect.disabled = true;

                return;

            }


            data.forEach(test => {

                const option =
                    document.createElement("option");


                option.value =
                    test.testTypeID;


                option.textContent =
                    test.testName;


                /*
                 * These values come from the backend.
                 */

                option.dataset.sampleTypeId =
                    test.sampleTypeID ?? "";


                option.dataset.sampleTypeName =
                    test.sampleTypeName ?? "Sample";


                /*
                 * Disable tests already selected.
                 */

                if (
                    selectedTests.some(
                        selected =>
                            selected.testTypeId ===
                            Number(test.testTypeID)
                    )
                ) {

                    option.disabled = true;

                }


                testSelect.appendChild(option);

            });


            testSelect.disabled = false;

        }
        catch (error) {

            console.error(error);

            alert("Unable to load tests.");

            testSelect.disabled = true;

        }

    }


    // =============================================================
    // ADD SELECTED TEST
    // =============================================================

    function addSelectedTest() {

        const testSelect =
            document.getElementById("test-select");


        const selectedOption =
            testSelect.options[testSelect.selectedIndex];


        if (
            !selectedOption ||
            !selectedOption.value
        ) {

            alert("Please select a test.");

            return;

        }


        const testTypeId =
            Number(selectedOption.value);


        const testName =
            selectedOption.textContent.trim();


        const sampleTypeId =
            Number(selectedOption.dataset.sampleTypeId);


        const sampleTypeName =
            selectedOption.dataset.sampleTypeName
            || "Sample";


        /*
         * Make sure a valid sample type was supplied
         * by the backend.
         */

        if (!sampleTypeId || sampleTypeId <= 0) {

            alert(
                "This test does not have a valid sample type."
            );

            return;

        }


        /*
         * Prevent duplicate tests.
         */

        if (
            selectedTests.some(
                test => test.testTypeId === testTypeId
            )
        ) {

            alert(
                "This test has already been selected."
            );

            return;

        }


        selectedTests.push({

            testTypeId: testTypeId,

            testName: testName,

            sampleTypeId: sampleTypeId,

            sampleTypeName: sampleTypeName

        });


        sampleBarcodes[testTypeId] = "";


        updateRequestSummary();


        /*
         * Refresh the test dropdown so the selected
         * test becomes disabled.
         */

        loadTestsForCategory();


        testSelect.value = "";

    }


    // =============================================================
    // UPDATE REQUEST SUMMARY
    // =============================================================

    function updateRequestSummary() {

        const list =
            document.getElementById(
                "selected-tests-list"
            );


        list.innerHTML = "";


        if (selectedTests.length === 0) {

            list.innerHTML =
                '<div class="summary-empty">' +
                'No tests selected. Choose a test type to build the sample list.' +
                '</div>';

            return;

        }


        selectedTests.forEach(test => {

            const row =
                document.createElement("div");


            row.className =
                "sample-summary-row";


            /*
             * Build the row without trusting backend
             * HTML directly.
             */

            const meta =
                document.createElement("div");

            meta.className =
                "sample-summary-meta";


            const nameContainer =
                document.createElement("div");


            const name =
                document.createElement("div");

            name.className =
                "sample-summary-label";

            name.textContent =
                test.testName;


            const sample =
                document.createElement("small");

            sample.textContent =
                `${test.sampleTypeName} sample`;


            nameContainer.appendChild(name);
            nameContainer.appendChild(sample);
            meta.appendChild(nameContainer);


            const barcodeContainer =
                document.createElement("div");

            barcodeContainer.className =
                "sample-summary-barcode";


            const label =
                document.createElement("label");

            label.className =
                "section-label";

            label.textContent =
                "Barcode";


            const input =
                document.createElement("input");

            input.type =
                "text";

            input.className =
                "form-control";

            input.placeholder =
                "Enter sample barcode";

            input.value =
                sampleBarcodes[test.testTypeId] || "";


            input.addEventListener(
                "input",
                function () {

                    updateSampleBarcode(
                        test.testTypeId,
                        this.value
                    );

                }
            );


            barcodeContainer.appendChild(label);
            barcodeContainer.appendChild(input);


            const removeButton =
                document.createElement("button");

            removeButton.type =
                "button";

            removeButton.className =
                "btn btn-secondary";

            removeButton.textContent =
                "Remove";


            removeButton.addEventListener(
                "click",
                function () {

                    removeSelectedTest(
                        test.testTypeId
                    );

                }
            );


            row.appendChild(meta);
            row.appendChild(barcodeContainer);
            row.appendChild(removeButton);


            list.appendChild(row);

        });

    }


    // =============================================================
    // UPDATE BARCODE
    // =============================================================

    function updateSampleBarcode(
        testTypeId,
        value
    ) {

        sampleBarcodes[testTypeId] =
            value;

    }


    // =============================================================
    // REMOVE TEST
    // =============================================================

    function removeSelectedTest(testTypeId) {

        const index =
            selectedTests.findIndex(
                test =>
                    test.testTypeId === testTypeId
            );


        if (index !== -1) {

            selectedTests.splice(
                index,
                1
            );

        }


        delete sampleBarcodes[testTypeId];


        updateRequestSummary();


        loadTestsForCategory();

    }


    // =============================================================
    // SUBMIT REQUEST
    // =============================================================

    async function submitRequest() {

        const patientValue =
            document.getElementById(
                "patient-select"
            ).value;


        const patientId =
            Number(patientValue);


        const urgency =
            document.getElementById(
                "urgency-select"
            ).value;


        const clinicalNotes =
            document.getElementById(
                "clinical-notes"
            ).value.trim();


        // ---------------------------------------------------------
        // VALIDATION
        // ---------------------------------------------------------

        if (!patientId || patientId <= 0) {

            alert(
                "Please select a patient."
            );

            return;

        }


        if (selectedTests.length === 0) {

            alert(
                "Please select at least one test."
            );

            return;

        }


        const missingBarcode =
            selectedTests.find(
                test =>
                    !String(
                        sampleBarcodes[test.testTypeId] || ""
                    ).trim()
            );


        if (missingBarcode) {

            alert(
                `Please enter the barcode for ${missingBarcode.testName}.`
            );

            return;

        }


        // ---------------------------------------------------------
        // BUILD REQUEST
        // ---------------------------------------------------------

        const requestData = {

            patientId: patientId,

            urgency: urgency,

            clinicalNotes: clinicalNotes,

            tests: selectedTests.map(test => ({

                testTypeId:
                    test.testTypeId,

                sampleTypeId:
                    test.sampleTypeId,

                barcodeNumber:
                    String(
                        sampleBarcodes[test.testTypeId]
                    ).trim()

            }))

        };


        // ---------------------------------------------------------
        // SUBMIT
        // ---------------------------------------------------------

        try {

            const response =
                await fetch(
                    routes.createTestRequest,
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/json"
                        },

                        body:
                            JSON.stringify(
                                requestData
                            )
                    }
                );


            let result = null;

            try {

                result =
                    await response.json();

            }
            catch {

                result = null;

            }


            if (!response.ok) {

                throw new Error(
                    result?.message ||
                    "Unable to create test request."
                );

            }


            if (!result?.success) {

                throw new Error(
                    result?.message ||
                    "Unable to create test request."
                );

            }


            alert(
                result.message ||
                "Test request created successfully."
            );


            window.location.href =
                routes.requests;

        }
        catch (error) {

            console.error(
                "Create test request error:",
                error
            );


            alert(
                error.message ||
                "An error occurred while creating the test request."
            );

        }

    }

</script>
```
