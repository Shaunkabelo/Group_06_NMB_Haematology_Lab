@{
    ViewData["Title"] = "Request Details";
    Layout = "~/Views/Shared/_LayoutDoctor.cshtml";
}

<div class="page-body">
    <div class="section-header">
        <div class="section-title">Request Details</div>
        <div id="request-meta" class="section-sub"></div>
    </div>

    <div id="cancellation-panel"></div>

    <div class="card">
        <div class="card-header"><span class="card-title">Requested Tests</span></div>
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Test Type</th>
                        <th>Sample Barcode</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody id="tests-list"></tbody>
            </table>
        </div>
    </div>

    <div class="card" style="margin-top: 1rem;">
        <div class="card-header"><span class="card-title">Captured Results for this Request</span></div>
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Summary</th>
                        <th>Verified</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody id="request-results-list"></tbody>
            </table>
        </div>
        <div class="card-footer"><a class="btn" href="/Doctor/Requests">Back to Requests</a></div>
    </div>
</div>

<script>
    function getQueryParam(name) {
        const params = new URLSearchParams(location.search);
        return params.get(name);
    }

    function createTestRow(item) {
        const status = normalizeStatus(item.status);
        const barcode = item.sampleBarcode || item.barcode || item.sampleCode || 'N/A';
        return `
            <tr>
                <td>${item.testType}</td>
                <td>${barcode}</td>
                <td><span class="badge ${getBadgeClass(status)}">${status}</span></td>
            </tr>
        `;
    }

    function normalizeStatus(status) {
        const value = String(status || '').toLowerCase();
        if (value === 'released') return 'Released by doctor';
        if (value === 'samples received') return 'Samples Received';
        if (value === 'in progress') return 'In progress';
        if (value === 'released by doctor') return 'Released by doctor';
        if (value === 'submitted') return 'Submitted';
        if (value === 'completed') return 'Completed';
        if (value === 'cancelled') return 'Cancelled';
        return status || 'Unknown';
    }

    function isTechnicianCancelled(request) {
        const cancelledBy = String(request.cancelledBy || request.cancelledByRole || '').toLowerCase();
        return normalizeStatus(request.status).toLowerCase() === 'cancelled' && (cancelledBy.includes('technician') || cancelledBy.includes('lab'));
    }

    function getBadgeClass(status) {
        switch ((status || '').toLowerCase()) {
            case 'submitted': return 'blue';
            case 'samples received': return 'amber';
            case 'in progress': return 'blue';
            case 'completed': return 'green';
            case 'released':
            case 'released by doctor': return 'green';
            case 'cancelled': return 'red';
            default: return 'blue';
        }
    }

    function createResultRow(result) {
        return `
            <tr>
                <td>${result.summary}</td>
                <td><span class="badge ${result.verified ? 'green' : 'red'}">${result.verified ? 'Yes' : 'No'}</span></td>
                <td>${new Date(result.created).toLocaleString()}</td>
            </tr>
        `;
    }

    const id = getQueryParam('id');
    const requests = JSON.parse(localStorage.getItem('doctorRequests') || '[]');
    const req = requests.find(r => r.id === id);
    const results = JSON.parse(localStorage.getItem('doctorResults') || '[]');
    const requestResults = results.filter(r => r.requestId === id).sort((a, b) => new Date(b.created) - new Date(a.created));

    if (!req) {
        document.getElementById('request-meta').innerText = 'Request not found.';
        document.getElementById('tests-list').innerHTML = '<tr><td colspan="3">Unable to load request details.</td></tr>';
        document.getElementById('request-results-list').innerHTML = '<tr><td colspan="3">Unable to load request results.</td></tr>';
    } else {
        document.getElementById('request-meta').innerText = `${req.id} — ${req.patientName || 'Unknown'} — ${req.status}`;
        const displayStatus = normalizeStatus(req.status);
        document.getElementById('request-meta').innerText = `${req.id} - ${req.patientName || 'Unknown'} - ${displayStatus}`;
        if (displayStatus === 'Cancelled') {
            document.getElementById('cancellation-panel').innerHTML = `
                <div class="alert warning" style="margin-bottom: 16px;">
                    <strong>${isTechnicianCancelled(req) ? 'Cancelled by lab technician.' : 'Cancelled.'}</strong>
                    <div>Reason: ${req.cancellationReason || 'No reason captured.'}</div>
                </div>
            `;
        }
        const tbody = document.getElementById('tests-list');
        const items = Array.isArray(req.items) && req.items.length > 0
            ? req.items
            : (Array.isArray(req.tests)
                ? req.tests.map(test => ({ testType: test, sampleBarcode: req.sampleBarcodes?.[test] || req.sampleBarcode || 'N/A', status: req.status }))
                : [{ testType: req.tests, sampleBarcode: req.sampleBarcode || 'N/A', status: req.status }]);
        tbody.innerHTML = items.map(createTestRow).join('');

        const resultsBody = document.getElementById('request-results-list');
        if (requestResults.length === 0) {
            resultsBody.innerHTML = '<tr><td colspan="3">No results have been captured for this request yet.</td></tr>';
        } else {
            resultsBody.innerHTML = requestResults.map(createResultRow).join('');
        }
    }
</script>
