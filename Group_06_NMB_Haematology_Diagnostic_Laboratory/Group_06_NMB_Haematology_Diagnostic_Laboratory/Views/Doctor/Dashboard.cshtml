@{
    ViewData["Title"] = "Doctor Dashboard";
    Layout = "~/Views/Shared/_LayoutDoctor.cshtml";
}

<div class="page-body">
    <section class="stats-grid">
        <a href="/Doctor/Requests" class="stat-card teal clickable">
            <div class="stat-label">Submitted Requests</div>
            <div class="stat-value">14</div>
            <div class="stat-sub">3 urgent, 1 STAT</div>
        </a>
        <a href="/Doctor/Results" class="stat-card blue clickable">
            <div class="stat-label">Results Ready</div>
            <div class="stat-value">6</div>
            <div class="stat-sub">Awaiting release to patient</div>
        </a>
        <a href="/Doctor/Alerts" class="stat-card red clickable">
            <div class="stat-label">Abnormal Alerts</div>
            <div class="stat-value">4</div>
            <div class="stat-sub">Last 5 days</div>
        </a>
        <a href="/Doctor/Patients" class="stat-card amber clickable">
            <div class="stat-label">Patients</div>
            <div class="stat-value">128</div>
            <div class="stat-sub">Consent tracked</div>
        </a>
    </section>

    <section class="grid-2">
        <div class="card">
            <div class="card-header">
                <span class="card-title">Recent Requests</span>
                <a class="card-link" href="/Doctor/Requests">Create request</a>
            </div>
            <div class="card-body list">
                <div class="list-row"><span><a href="/Doctor/RequestDetails?id=REQ-2026-0182">REQ-2026-0182</a><small>Anele Mbeki - FBC, Coagulation</small></span><span class="badge blue">Submitted</span></div>
                <div class="list-row"><span><a href="/Doctor/RequestDetails?id=REQ-2026-0181">REQ-2026-0181</a><small>Johan Smit - Differential Count</small></span><span class="badge amber">In progress</span></div>
                <div class="list-row"><span><a href="/Doctor/RequestDetails?id=REQ-2026-0179">REQ-2026-0179</a><small>Priya Naidoo - Peripheral Blood Film</small></span><span class="badge green">Completed</span></div>
            </div>
        </div>
        <div class="card">
            <div class="card-header">
                <span class="card-title">Abnormal Result Alerts</span>
                <a class="card-link" href="/Doctor/Alerts">View all</a>
            </div>
            <div class="card-body">
                <div class="alert danger"><span>!</span><div><div>Low haemoglobin for REQ-2026-0179</div><small>Flagged automatically against normal range</small></div></div>
                <div class="alert warning"><span>!</span><div><div>Platelet count above range for REQ-2026-0177</div><small>Doctor review required before release</small></div></div>
            </div>
        </div>
    </section>
</div>
