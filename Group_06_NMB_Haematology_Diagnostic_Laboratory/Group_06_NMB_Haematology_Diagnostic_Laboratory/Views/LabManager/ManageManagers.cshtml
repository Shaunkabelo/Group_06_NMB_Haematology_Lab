@using Group_06_NMB_Haematology_Diagnostic_Lab.Data.Models
@model IEnumerable<LabManager>

@{
    Layout = "~/Views/Shared/_LabManager_Layout.cshtml";
}

<div class="page-body">

    <div class="section-header">
        <div>
            <h2>Lab Managers</h2>
            <small>Manage registered laboratory managers.</small>
        </div>

        <button class="btn btn-primary"
                onclick="openCreateManager()"
                data-bs-toggle="offcanvas"
                data-bs-target="#managerPanel">
            Add Lab Manager
        </button>

    </div>

    <div class="table-wrap">

        <table>

            <thead>

                <tr>

                    <th>Name</th>
                    <th>Surname</th>
                    <th>Email</th>
                    <th>Cellphone</th>
                    <th>SA ID</th>
                    <th>Status</th>
                    <th>Actions</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var manager in Model)
                {
                    <tr>

                        <td>@manager.User.Name</td>
                        <td>@manager.User.Surname</td>
                        <td>@manager.User.Email</td>
                        <td>@manager.User.Cellphone</td>
                        <td>@manager.User.SaIdNumber</td>

                        <td>
                            @(manager.User.IsActive ? "Active" : "Inactive")
                        </td>

                        <td class="td-actions">

                            <button type="button"
                                    class="btn btn-edit btn-sm"
                                    data-bs-toggle="offcanvas"
                                    data-bs-target="#managerPanel"
                                    onclick="openEditManager(this)"
                                    data-id="@manager.LabManagerId"
                                    data-name="@manager.User.Name"
                                    data-surname="@manager.User.Surname"
                                    data-email="@manager.User.Email"
                                    data-cellphone="@manager.User.Cellphone"
                                    data-dob="@manager.User.DateOfBirth?.ToString("yyyy-MM-dd")"
                                    data-said="@manager.User.SaIdNumber"
                                    data-address="@manager.User.HomeAddress">

                                Edit

                            </button>

                            <form asp-action="DeleteLabManager"
                                  asp-controller="LabManager"
                                  method="post"
                                  style="display:inline;">

                                <input type="hidden"
                                       name="id"
                                       value="@manager.LabManagerId" />

                                <button type="submit"
                                        class="btn btn-delete btn-sm"
                                        onclick="return confirm('Are you sure you want to deactivate this Lab Manager?');">

                                    Delete

                                </button>

                            </form>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<!-- ========================================================= -->
<!-- ADD / EDIT LAB MANAGER PANEL -->
<!-- ========================================================= -->

<div class="offcanvas offcanvas-end"
     tabindex="-1"
     id="managerPanel"
     style="width:600px;">

    <div class="offcanvas-header">

        <h4 id="managerPanelTitle">
            Add Lab Manager
        </h4>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="offcanvas"></button>

    </div>

    <div class="offcanvas-body">

        <form id="managerForm"
              asp-controller="LabManager"
              asp-action="CreateManager"
              method="post"
              onsubmit="return validateSouthAfricanId('ManagerSaIdNumber','ManagerDateOfBirth');">

            <input type="hidden"
                   id="LabManagerId"
                   name="LabManagerId"
                   value="0" />

            <div class="form-group">
                <label class="form-label">First Name</label>

                <input id="Name"
                       class="form-control"
                       name="User.Name"
                       required />
            </div>

            <div class="form-group">
                <label class="form-label">Surname</label>

                <input id="Surname"
                       class="form-control"
                       name="User.Surname"
                       required />
            </div>

            <div class="form-group">
                <label class="form-label">Email</label>

                <input id="Email"
                       type="email"
                       class="form-control"
                       name="User.Email"
                       required />
            </div>

            <div class="form-row">

                <div class="form-group">

                    <label class="form-label">Cellphone</label>

                    <input id="Cellphone"
                           class="form-control"
                           name="User.Cellphone" />

                </div>

                <div class="form-group">

                    <label class="form-label">Date of Birth</label>

                    <input id="ManagerDateOfBirth"
                           type="date"
                           class="form-control"
                           name="User.DateOfBirth"
                           onchange="validateSouthAfricanId('ManagerSaIdNumber','ManagerDateOfBirth')" />

                </div>

            </div>

            <div class="form-group">

                <label class="form-label">SA ID</label>

                <input id="ManagerSaIdNumber"
                       class="form-control"
                       maxlength="13"
                       name="User.SaIdNumber"
                       onkeyup="validateSouthAfricanId('ManagerSaIdNumber','ManagerDateOfBirth')"
                       onchange="validateSouthAfricanId('ManagerSaIdNumber','ManagerDateOfBirth')" />

                <small id="idValidation"
                       style="color:red;font-weight:bold;"></small>

            </div>

            <div class="form-group">

                <label class="form-label">Home Address</label>

                <textarea id="HomeAddress"
                          class="form-control"
                          name="User.HomeAddress"></textarea>

            </div>

            <button id="managerSubmitButton"
                    type="submit"
                    class="btn btn-primary">

                Save Lab Manager

            </button>

            <button type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="offcanvas">

                Cancel

            </button>

        </form>

    </div>

</div>

<script>

    function openCreateManager() {

        document.getElementById("managerPanelTitle").innerText = "Add Lab Manager";

        document.getElementById("managerSubmitButton").innerText = "Save Lab Manager";

        document.getElementById("managerForm").action = "/LabManager/CreateManager";

        document.getElementById("managerForm").reset();

        document.getElementById("LabManagerId").value = "0";

        clearValidation();
    }


    function openEditManager(button) {

        document.getElementById("managerPanelTitle").innerText = "Edit Lab Manager";

        document.getElementById("managerSubmitButton").innerText = "Update Lab Manager";

        document.getElementById("managerForm").action = "/LabManager/EditManager";

        document.getElementById("LabManagerId").value = button.dataset.id;

        document.getElementById("Name").value = button.dataset.name;

        document.getElementById("Surname").value = button.dataset.surname;

        document.getElementById("Email").value = button.dataset.email;

        document.getElementById("Cellphone").value = button.dataset.cellphone;

        document.getElementById("ManagerDateOfBirth").value = button.dataset.dob;

        document.getElementById("ManagerSaIdNumber").value = button.dataset.said;

        document.getElementById("HomeAddress").value = button.dataset.address;

        clearValidation();
    }


    function validateSouthAfricanId(idInputId, dobInputId) {

        const id = document.getElementById(idInputId).value;
        const dob = document.getElementById(dobInputId).value;

        if (id.length !== 13 || dob === "") {
            clearValidation();
            return true;
        }

        const parts = dob.split("-");

        const expected =
            parts[0].substring(2) +
            parts[1] +
            parts[2];

        if (id.substring(0, 6) !== expected) {

            showValidation("SA ID Number does not match the Date of Birth.");

            return false;
        }

        clearValidation();

        return true;
    }


    function showValidation(message) {

        document.getElementById("idValidation").innerText = message;

    }


    function clearValidation() {

        document.getElementById("idValidation").innerText = "";

    }

</script>