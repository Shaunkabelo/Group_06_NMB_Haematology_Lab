                                    required>

                                <option value="">
                                    Select Supplier
                                </option>

                                @foreach (var supplier in suppliers)
                                {
                                    <option value="@supplier.SupplierId">
                                        @supplier.SupplierName
                                    </option>
                                }

                            </select>

                        </div>

                    </div>


                    <section class="border rounded p-3 mb-4" aria-labelledby="orderLowStockHeading">
                        <h6 id="orderLowStockHeading" class="fw-bold mb-1">Low Stock Consumables</h6>
                        <p class="text-muted small mb-3">Check stock levels here while preparing your order. Select a supplier to show only their consumables.</p>
                        <div class="table-responsive" style="max-height: 240px; overflow-y: auto;">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col">Consumable</th>
                                        <th scope="col">Supplier</th>
                                        <th scope="col">Stock Level</th>
                                        <th scope="col">Reorder Level</th>
                                        <th scope="col">Below Reorder Level</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in lowStockConsumables.OrderBy(c => c.QuantityOnHand))
                                    {
                                        <tr class="order-low-stock-row" data-supplier="@item.SupplierId">
                                            <td><strong>@item.Name</strong></td>
                                            <td>@(item.Supplier?.SupplierName ?? "Unknown")</td>
                                            <td><span class="badge bg-danger">@item.QuantityOnHand</span></td>
                                            <td>@item.ReorderLevel</td>
                                            <td>@Math.Max(0, item.ReorderLevel - item.QuantityOnHand)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <p id="orderLowStockEmpty" class="text-muted small mb-0 mt-2" role="status"
                           hidden="@(lowStockConsumables.Any())">No consumables currently require reordering.</p>
                    </section>
                    <!-- CONSUMABLE SEARCH -->

                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Consumables
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-white">
                                <i class="bi bi-search"></i>
                            </span>

                            <input type="text"
                                   id="consumableSearch"
                                   class="form-control"
                                   placeholder="Search consumables..."
                                   autocomplete="off" />

                        </div>

                    </div>


                    <p id="supplierItemsMessage" class="text-muted" role="status">Select a supplier to see their consumables.</p><!-- CONSUMABLE TABLE -->

                    <div class="table-responsive"
                         style="max-height: 450px;">

                        <table class="table table-hover align-middle"
                               id="consumablesTable">

                            <thead class="table-light sticky-top">

                                <tr>

                                    <th style="width: 50px;">
                                        Select
                                    </th>

                                    <th>
                                        Consumable
                                    </th>

                                    <th>
                                        Stock Level
                                    </th>

                                    <th>
                                        Reorder Level
                                    </th>

                                    <th>
                                        Supplier
                                    </th>

                                    <th style="width: 150px;">
                                        Order Quantity
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var consumable in consumables)
                                {
                                    var isLowStock =
                                    consumable.QuantityOnHand <=
                                    consumable.ReorderLevel;

                                    <tr class="consumable-row @(isLowStock ? "table-danger" : "")"
                                        data-supplier="@consumable.SupplierId" data-name="@consumable.Name.ToLower()">

                                        <td>

                                            <input type="checkbox"
                                                   class="form-check-input consumable-check"
                                                   name="selectedConsumables"
                                                   value="@consumable.ConsumableId"
                                                   data-consumable-id="@consumable.ConsumableId" />

                                        </td>


                                        <td>

                                            <strong>
                                                @consumable.Name
                                            </strong>

                                            @if (isLowStock)
                                            {
                                                <span class="badge bg-danger ms-2">
                                                    Low Stock
                                                </span>
                                            }

                                        </td>


                                        <td>

                                            <span class="fw-semibold @(isLowStock ? "text-danger" : "text-success")">
                                                @consumable.QuantityOnHand
                                            </span>

                                        </td>


                                        <td>
                                            @consumable.ReorderLevel
                                        </td>


                                        <td>

                                            @(consumable.Supplier?.SupplierName ?? "Unknown")

                                        </td>


                                        <td>

                                            <input type="number"
                                                   class="form-control quantity-input"
                                                   name="quantity_@consumable.ConsumableId"
                                                   min="1" max="2147483647" step="1" required
                                                   value=""
                                                   disabled
                                                   placeholder="Qty" />

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>


                    <!-- SELECTED ITEM SUMMARY -->

                    <div class="d-flex justify-content-between align-items-center mt-3 p-3 bg-light rounded">

                        <div>

                            <strong>
                                Selected Items:
                            </strong>

                            <span id="selectedItemCount">
                                0
                            </span>

                        </div>


                        <div>

                            <strong>
                                Total Quantity:
                            </strong>

                            <span id="totalOrderQuantity">
                                0
                            </span>

                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-lg me-1"></i>
                        Create Order

                    </button>

