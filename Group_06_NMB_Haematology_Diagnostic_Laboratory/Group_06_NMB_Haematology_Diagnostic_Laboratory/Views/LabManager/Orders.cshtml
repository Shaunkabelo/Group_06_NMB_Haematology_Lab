    @{
        var orderList = Model?.ToList() ?? new List<Group_06_NMB_Haematology_Diagnostic_Lab.Data.Models.StockOrder>();

        var totalOrders = orderList.Count;

        var orderedOrders = orderList.Count(o =>
        string.Equals(o.Status, "Ordered", StringComparison.OrdinalIgnoreCase));

        var partialOrders = orderList.Count(o =>
        string.Equals(o.Status, "Partially Complete", StringComparison.OrdinalIgnoreCase));

        var completeOrders = orderList.Count(o =>
        string.Equals(o.Status, "Complete", StringComparison.OrdinalIgnoreCase));

        var lowStockCount = lowStockConsumables.Count();
    }

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Total Orders</p>
                            <h3 class="fw-bold mb-0">@totalOrders</h3>
                        </div>

                        <div class="text-primary fs-3">
                            <i class="bi bi-box-seam"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Ordered</p>
                            <h3 class="fw-bold mb-0">@orderedOrders</h3>
                        </div>

                        <div class="text-warning fs-3">
                            <i class="bi bi-clock"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Partially Received</p>
                            <h3 class="fw-bold mb-0">@partialOrders</h3>
                        </div>

                        <div class="text-info fs-3">
                            <i class="bi bi-boxes"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Low Stock</p>
                            <h3 class="fw-bold mb-0">@lowStockCount</h3>
                        </div>

                        <div class="text-danger fs-3">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>


    <!-- ========================================================= -->
    <!-- ORDERS -->
    <!-- ========================================================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white border-0 pt-4 px-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="fw-bold mb-1">Orders</h5>
                    <small class="text-muted">
                        View and manage stock orders.
                    </small>
                </div>

                <div class="d-flex gap-2">

                    <!-- LIVE SEARCH -->
                    <div class="input-group" style="width: 280px;">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               id="orderSearch"
                               class="form-control"
                               placeholder="Search orders..."
                               autocomplete="off" />
                    </div>


                    <!-- SERVER-SIDE FILTER -->
                    <form asp-action="Orders"
                          asp-controller="LabManager"
                          method="get">

                        <select name="filter"
                                class="form-select"
                                onchange="this.form.submit()">

                            <option value="All"
                                    selected="@(currentFilter == "All")">
                                All
                            </option>

                            <option value="Ordered"
                                    selected="@(currentFilter == "Ordered")">
                                Ordered
                            </option>

                            <option value="Partially Complete"
                                    selected="@(currentFilter == "Partially Complete")">
                                Partially Received
                            </option>

                            <option value="Complete"
                                    selected="@(currentFilter == "Complete")">
                                Received
                            </option>

                            <option value="Cancelled"
                                    selected="@(currentFilter == "Cancelled")">
                                Cancelled
                            </option>

                        </select>

                    </form>

                </div>

            </div>

        </div>


        <div class="card-body px-4">

            <div class="table-responsive">

                <table class="table table-hover align-middle"
                       id="ordersTable">

                    <thead class="table-light">

                        <tr>
                            <th>Order Number</th>
                            <th>Supplier</th>
                            <th>Order Date</th>
                            <th>Items</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (!orderList.Any())
                        {
                            <tr id="noOrdersRow">
                                <td colspan="6"
                                    class="text-center py-5 text-muted">

                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>

                                    No stock orders found.

                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var order in orderList)
                            {
                                var statusClass =
                                order.Status?.ToLower() switch
                                {
                                    "ordered" => "bg-warning text-dark",
                                    "partially complete" => "bg-info text-dark",
                                    "complete" => "bg-success",
                                    "cancelled" => "bg-danger",
                                    _ => "bg-secondary"
                                };

                                <tr class="stock-order-row">

                                    <td>
                                        <strong>
                                            @order.OrderNumber
                                        </strong>
                                    </td>

                                    <td>
                                        @(order.Supplier?.SupplierName ?? "Unknown")
                                    </td>

                                    <td>
                                        @(order.OrderDate?.ToString("dd MMM yyyy") ?? "-")
                                    </td>

                                    <td>
                                        @(order.StockOrderItem?.Count ?? 0)
                                    </td>

                                    <td>
                                        <span class="badge @statusClass">
                                            @OrderStatusLabels.Display(order.Status)
                                        </span>
                                    </td>

                                    <td class="text-end">

                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                onclick="viewOrder(@order.StockOrderId)">

                                            <i class="bi bi-eye me-1"></i>
                                            View

                                        </button>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

            <div id="noSearchResults"
                 class="text-center text-muted py-4 d-none">

                No orders match your search.

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- LOW STOCK -->
    <!-- ========================================================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 pt-4 px-4">

            <div>
                <h5 class="fw-bold mb-1">
                    Low Stock Consumables
                </h5>

                <small class="text-muted">
                    Consumables currently at or below their reorder level.
                </small>
            </div>

        </div>


        <div class="card-body px-4">

            <div class="table-responsive">

                <table class="table align-middle">

                    <thead class="table-light">

                        <tr>
                            <th>Consumable</th>
                            <th>Supplier</th>
                            <th>Stock Level</th>
                            <th>Reorder Level</th>
                            <th>Difference</th>
                        </tr>

                    </thead>

                    <tbody>

                        @{
                            var lowStockItems =
                            lowStockConsumables
                            .OrderBy(c => c.QuantityOnHand)
                            .ToList();
                        }

                        @if (!lowStockItems.Any())
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center text-success py-4">

                                    <i class="bi bi-check-circle fs-4 me-2"></i>
                                    No consumables currently require reordering.

                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var consumable in lowStockItems)
                            {
                                var difference =
                                consumable.ReorderLevel -
                                consumable.QuantityOnHand;

                                <tr>

                                    <td>
                                        <strong>
                                            @consumable.Name
                                        </strong>
                                    </td>

                                    <td>
                                        @(consumable.Supplier?.SupplierName ?? "Unknown")
                                    </td>

                                    <td>

                                        <span class="badge bg-danger">
                                            @consumable.QuantityOnHand
                                        </span>

                                    </td>

                                    <td>
                                        @consumable.ReorderLevel
                                    </td>

                                    <td>
                                        <span class="text-danger fw-semibold">
                                            -@difference
                                        </span>
                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
</div>

