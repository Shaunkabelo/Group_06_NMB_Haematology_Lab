@model IEnumerable<string[]>
@{
    Layout = "~/Views/Shared/_LabManager_Layout.cshtml";
    var headings = ViewBag.Headings as string[] ?? Array.Empty<string>();
    var generatedAt = (DateTimeOffset)ViewBag.GeneratedAt;
    var generatedBy = ViewBag.GeneratedBy as string ?? "Lab Manager";
    var startDate = ViewBag.StartDate as DateTime?;
    var endDate = ViewBag.EndDate as DateTime?;
    var isTestsReport = string.Equals(ViewBag.ReportType as string, "tests", StringComparison.OrdinalIgnoreCase);
    var dailyVolumes = ViewBag.DailyVolumes as IEnumerable<Group_06_NMB_Haematology_Diagnostic_Laboratory.Services.TestReportInsights.DailyVolume>
        ?? Enumerable.Empty<Group_06_NMB_Haematology_Diagnostic_Laboratory.Services.TestReportInsights.DailyVolume>();
    var consumableUsage = ViewBag.ConsumableUsage as IEnumerable<Group_06_NMB_Haematology_Diagnostic_Laboratory.Services.TestReportInsights.ConsumableUsage>
        ?? Enumerable.Empty<Group_06_NMB_Haematology_Diagnostic_Laboratory.Services.TestReportInsights.ConsumableUsage>();
}

<div class="page-body report-page">
    <div class="section-header">
        <div>
            <h2>Report Preview</h2>
            <small>Review the selected data before downloading the PDF.</small>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="ManagerReports" asp-route-reportType="@ViewBag.ReportType"
               asp-route-startDate="@startDate?.ToString("yyyy-MM-dd")" asp-route-endDate="@endDate?.ToString("yyyy-MM-dd")"
               asp-route-orderStatus="@ViewBag.OrderStatus" asp-route-lowStockOnly="@ViewBag.LowStockOnly"
               class="btn btn-secondary">Change criteria</a>
            <form asp-action="DownloadReport" method="get" target="_blank">
                <input type="hidden" name="reportType" value="@ViewBag.ReportType" />
                @if (startDate.HasValue)
                {
                    <input type="hidden" name="startDate" value="@startDate.Value.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="endDate" value="@endDate!.Value.ToString("yyyy-MM-dd")" />
                }
                <input type="hidden" name="orderStatus" value="@ViewBag.OrderStatus" />
                <input type="hidden" name="lowStockOnly" value="@ViewBag.LowStockOnly" />
                <button class="btn btn-primary" type="submit">Open PDF</button>
            </form>
        </div>
    </div>

    <article class="report-card report-preview-card">
        <div class="report-card-content">
            <p class="panel-kicker">Preview</p>
            <h3>@ViewBag.ReportTitle</h3>
            <p class="mb-1"><strong>Generated by:</strong> @generatedBy</p>
            <p class="mb-1"><strong>Generated:</strong> @generatedAt.ToString("dd MMM yyyy HH:mm") SAST</p>
            <p class="mb-1"><strong>Criteria:</strong> @ViewBag.Criteria</p>
            <p class="mb-4"><strong>Summary:</strong> @ViewBag.Summary</p>

            @if (Model.Any())
            {
                @if (isTestsReport)
                {
                    <section class="mb-4">
                        <h4 class="h5 mb-2">Tests completed per date</h4>
                        @if (dailyVolumes.Any())
                        {
                            <div class="table-wrap">
                                <table>
                                    <thead><tr><th>Completion date</th><th>Tests completed</th></tr></thead>
                                    <tbody>
                                    @foreach (var day in dailyVolumes)
                                    {
                                        <tr><td>@day.Date.ToString("dd MMM yyyy")</td><td>@day.TestsCompleted.ToString("N0")</td></tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>
                    @foreach (var category in Model.GroupBy(row => row.ElementAtOrDefault(0) ?? "Uncategorised"))
                    {
                        <section class="mb-4">
                            <h4 class="h5 mb-2">Category: @category.Key</h4>
                            <ol class="mb-0">
                                @foreach (var test in category)
                                {
                                    <li>@test.ElementAtOrDefault(1) <span class="text-muted">— completed @test.ElementAtOrDefault(2)</span></li>
                                }
                            </ol>
                        </section>
                    }
                    <section>
                        <h4 class="h5 mb-1">Estimated consumables used</h4>
                        <p class="text-muted small">Estimate based on the consumable quantity currently configured for each completed test type. This is not a stock-transaction audit.</p>
                        @if (consumableUsage.Any())
                        {
                            <div class="table-wrap">
                                <table>
                                    <thead><tr><th>Consumable</th><th>Estimated units used</th><th>Tests contributing</th></tr></thead>
                                    <tbody>
                                    @foreach (var item in consumableUsage)
                                    {
                                        <tr><td>@item.ConsumableName</td><td>@item.EstimatedUnitsUsed.ToString("N0")</td><td>@item.TestsContributing.ToString("N0")</td></tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="mb-0">No configured consumable requirements were available for the completed tests.</p>
                        }
                    </section>
                }
                else
                {
                    <div class="table-wrap">
                        <table>
                            <thead><tr>@foreach (var heading in headings) { <th>@heading</th> }</tr></thead>
                            <tbody>
                                @foreach (var row in Model)
                                {
                                    <tr>@foreach (var value in row) { <td>@value</td> }</tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-info mb-0" role="status">No records were found for the selected criteria.</div>
            }
        </div>
    </article>
</div>
