@model IEnumerable<string[]>
@{
    
    Layout = "~/Views/Shared/_LabManager_Layout.cshtml";
    var headings = ViewBag.Headings as string[] ?? Array.Empty<string>();
    var generatedAt = (DateTimeOffset)ViewBag.GeneratedAt;
    var startDate = ViewBag.StartDate as DateTime?;
    var endDate = ViewBag.EndDate as DateTime?;
}

<div class="page-body report-page">
    <div class="section-header">
        <div>
            <h2>Report Preview</h2>
            <small>Review the selected data before downloading the PDF.</small>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="ManagerReports" asp-route-reportType="@ViewBag.ReportType" asp-route-startDate="@startDate?.ToString("yyyy-MM-dd")"
               asp-route-endDate="@endDate?.ToString("yyyy-MM-dd")" asp-route-orderStatus="@ViewBag.OrderStatus"
               asp-route-lowStockOnly="@ViewBag.LowStockOnly" class="btn btn-secondary">Change criteria</a>
            <form asp-action="DownloadReport" method="get">
                <input type="hidden" name="reportType" value="@ViewBag.ReportType" />
                @if (startDate.HasValue)
                {
                    <input type="hidden" name="startDate" value="@startDate.Value.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="endDate" value="@endDate!.Value.ToString("yyyy-MM-dd")" />
                }
                <input type="hidden" name="orderStatus" value="@ViewBag.OrderStatus" />
                <input type="hidden" name="lowStockOnly" value="@ViewBag.LowStockOnly" />
                <button class="btn btn-primary" type="submit">Download PDF</button>
            </form>
        </div>
    </div>

    <article class="report-card report-preview-card">
        <div class="report-card-content">
            <p class="panel-kicker">Preview</p>
            <h3>@ViewBag.ReportTitle</h3>
            <p class="mb-1"><strong>Generated:</strong> @generatedAt.ToString("dd MMM yyyy HH:mm") SAST</p>
            <p class="mb-1"><strong>Criteria:</strong> @ViewBag.Criteria</p>
            <p class="mb-4"><strong>Summary:</strong> @ViewBag.Summary</p>

            @if (Model.Any())
            {
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                @foreach (var heading in headings)
                                {
                                    <th>@heading</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model)
                            {
                                <tr>
                                    @foreach (var value in row)
                                    {
                                        <td>@value</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0" role="status">No records were found for the selected criteria. You can adjust the criteria or download the PDF with this message.</div>
            }
        </div>
    </article>
</div>
