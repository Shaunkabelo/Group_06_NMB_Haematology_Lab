@using Group_06_NMB_Haematology_Diagnostic_Lab.Data.Models
@model IEnumerable<TestCategory>

@{
    Layout = "~/Views/Shared/_LabManager_Layout.cshtml";
}

<div class="page-body">

    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <div class="section-header">

        <div>
            <h2>Test Categories</h2>
            <small>Manage registered laboratory test categories.</small>
        </div>

        <div style="display:flex; gap:10px; align-items:center;">

            <!-- SEARCH -->

            <form asp-controller="LabManager"
                  asp-action="TestCategories"
                  method="get"
                  id="categorySearchForm">

                <input type="hidden"
                       name="filter"
                       value="@ViewBag.Filter" />

                <input type="text"
                       id="categorySearch"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Search categories..."
                       autocomplete="off" />

            </form>


            <!-- FILTER -->

            <form asp-controller="LabManager"
                  asp-action="TestCategories"
                  method="get">

                <input type="hidden"
                       name="search"
                       value="@ViewBag.Search" />

                <select id="filterSelect"
                        name="filter"
                        class="form-select @(ViewBag.Filter == "Active" ? "filter-active" : ViewBag.Filter == "Inactive" ? "filter-inactive" : "filter-all")"
                        onchange="this.form.submit()">

                    @if (ViewBag.Filter == "Active")
                    {
                        <option value="Active" selected>Active</option>
                    }
                    else
                    {
                        <option value="Active">Active</option>
                    }

                    @if (ViewBag.Filter == "Inactive")
                    {
                        <option value="Inactive" selected>Inactive</option>
                    }
                    else
                    {
                        <option value="Inactive">Inactive</option>
                    }

                    @if (ViewBag.Filter == "All")
                    {
                        <option value="All" selected>All</option>
                    }
                    else
                    {
                        <option value="All">All</option>
                    }

                </select>

            </form>


            <!-- ADD CATEGORY -->

            <button class="btn btn-primary"
                    onclick="openCreateCategory()"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#categoryPanel">

                Add Category

            </button>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- CATEGORY TABLE -->
    <!-- ========================================================= -->

    <div class="table-wrap">

        <table>

            <thead>

                <tr>

                    <th>Category Name</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Actions</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var category in Model)
                {
                    <tr>

                        <td>
                            @category.CategoryName
                        </td>

                        <td>
                            @category.CategoryDescription
                        </td>

                        <td>
                            @(category.IsActive ? "Active" : "Inactive")
                        </td>

                        <td class="td-actions">

                            <!-- EDIT -->

                            <button type="button"
                                    class="btn btn-edit btn-sm"
                                    data-bs-toggle="offcanvas"
                                    data-bs-target="#categoryPanel"
                                    onclick="openEditCategory(this)"
                                    data-id="@category.TestCategoryId"
                                    data-name="@category.CategoryName"
                                    data-description="@category.CategoryDescription">

                                Edit

                            </button>


                            @if (category.IsActive)
                            {
                                <!-- DELETE / DEACTIVATE -->

                                <form asp-action="DeleteTestCategory"
                                      asp-controller="LabManager"
                                      method="post"
                                      style="display:inline;">

                                    <input type="hidden"
                                           name="id"
                                           value="@category.TestCategoryId" />

                                    <input type="hidden"
                                           name="filter"
                                           value="@ViewBag.Filter" />

                                    <input type="hidden"
                                           name="search"
                                           value="@ViewBag.Search" />

                                    <button type="submit"
                                            class="btn btn-delete btn-sm"
                                            onclick="return confirm('Are you sure you want to deactivate this test category?');">

                                        Deactivate

                                    </button>

                                </form>
                            }
                            else
                            {
                                <!-- REACTIVATE -->

                                <form asp-action="ReactivateTestCategory"
                                      asp-controller="LabManager"
                                      method="post"
                                      style="display:inline;">

                                    <input type="hidden"
                                           name="id"
                                           value="@category.TestCategoryId" />

                                    <input type="hidden"
                                           name="filter"
                                           value="@ViewBag.Filter" />

                                    <input type="hidden"
                                           name="search"
                                           value="@ViewBag.Search" />

                                    <button type="submit"
                                            class="btn btn-primary btn-sm"
                                            onclick="return confirm('Are you sure you want to reactivate this test category?');">

                                        Reactivate

                                    </button>

                                </form>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>


<!-- ========================================================= -->
<!-- ADD / EDIT CATEGORY OFFCANVAS -->
<!-- ========================================================= -->

<div class="offcanvas offcanvas-end"
     tabindex="-1"
     id="categoryPanel"
     style="width:600px;">

    <div class="offcanvas-header">

        <h4 id="categoryPanelTitle">
            Add Test Category
        </h4>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="offcanvas">
        </button>

    </div>


    <div class="offcanvas-body">

        <form id="categoryForm" data-staff-validation
              asp-controller="LabManager"
              asp-action="CreateTestCategory"
              method="post">

            <!-- CATEGORY ID -->

            <input type="hidden"
                   id="TestCategoryId"
                   name="TestCategoryId"
                   value="0" />


            <!-- CATEGORY NAME -->

            <div class="form-group">

                <label class="form-label">
                    Category Name
                </label>

                <input id="CategoryName"
                       class="form-control"
                       name="CategoryName"
                       required />

            </div>


            <!-- DESCRIPTION -->

            <div class="form-group">

                <label class="form-label">
                    Description
                </label>

                <textarea id="CategoryDescription"
                          class="form-control"
                          name="CategoryDescription"
                          rows="4"></textarea>

            </div>


            <!-- BUTTONS -->

            <button id="categorySubmitButton"
                    type="submit"
                    class="btn btn-primary">

                Save Category

            </button>


            <button type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="offcanvas">

                Cancel

            </button>

        </form>

    </div>

</div>


<!-- ========================================================= -->
<!-- JAVASCRIPT -->
<!-- ========================================================= -->

<script>

    // =========================================================
    // LIVE SEARCH
    // =========================================================

    let searchTimer;

    const categorySearch =
        document.getElementById("categorySearch");

    if (categorySearch)
    {
        categorySearch.focus();

        const searchLength = categorySearch.value.length;

        categorySearch.setSelectionRange(
            searchLength,
            searchLength
        );

        categorySearch.addEventListener("input", function ()
        {
            clearTimeout(searchTimer);

            searchTimer = setTimeout(function ()
            {
                document.getElementById("categorySearchForm").submit();

            }, 400);
        });
    }


    // =========================================================
    // CREATE CATEGORY
    // =========================================================

    function openCreateCategory()
    {
        document.getElementById("categoryPanelTitle").innerText =
            "Add Test Category";

        document.getElementById("categorySubmitButton").innerText =
            "Save Category";

        document.getElementById("categoryForm").action =
            '@Url.Action("CreateTestCategory", "LabManager")';

        document.getElementById("categoryForm").reset();

        document.getElementById("TestCategoryId").value = "0";
    }


    // =========================================================
    // EDIT CATEGORY
    // =========================================================

    function openEditCategory(button)
    {
        document.getElementById("categoryPanelTitle").innerText =
            "Edit Test Category";

        document.getElementById("categorySubmitButton").innerText =
            "Update Category";

        document.getElementById("categoryForm").action =
            '@Url.Action("EditTestCategory", "LabManager")';


        document.getElementById("TestCategoryId").value =
            button.dataset.id;

        document.getElementById("CategoryName").value =
            button.dataset.name;

        document.getElementById("CategoryDescription").value =
            button.dataset.description;
    }

</script>

