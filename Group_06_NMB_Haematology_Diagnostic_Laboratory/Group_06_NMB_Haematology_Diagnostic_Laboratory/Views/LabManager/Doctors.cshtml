@using Group_06_NMB_Haematology_Diagnostic_Lab.Data.Models
@model IEnumerable<Doctor>
@{
    Layout = "~/Views/Shared/_LabManager_Layout.cshtml";
}
<div class="page-body">
    <div class="section-header">
        <div><h2>Doctors</h2><small>Manage registered doctors.</small></div>
        <button class="btn btn-primary" data-bs-toggle="offcanvas" data-bs-target="#addDoctorPanel">Add Doctor</button>
    </div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Name</th><th>Surname</th><th>Email</th><th>Cellphone</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var doctor in Model)
                {
                    <tr>
                        
                        <td>@doctor.User.Name</td>
                        <td>@doctor.User.Surname</td>
                        <td>@doctor.User.Email</td>
                        <td>@doctor.User.Cellphone</td>
                        
                        <td>@(doctor.User.IsActive ? "Active" : "Inactive")</td>
                        <td class="td-actions">
                            <a asp-action="EditDoctor" asp-route-id="@doctor.DoctorId" class="btn btn-edit btn-sm">Edit</a>
                            <a asp-action="DeleteDoctor" asp-route-id="@doctor.DoctorId" class="btn btn-delete btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="addDoctorPanel" style="width:600px;">
    <div class="offcanvas-header"><h4>Add Doctor</h4><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
    <div class="offcanvas-body">
        <form asp-action="CreateDoctor" asp-controller="LabManager" method="post">
            <div class="form-group"><label class="form-label">First Name</label><input class="form-control" name="User.Name" required></div>
            <div class="form-group"><label class="form-label">Surname</label><input class="form-control" name="User.Surname" required></div>
            <div class="form-group"><label class="form-label">Email</label><input type="email" class="form-control" name="User.Email" required></div>
            <div class="form-row">
                <div class="form-group"><label class="form-label">Cellphone</label><input class="form-control" name="User.Cellphone"></div>
                <div class="form-group"><label class="form-label">Date of Birth</label><input type="date" class="form-control" name="User.DateOfBirth"></div>
            </div>
            <div class="form-group"><label class="form-label">SA ID</label><input class="form-control" maxlength="13" name="User.SaIdNumber"></div>
            <div class="form-group"><label class="form-label">Home Address</label><textarea class="form-control" name="User.HomeAddress"></textarea></div>
            <div class="form-group"><label class="form-label">HPCSA Number</label><input class="form-control" name="HpcsaNumber" required></div>
            <button type="submit" class="btn btn-primary">Save Doctor</button>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="offcanvas">Cancel</button>
        </form>
    </div>
</div>