@{
    ViewData["Title"] = "NMB-HLabSys";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="landing-shell">
    <nav class="landing-nav">
        <a class="landing-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">HL</span> NMB-HLabSys</a>
        <a class="landing-login" data-auth-transition asp-controller="Account" asp-action="Login">Sign in <span aria-hidden="true">→</span></a>
    </nav>

    <main class="landing-content">
        <div class="landing-copy">
            <p class="auth-eyebrow">Nelson Mandela Bay Haematology Diagnostic Laboratory</p>
            <h1>One clear place for the work behind every result.</h1>
            <p class="landing-lede">NMB-HLabSys brings test catalogues, staff management and consumable control into one focused laboratory workspace.</p>
            <a class="landing-cta" data-auth-transition asp-controller="Account" asp-action="Login">Enter the workspace <span aria-hidden="true">↗</span></a>
        </div>
        <div class="landing-visual" aria-hidden="true">
            <div class="visual-line visual-line-one"></div>
            <div class="visual-line visual-line-two"></div>
            <div class="visual-label visual-label-one">CATALOGUE</div>
            <div class="visual-label visual-label-two">PEOPLE</div>
            <div class="visual-label visual-label-three">STOCK</div>
        </div>
    </main>

    <footer class="landing-footer">
        <div><strong>NMB-HLabSys</strong><span>Laboratory management system · Group 06</span></div>
        <div class="support-inline"><strong>Need help?</strong><span>Contact your laboratory administrator</span></div>
    </footer>
</div>
