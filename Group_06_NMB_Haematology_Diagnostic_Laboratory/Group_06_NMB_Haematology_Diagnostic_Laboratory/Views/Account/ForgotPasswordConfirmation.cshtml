@{
    ViewData["Title"] = "Check your email";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
<h2>Check your email</h2>
<p class="notice" role="status">If an active account exists for that email address, we will send a password reset link.</p>
<p class="muted">The link expires in 30 minutes. Check your spam folder too. If it does not arrive, wait a minute before trying again or contact your administrator.</p>
<a class="back" asp-action="Login">Back to sign in</a>
<a class="back" asp-action="ForgotPassword">Request another link</a>
