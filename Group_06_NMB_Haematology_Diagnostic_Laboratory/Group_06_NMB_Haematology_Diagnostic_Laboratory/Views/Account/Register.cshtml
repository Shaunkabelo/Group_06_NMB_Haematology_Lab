@{
    ViewData["Title"] = "Register";
}
<div id="register-panel">
    <section class="card">
        <div class="card-header"><span class="card-title">Create Patient Account</span></div>
        <div class="card-body">
            <form onsubmit="(function(){ savePatientAccount(); setTimeout(() => { if (DEMO_USERS.some(u => u.email === (document.getElementById('signup-email')?.value || '').toLowerCase())) window.location.href = '/Account/Login'; }, 700); return false; })()">
                <div class="form-group">
                    <label class="form-label">Full Name *</label>
                    <input class="form-control" id="signup-name" placeholder="e.g. Sabelo Maphumulo" required>
                </div>
                <div class="form-group">
                    <label class="form-label">Email Address *</label>
                    <input class="form-control" id="signup-email" type="email" placeholder="patient@example.com" required>
                </div>
                <div class="form-group">
                    <label class="form-label">Password *</label>
                    <div class="password-field">
                        <input class="form-control" id="signup-password" type="password" placeholder="Create a password" minlength="8" pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\\d).{8,}" required>
                        <button class="btn btn-secondary btn-icon" type="button" onclick="togglePassword('signup-password', this)">👁</button>
                    </div>
                    <div class="form-hint">Min 8 chars, 1 uppercase, 1 number</div>
                </div>
                <div class="form-group">
                    <label class="form-label">Confirm Password *</label>
                    <div class="password-field">
                        <input class="form-control" id="signup-confirm" type="password" placeholder="Confirm password" minlength="8" required>
                        <button class="btn btn-secondary btn-icon" type="button" onclick="togglePassword('signup-confirm', this)">👁</button>
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" type="submit">Create Account</button>
                    <a class="btn btn-link" href="/Account/Login">Cancel</a>
                </div>
            </form>
        </div>
    </section>
</div>
