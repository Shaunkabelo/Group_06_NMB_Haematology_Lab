@{
    ViewData["Title"] = "Forgot password";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
<h2>Forgot your password?</h2>
<p class="muted">Enter your account email and we will send you a link to choose a new password.</p>
<form asp-action="ForgotPassword" method="post">
    <div asp-validation-summary="All" class="error" role="alert"></div>
    <label for="email">Email address</label>
    <input id="email" name="email" type="email" maxlength="150" autocomplete="username" required autofocus />
    <button class="primary" type="submit">Send reset link</button>
</form>
<a class="back" asp-action="Login">Back to sign in</a>
