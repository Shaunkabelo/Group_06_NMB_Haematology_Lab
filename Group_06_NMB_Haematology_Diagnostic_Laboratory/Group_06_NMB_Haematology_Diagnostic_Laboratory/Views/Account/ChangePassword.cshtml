@{
    ViewData["Title"] = "Change password";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
<h2>Change your password</h2>
@if (User.HasClaim("MustChangePassword", "True")) { <p class="notice">Please replace your temporary password before continuing.</p> }
<form asp-action="ChangePassword" method="post">
    <div asp-validation-summary="All" class="error" role="alert"></div>
    <label for="currentPassword">Current password</label>
    <div class="password-field"><input id="currentPassword" name="currentPassword" type="password" maxlength="128" autocomplete="current-password" required /><button type="button" data-password-toggle="currentPassword" aria-label="Show password" aria-pressed="false"></button></div>
    <partial name="_NewPasswordFields" />
    <button class="primary" type="submit">Change password</button>
</form>
<form asp-action="Logout" method="post"><button class="back" type="submit">Sign out</button></form>

@if (!User.HasClaim("MustChangePassword", "True")) { <a class="back" asp-controller="Account" asp-action="Profile">Back to my profile</a> }
