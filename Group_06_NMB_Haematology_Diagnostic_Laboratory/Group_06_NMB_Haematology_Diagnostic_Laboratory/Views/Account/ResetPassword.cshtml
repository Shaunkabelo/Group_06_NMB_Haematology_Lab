@{
    ViewData["Title"] = "Reset password";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
<h2>Choose a new password</h2>
<p class="muted">After resetting your password, sign in again on your devices.</p>
<form asp-action="ResetPassword" method="post">
    <input type="hidden" name="token" value="@ViewData["Token"]" />
    <div asp-validation-summary="All" class="error" role="alert"></div>
    <partial name="_NewPasswordFields" />
    <button class="primary" type="submit">Reset password</button>
</form>
<a class="back" asp-action="ForgotPassword">Request a new reset link</a>
<a class="back" asp-action="Login">Back to sign in</a>
