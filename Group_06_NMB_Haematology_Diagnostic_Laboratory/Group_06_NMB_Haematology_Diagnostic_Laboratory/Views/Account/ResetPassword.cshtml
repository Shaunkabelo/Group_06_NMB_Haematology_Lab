@{
    Layout = null;
    ViewData["Title"] = "Reset Password";
}

<div id="reset-panel" class="reset-panel">
    <div class="section-sub">Use the demo OTP code to set a new password for an existing account.</div>

    <div class="form-group">
        <label class="form-label" for="reset-email">Email Address <span class="required">*</span></label>
        <input class="form-control" id="reset-email" type="email" placeholder="you@example.com" autocomplete="email" required>
    </div>

    <div class="form-group">
        <label class="form-label" for="reset-otp">OTP Code <span class="required">*</span></label>
        <input class="form-control" id="reset-otp" type="text" inputmode="numeric" maxlength="5" placeholder="12340" required>
        <div class="form-hint">Use code <strong>12340</strong> for this prototype.</div>
    </div>

    <div class="form-group">
        <label class="form-label" for="reset-password">New Password <span class="required">*</span></label>
        <div class="password-field">
            <input class="form-control" id="reset-password" type="password" placeholder="New password" autocomplete="new-password" required>
            <button class="btn btn-secondary btn-icon" type="button" onclick="togglePassword('reset-password', this)" aria-label="Toggle password visibility">👁</button>
        </div>
        <div class="form-hint">Use 8+ characters, uppercase, lowercase, number and special character.</div>
    </div>

    <div class="form-group">
        <label class="form-label" for="reset-confirm">Confirm Password <span class="required">*</span></label>
        <div class="password-field">
            <input class="form-control" id="reset-confirm" type="password" placeholder="Confirm password" autocomplete="new-password" required>
            <button class="btn btn-secondary btn-icon" type="button" onclick="togglePassword('reset-confirm', this)" aria-label="Toggle confirm password visibility">👁</button>
        </div>
    </div>
</div>
