@{
    Layout = "_TechLayout";
}
@model TechReceiveIndexModel
@{
    ViewData["Title"] = "Receive Samples";
}

<div class="topbar">
    <h1 class="page-title">Receive Samples</h1>
</div>

<div class="page-body">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <!-- Pending Requests -->
    <section>
        <div class="card">
            <div class="card-header">
                <span class="card-title">📋 Submitted Requests — Awaiting Sample Receipt</span>
                <span class="badge amber">@Model.PendingRequests.Count pending</span>
            </div>
            <p style="font-size:12px;color:#7A8CA0;padding:8px 16px 0;margin:0">
                ▶ Click a request row to expand and receive its samples.
            </p>
            <div style="padding:10px 16px">
                <select class="form-control"
                        style="width:200px"
                        aria-label="Filter pending requests by urgency"
                        onchange="filterUrgency(this,'receive-pending-table')">
                    <option value="">All Requests</option>
                    <option value="STAT">STAT only</option>
                    <option value="Urgent">Urgent only</option>
                    <option value="Routine">Routine only</option>
                </select>
            </div>
            <div class="table-wrap">
                <table id="receive-pending-table">
                    <thead>
                        <tr>
                            <th style="width:170px">Request No.</th>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Urgency</th>
                            <th>Tests</th>
                            <th>Overall Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var req in Model.PendingRequests)
                        {
                            var subId = $"sub-{req.TestRequestId}";
                            var urgencyBadge = req.Urgency switch { "STAT" => "red", "Urgent" => "amber", _ => "gray" };
                            var statusBadge = req.Status == "Partial Receipt" ? "amber" : "blue";

                            <tr class="req-row"
                                data-urgency="@req.Urgency"
                                onclick="toggleReqRow('@subId',this)">
                                <td class="td-bold"><span class="expand-icon">▶</span>@req.RequestNumber</td>
                                <td>@req.PatientName</td>
                                <td>@req.DoctorName</td>
                                <td><span class="badge @urgencyBadge">@req.Urgency</span></td>
                                <td><span class="badge gray">@req.Tests.Count test@(req.Tests.Count == 1 ? "" : "s")</span></td>
                                <td><span class="badge @statusBadge">@req.Status</span></td>
                            </tr>
                            <tr class="tests-subrow" id="@subId">
                                <td colspan="6">
                                    <table class="sub-tests-table">
                                        <thead>
                                            <tr>
                                                <th style="padding-left:36px">Sample Type</th>
                                                <th>Tests Requiring It</th>
                                                <th>Status</th>
                                                <th style="width:320px">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var s in req.Samples)
                                            {
                                                <tr>
                                                    <td class="td-bold">@s.SampleTypeName</td>

                                                    <td>@s.TestsRequiringSample</td>

                                                    <td>
                                                        @if (s.SampleReceived)
                                                        {
                                                            <span class="badge teal">Received</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge amber">Pending</span>
                                                        }
                                                    </td>

                                                    <td>
                                                        @if (!s.SampleReceived)
                                                        {
                                                            <div style="display:flex;gap:8px;flex-wrap:wrap"
                                                                 onclick="event.stopPropagation()">

                                                                <form asp-controller="TechReceive"
                                                                      asp-action="ReceiveSample"
                                                                      method="post"
                                                                      style="display:flex;gap:8px;align-items:center">

                                                                    <input type="hidden"
                                                                           name="sampleId"
                                                                           value="@s.SampleId" />

                                                                    <input type="hidden"
                                                                           name="testRequestId"
                                                                           value="@req.TestRequestId" />

                                                                    <input type="hidden"
                                                                           name="sampleTypeId"
                                                                           value="@s.SampleTypeId" />

                                                                    <input type="text"
                                                                           name="barcodeNumber"
                                                                           class="form-control form-control-sm"
                                                                           value="@s.BarcodeNumber"
                                                                           required
                                                                           maxlength="50"
                                                                           aria-label="Barcode"
                                                                           style="max-width:180px" />

                                                                    <button type="submit"
                                                                            class="btn btn-sm btn-success">
                                                                        Receive
                                                                    </button>
                                                                </form>

                                                                <button type="button"
                                                                        class="btn btn-sm"
                                                                        style="background-color:#dc3545;color:#fff;border:1px solid #dc3545"
                                                                        data-sample-id="@s.SampleId"
                                                                        data-barcode="@s.BarcodeNumber"
                                                                        onclick="openRejectModal(this)">
                                                                    Reject Sample
                                                                </button>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span>@s.BarcodeNumber</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- Recently Received -->
    <section>
        <div class="card">
            <div class="card-header"><span class="card-title">✅ Recently Received (Today)</span></div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th style="width:170px">Request No.</th>
                            <th>Patient</th>
                            <th>Barcode</th>
                            <th>Sample Type</th>
                            <th>Received At</th>
                            <th>By</th>
                            <th>Request Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.RecentlyReceived)
                        {
                            <tr>
                                <td class="td-bold">@r.RequestNumber</td>
                                <td>@r.PatientName</td>
                                <td><span class="badge gray">@r.BarcodeNumber</span></td>
                                <td>@r.SampleTypeName</td>
                                <td>@r.DateTimeReceived?.ToString("HH:mm")</td>
                                <td>@r.ReceivedByName</td>
                                <td><span class="badge blue">@r.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

</div>
<div id="reject-modal-overlay"
     style="display:none;position:fixed;inset:0;
            background:rgba(11,25,41,0.5);z-index:1000;
            align-items:center;justify-content:center">

    <div style="background:#fff;border-radius:12px;
                width:92%;max-width:520px;
                max-height:85vh;overflow-y:auto">

        <div style="padding:16px 20px;border-bottom:1px solid #EAEEF2;
                    display:flex;justify-content:space-between;
                    align-items:center">
            <strong>Reject Sample</strong>

            <button type="button"
                    onclick="closeRejectModal()"
                    aria-label="Close rejection dialog"
                    style="background:none;border:none;
                           font-size:22px;cursor:pointer">
                ×
            </button>
        </div>

        <form id="reject-sample-form"
              asp-controller="TechReceive"
              asp-action="RejectSample"
              method="post">

            <input type="hidden"
                   name="sampleId"
                   id="reject-sample-id" />

            <div style="padding:20px">
                <div style="margin-bottom:14px">
                    <strong>Barcode:</strong>
                    <span id="reject-sample-barcode"></span>
                </div>

                <label class="form-label"
                       for="reject-reason">
                    Rejection Reason *
                </label>

                <textarea id="reject-reason"
                          name="reason"
                          class="form-control"
                          rows="4"
                          required
                          maxlength="1000"></textarea>
            </div>

            <div style="padding:16px 20px;border-top:1px solid #EAEEF2;
                        display:flex;justify-content:flex-end;gap:10px">

                <button type="button"
                        class="btn btn-secondary"
                        onclick="closeRejectModal()">
                    Cancel
                </button>

                <button type="submit"
                        class="btn btn-primary">
                    Confirm Rejection
                </button>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <script>
                function openRejectModal(button) {
            const form = document.getElementById('reject-sample-form');

            form.reset();

            document.getElementById('reject-sample-id').value =
                button.dataset.sampleId;

            document.getElementById('reject-sample-barcode').textContent =
                button.dataset.barcode;

            document.getElementById('reject-modal-overlay').style.display =
                'flex';

            document.getElementById('reject-reason').focus();
        }

        function closeRejectModal() {
            document.getElementById('reject-modal-overlay').style.display =
                'none';
        }
            function filterUrgency(select, tableId) {
            const table = document.getElementById(tableId);
            if (!table) return;

            const selected = select.value.trim().toLowerCase();

            Array.from(table.tBodies).forEach(tbody => {
                Array.from(tbody.rows).forEach(row => {
                    if (!row.hasAttribute('data-urgency')) return;

                    const urgency =
                        (row.dataset.urgency || '').trim().toLowerCase();

                    const show = selected === '' || urgency === selected;

                    if (show) {
                        row.style.removeProperty('display');
                    } else {
                        row.style.setProperty('display', 'none', 'important');
                    }

                    const details = row.nextElementSibling;

                    if (details &&
                        details.classList.contains('tests-subrow')) {
                        if (show) {
                            details.style.removeProperty('display');
                        } else {
                            details.style.setProperty(
                                'display', 'none', 'important'
                            );
                        }
                    }
                });
            });
        }
        function toggleReqRow(subId, rowEl) {
            const sub = document.getElementById(subId);
            if (!sub) return;
            const isOpen = sub.classList.contains('open');
            sub.classList.toggle('open', !isOpen);
            rowEl.classList.toggle('expanded', !isOpen);
        }
    </script>
        
}